---
// הזמנה שקטה להצטרפות לקבוצת הוואטסאפ של נקודת מבט.
//
// הפרדה מלאה בין הקבוצות: עמוד עברי מזמין לקבוצה העברית בלבד, עמוד ספרדי
// לקבוצה הספרדית בלבד. כל עוד אין קישור לקבוצה הספרדית (site-es.ts) —
// הכרטיס פשוט אינו מוצג בעמודים הספרדיים, כדי לא להזמין לדלת שאינה קיימת.
import { SITE } from '../data/site';
import { SITE_ES } from '../data/site-es';

interface Props {
  lang?: 'he' | 'es';
}
const { lang = 'he' } = Astro.props;
const es = lang === 'es';
const groupUrl = es ? SITE_ES.whatsappGroupUrl : SITE.whatsappGroupUrl;
const t = es
  ? {
      title: '¿Quieres más Punto de Vista?',
      text: 'Cada momento nuevo llega primero a nuestro grupo silencioso de WhatsApp.',
      btn: 'Unirme al grupo',
    }
  : {
      title: 'רוצים עוד נקודת מבט?',
      text: 'כל סיפור חדש מגיע קודם לקבוצת הוואטסאפ השקטה שלנו.',
      btn: 'להצטרפות לקבוצה',
    };
---

{
  groupUrl && (
    <aside class="join">
      <p class="join-title">{t.title}</p>
      <p class="join-text">{t.text}</p>
      <a class="join-btn" href={groupUrl} rel="noopener" target="_blank" data-ph="join_group">
        {t.btn}
      </a>
    </aside>
  )
}

<style>
  .join {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    padding: 1.5rem 1.25rem;
    margin-top: 2.5rem;
  }

  .join-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--teal-deep);
  }

  .join-text {
    color: var(--secondary);
    margin: 0.35rem 0 1rem;
  }

  /* פעולה משנית: מתאר במקום מילוי. הכפתור הראשי בדף הבית הוא "מצא רגע של
     נקודת מבט" — שני כפתורים מלאים באותו עמוד מבטלים זה את זה. */
  .join-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: transparent;
    color: var(--teal);
    border: 1.5px solid var(--teal);
    font-weight: 700;
    text-decoration: none;
    padding: 0.5rem 1.6rem;
    border-radius: 2rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .join-btn:hover {
    background: var(--teal);
    color: var(--paper);
  }
</style>
