---
// הזמנה שקטה להצטרפות לקבוצת הוואטסאפ של נקודת מבט.
import { SITE } from '../data/site';
---

<aside class="join">
  <p class="join-title">רוצים עוד נקודת מבט?</p>
  <p class="join-text">כל סיפור חדש מגיע קודם לקבוצת הוואטסאפ השקטה שלנו.</p>
  <a class="join-btn" href={SITE.whatsappGroupUrl} rel="noopener" target="_blank" data-ph="join_group">להצטרפות לקבוצה</a>
</aside>

<style>
  .join {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    padding: 1.5rem 1.25rem;
    margin-top: 2.5rem;
  }

  .join-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--teal-deep);
  }

  .join-text {
    color: var(--secondary);
    margin: 0.35rem 0 1rem;
  }

  /* פעולה משנית: מתאר במקום מילוי. הכפתור הראשי בדף הבית הוא "מצא רגע של
     נקודת מבט" — שני כפתורים מלאים באותו עמוד מבטלים זה את זה. */
  .join-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: transparent;
    color: var(--teal);
    border: 1.5px solid var(--teal);
    font-weight: 700;
    text-decoration: none;
    padding: 0.5rem 1.6rem;
    border-radius: 2rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .join-btn:hover {
    background: var(--teal);
    color: var(--paper);
  }
</style>
