---
// הזמנה שקטה להצטרפות לקבוצת הוואטסאפ של נקודת מבט.
import { SITE } from '../data/site';
---

<aside class="join">
  <p class="join-title">רוצים עוד נקודת מבט?</p>
  <p class="join-text">כל סיפור חדש מגיע קודם לקבוצת הוואטסאפ השקטה שלנו.</p>
  <a class="join-btn" href={SITE.whatsappGroupUrl} rel="noopener" target="_blank">להצטרפות לקבוצה</a>
</aside>

<style>
  .join {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    padding: 1.5rem 1.25rem;
    margin-top: 2.5rem;
  }

  .join-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--teal-deep);
  }

  .join-text {
    color: var(--secondary);
    margin: 0.35rem 0 1rem;
  }

  /* טקסט בצבע הדיו ולא לבן: לבן על זהב נותן יחס ניגודיות 2.40 ונכשל בתקן. */
  .join-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: var(--gold);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    padding: 0.55rem 1.7rem;
    border-radius: 2rem;
    transition: filter 0.15s ease;
  }

  .join-btn:hover {
    filter: brightness(0.92);
  }
</style>
