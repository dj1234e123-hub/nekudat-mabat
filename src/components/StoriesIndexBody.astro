---
// גוף עמוד הסיפורים, משותף לעברית ולספרדית (שלב 4, 2026-11-02): חיפוש, סיפור מרכזי, הכי נקראים, חדש,
// ארבעה עולמות, נושאים, והארכיון עם סינון. כל מה שנגזר מהתוכן נבחר בזמן הבנייה.
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { SECTIONS_META, SECTION_SLUGS } from '../data/sections';
import { SECTIONS_ES } from '../data/site-es';
import { SECTION_GATE_IMAGES } from '../data/section-gate-images';
import { THEMES, themesOf } from '../data/themes.mjs';
import { esSectionPath } from '../data/es-slugs';
import { HERO_PICK } from '../data/stories-hero';
import { STORY_UI, type Lang } from '../data/story-ui';
import { heroPool, viewsOf } from '../lib/story-meta';
import RotatingHero from './RotatingHero.astro';
import StorySearch from './StorySearch.astro';
import StoryHero from './StoryHero.astro';
import StoryTile from './StoryTile.astro';
import BigTile from './BigTile.astro';
import StoryBrowser from './StoryBrowser.astro';

type Story = CollectionEntry<'stories'> | CollectionEntry<'storiesEs'>;
interface Props {
  /** הסיפורים שפורסמו בשפת העמוד, מהחדש לישן */
  stories: Story[];
  lang?: Lang;
  /** תגיות לפי מזהה סיפור – בספרדית הן חיות בקובץ העברי */
  tagsById: Record<string, string[]>;
}
const { stories, lang = 'he', tagsById } = Astro.props;
const es = lang === 'es';
const ui = STORY_UI[lang];

// בחירה ידנית (HERO_PICK) מבטלת את ההגרלה; אחרת הסיפור המרכזי מוגרל מהנצפים ביותר (RotatingHero).
const picked = stories.find((s) => s.id === HERO_PICK);
const pool = heroPool(stories);
const manual = !!picked;
const top = [...stories].sort((a, b) => viewsOf(b.id) - viewsOf(a.id) || b.data.date.getTime() - a.data.date.getTime()).slice(0, 8);
const fresh = stories.slice(0, 8);

const entries = stories.map((story) => {
  const tags = tagsById[story.id] ?? [];
  return {
    story,
    themes: themesOf(tags).map((t: { slug: string }) => t.slug),
    searchExtra: es ? '' : tags.join(' '),
  };
});
const themeCount = (slug: string) => entries.filter((e) => e.themes.includes(slug)).length;

// עולם בלי תמונת שער, או בלי סיפורים בשפה הזאת, אינו מוצג כקובייה ("מבחר ולא מראה").
const worlds = SECTION_SLUGS.filter((slug) => SECTION_GATE_IMAGES[slug] && stories.some((s) => s.data.section === slug));

// תמונת קובייה לנושא: הסיפור הנקרא ביותר בנושא שטרם שימש תמונה לנושא אחר.
const used = new Set<string>();
const themeTiles = THEMES.map((t: { slug: string; label: string; labelEs: string }) => {
  const inTheme = entries
    .filter((e) => e.themes.includes(t.slug))
    .map((e) => e.story)
    .sort((a, b) => viewsOf(b.id) - viewsOf(a.id));
  const pick = inTheme.find((s) => !used.has(s.id)) ?? inTheme[0];
  if (pick) used.add(pick.id);
  return { slug: t.slug, label: es ? t.labelEs : t.label, cover: (pick?.data.cover ?? null) as ImageMetadata | null, count: inTheme.length };
}).filter((t) => t.cover && t.count > 0);

const labels = {
  worlds: Object.fromEntries(SECTION_SLUGS.map((s) => [s, es ? SECTIONS_ES[s].label : SECTIONS_META[s].label])),
  themes: Object.fromEntries(THEMES.map((t: { slug: string; label: string; labelEs: string }) => [t.slug, es ? t.labelEs : t.label])),
};
const worldHref = (slug: string) => (es ? esSectionPath(slug) : `/sections/${slug}/`);
---

<h1 class="page-title">{ui.pageTitle}</h1>
<p class="lead">{ui.intro(stories.length)}</p>
<StorySearch {lang} />
<!-- בזמן חיפוש כל מה שבין תיבת החיפוש לארכיון מוסתר (StoryBrowser), כדי שהתוצאות יופיעו מיד מתחת לתיבה ולא רחוק למטה -->
<div data-hide-on-search>
{
  picked || pool.length < 2 ? (
    <StoryHero story={picked ?? pool[0] ?? stories[0]} {lang} {manual} />
  ) : (
    <RotatingHero {pool} {lang} />
  )
}

<div class="sh"><h2>{ui.secNew}</h2><span>{ui.secNewNote}</span></div>
<ul class="rail">{fresh.map((s) => <StoryTile story={s} {lang} />)}</ul>

<div class="sh"><h2>{ui.secTop}</h2><span>{ui.secTopNote}</span></div>
<ul class="rail">{top.map((s, i) => <StoryTile story={s} {lang} rank={i + 1} />)}</ul>

<div class="sh"><h2>{ui.secWorlds}</h2></div>
<div class="grid">
  {
    worlds.map((slug) => (
      <BigTile
        image={SECTION_GATE_IMAGES[slug]!.image}
        position={SECTION_GATE_IMAGES[slug]!.position}
        label={labels.worlds[slug]}
        count={stories.filter((s) => s.data.section === slug).length}
        line={es ? SECTIONS_ES[slug].line : SECTIONS_META[slug].line}
        accent={SECTIONS_META[slug].accent}
        href={worldHref(slug)}
        filterWorld={slug}
        {lang}
      />
    ))
  }
</div>

<div class="sh"><h2>{ui.secThemes}</h2></div>
<div class="grid themes">
  {themeTiles.map((t) => <BigTile image={t.cover!} label={t.label} count={t.count} accent="var(--gold)" href="#archive" filterTheme={t.slug} {lang} />)}
</div>

</div>

<div class="sh"><h2>{ui.secAll}</h2></div>
<StoryBrowser {entries} {lang} {labels} />

<style>
  .page-title {
    text-align: center;
    font-size: 2rem;
    padding: 0.5rem 0 0.2rem;
  }
  .lead {
    text-align: center;
    color: var(--secondary);
    margin: 0 0 1.1rem;
  }
  .sh {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 2.4rem 0 0.8rem;
  }
  .sh h2 {
    font-size: 1.45rem;
    margin: 0;
  }
  .sh span {
    font-size: 0.84rem;
    color: var(--muted);
  }
  .rail {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    list-style: none;
    padding: 0 0 0.6rem;
    margin: 0;
    scroll-snap-type: x proximity;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  /* מספר אי-זוגי של קוביות: האחרונה נמתחת לרוחב מלא בטלפון ולא נשארת לבדה */
  .grid > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
    aspect-ratio: 2 / 1;
  }
  @media (min-width: 52rem) {
    .page-title {
      text-align: start;
      font-size: 2.6rem;
    }
    .lead {
      text-align: start;
      font-size: 1.05rem;
    }
    .sh h2 {
      font-size: 1.8rem;
    }
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.1rem;
    }
    .grid.themes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .grid.themes > :global(.bt) {
      aspect-ratio: 5 / 4;
    }
    .grid > :global(:last-child:nth-child(odd)) {
      grid-column: auto;
      aspect-ratio: auto;
    }
  }
</style>
