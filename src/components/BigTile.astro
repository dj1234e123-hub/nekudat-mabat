---
// קובייה גדולה לעולם או לנושא: תמונה, פס צבע עליון, שם וספירה (ובמסך רחב גם שורת הסבר).
// לחיצה מסננת את הארכיון (src/components/StoryBrowser.astro). בלי JavaScript – קישור רגיל.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { STORY_UI, type Lang } from '../data/story-ui';

interface Props {
  image: ImageMetadata;
  /** נקודת מיקוד לחיתוך (object-position) */
  position?: string;
  label: string;
  count: number;
  line?: string;
  accent: string;
  href: string;
  filterWorld?: string;
  filterTheme?: string;
  lang?: Lang;
}
const { image, position = '50% 50%', label, count, line, accent, href, filterWorld, filterTheme, lang = 'he' } = Astro.props;
---

<a
  class="bt"
  href={href}
  style={`--bc: ${accent}`}
  data-filter-world={filterWorld}
  data-filter-theme={filterTheme}
>
  <Image src={image} alt="" widths={[320, 640]} sizes="(max-width: 52rem) 50vw, 260px" style={`object-position: ${position}`} />
  <span class="bar"></span>
  <span class="in">
    <span class="n">{label}</span>
    <span class="c">{STORY_UI[lang].stories(count)}</span>
    {line && <span class="l">{line}</span>}
  </span>
</a>

<style>
  .bt {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: 0.9rem;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #222;
  }
  @media (min-width: 52rem) {
    .bt {
      aspect-ratio: 4 / 5;
    }
  }
  .bt :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .bt:hover :global(img) {
    transform: scale(1.03);
  }
  .bt::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.78), rgba(10, 10, 10, 0.12) 62%);
  }
  .bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 5px;
    background: var(--bc);
    z-index: 2;
  }
  .in {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.8rem 0.9rem;
    z-index: 1;
    display: block;
  }
  .n {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
    hyphens: auto;
    text-wrap: balance;
  }
  @media (min-width: 52rem) {
    .n {
      font-size: 1.55rem;
    }
  }
  .c {
    display: block;
    font-size: 0.8rem;
    opacity: 0.9;
    margin-top: 0.2rem;
  }
  .l {
    display: none;
    font-size: 0.8rem;
    opacity: 0.92;
    line-height: 1.45;
    margin-top: 0.25rem;
  }
  @media (min-width: 52rem) {
    .l {
      display: block;
    }
  }
  .bt:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .bt[aria-pressed='true'] {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
  }
</style>
