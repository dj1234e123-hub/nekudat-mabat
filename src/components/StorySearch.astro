---
// תיבת חיפוש לסיפורים. הסקריפט של StoryBrowser מחבר אליה כל input עם data-story-q.
// בלי JavaScript היא אינה עושה כלום, ולכן מוצגת רק כשיש JS (הסקריפט מסיר את hidden).
import { STORY_UI, type Lang } from '../data/story-ui';
interface Props {
  lang?: Lang;
}
const { lang = 'he' } = Astro.props;
---

<label class="srch" data-needs-js hidden>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="M20 20l-4-4"></path>
  </svg>
  <input type="search" data-story-q placeholder={STORY_UI[lang].searchLabel} aria-label={STORY_UI[lang].searchLabel} />
</label>

<script>
  document.querySelectorAll<HTMLElement>('[data-needs-js]').forEach((el) => (el.hidden = false));
</script>

<style>
  .srch {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--muted);
    border-radius: 999px;
    padding: 0 1rem;
    min-height: 48px;
    margin-bottom: 1.25rem;
  }
  .srch[hidden] {
    display: none;
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    min-height: 44px;
  }
  .srch:focus-within {
    border-color: var(--teal);
  }
  @media (min-width: 52rem) {
    .srch {
      max-width: 34rem;
    }
  }
</style>
