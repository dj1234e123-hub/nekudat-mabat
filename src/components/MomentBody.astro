---
// גוף של "רגע" — המהלכים, קישוט ההפרדה והסיום.
// האפיון: docs/MOMENT-FORMAT.md
//
// רכיב אחד לשלושת המקומות שמציגים רגע (עמוד הרגע, דף הבית, מדף המצב), כדי
// שהקצב ייראה זהה בכולם. הכותרת נשארת באחריות העמוד: שם היא h1, בדף הבית h3,
// ובמדף היא בתוך קישור — ואותו רכיב לא יכול לשרת את שלושתם נכון.
import { lineHtml, type MomentFormat } from '../lib/moment-format';

interface Props {
  format: MomentFormat;
  /** מציג את מהלך המציאות בלבד — למדף, שבו הסיום לא נשרף מראש */
  firstStanzaOnly?: boolean;
  /**
   * מציג את המהלך הראשון בגלוי, ומקפל את השאר (הסיבוב והסיום) מאחורי
   * "להמשיך לקרוא" — לדף הבית, שבו רגע מוגרל בשלמותו תופס יותר מדי גובה.
   * שונה מ-firstStanzaOnly: שם הסיום לא קיים בתצוגה בכלל; כאן הוא קיים,
   * רק מאחורי לחיצה.
   */
  collapsed?: boolean;
  /** הטקסט על כפתור הקיפול — בעמוד ספרדי הוא בספרדית. */
  moreLabel?: string;
}

const {
  format,
  firstStanzaOnly = false,
  collapsed = false,
  moreLabel = 'להמשיך לקרוא',
} = Astro.props;
const stanzas = firstStanzaOnly ? format.stanzas.slice(0, 1) : format.stanzas;
const showClosing = !firstStanzaOnly && Boolean(format.closing);
// הקיפול מתאים רק לפורמט החדש, ורק כשיש בכלל מה לקפל אחרי המהלך הראשון.
const isCollapsed = collapsed && format.isNew && !firstStanzaOnly && stanzas.length > 1;
const visibleStanzas = isCollapsed ? stanzas.slice(0, 1) : stanzas;
const restStanzas = isCollapsed ? stanzas.slice(1) : [];
---

<div class:list={['moment-body', format.isNew ? 'is-new' : 'is-flow']}>
  {
    visibleStanzas.map((stanza) => (
      <p class="stanza" set:html={stanza.map(lineHtml).join('<br />')} />
    ))
  }

  {
    isCollapsed ? (
      <details class="reveal">
        <summary>{moreLabel}</summary>
        {
          restStanzas.map((stanza) => (
            <p class="stanza" set:html={stanza.map(lineHtml).join('<br />')} />
          ))
        }
        {
          showClosing && (
            <>
              <div class="ornament" aria-hidden="true">
                <span class="rule" />
                <span class="diamond" />
                <span class="rule" />
              </div>
              <p class="closing" set:html={format.closing!.map(lineHtml).join('<br />')} />
            </>
          )
        }
      </details>
    ) : (
      showClosing && (
        <>
          {/* קישוט ההפרדה — פעם אחת בעמוד, אחרי הסיבוב ולפני הסיום.
              מצויר ולא תו טקסט: תת-הקבוצה העברית של הפונט אינה מכילה פיסוק,
              ותו מירכאות היה נופל לפונט מערכת ומשתנה ממכשיר למכשיר. */}
          <div class="ornament" aria-hidden="true">
            <span class="rule" />
            <span class="diamond" />
            <span class="rule" />
          </div>
          <p class="closing" set:html={format.closing!.map(lineHtml).join('<br />')} />
        </>
      )
    )
  }
</div>

<style>
  .moment-body {
    font-family: var(--font-display);
    font-size: var(--moment-size, 1.3rem);
    max-width: 30rem;
    margin-inline: auto;
  }

  /* התצוגה הישנה: פסקאות זורמות, מיושרות לימין. נשמרת בדיוק כפי שהייתה
     כדי שרגע שטרם הוגר לא ישתנה. */
  .is-flow .stanza {
    line-height: 2.05;
  }

  .is-flow .stanza + .stanza {
    margin-top: 1.5rem;
  }

  /* הפורמט החדש: שורות של 2-5 מילים, ולכן מרכוז. הכלל הישן ("יישור לימין —
     טקסט ממורכז על פני כמה שורות קשה לקריאה") נכתב לשורות ארוכות; בשורה של
     שלוש מילים המרכוז הוא מה שנכון, וזה גם מה שהמקור בקאנווה עושה. */
  .is-new {
    text-align: center;
  }

  .is-new .stanza {
    line-height: 1.75;
  }

  /* האוויר גדל בין מהלך למהלך — הקורא מרגיש שהוא מתקדם ולא שהוא קורא רשימה */
  .is-new .stanza + .stanza {
    margin-top: 1.65rem;
  }

  .is-new strong {
    font-weight: 700;
  }

  /* «להמשיך לקרוא» — פעולה משנית, מתאר במקום מילוי (כמו כפתור ההצטרפות
     לקבוצה). עובד גם בלי JavaScript: <details> הוא HTML רגיל. */
  .reveal {
    margin-top: 1.65rem;
  }

  .reveal > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.4rem 1.3rem;
    border-radius: 2rem;
    border: 1.5px solid var(--teal);
    color: var(--teal);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .reveal > summary::-webkit-details-marker {
    display: none;
  }

  .reveal > summary:hover {
    background: var(--teal);
    color: var(--paper);
  }

  .reveal[open] > summary {
    display: none;
  }

  .reveal[open] > .stanza:first-of-type {
    margin-top: 1.2rem;
  }

  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    /* הרווח הגדול ביותר בעמוד. זו הנשימה שלפני הסיום, והיא גם מה שמחזיק את
       הסיום מתחת לקו הקיפול בטלפון — נמדד ב-390x844 על רגע בן 12 שורות,
       שהוא הקצה הקצר של התקציב (12-14). ברגע ארוך יותר הקישוט כבר לא מציץ,
       אבל אז המהלך השלישי עצמו נחתך בקיפול, וזה סימן חזק לא פחות שיש עוד. */
    margin: 4.2rem 0 3.6rem;
  }

  .ornament .rule {
    display: block;
    width: 3.2rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.75;
  }

  .ornament .diamond {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    background: var(--gold);
    transform: rotate(45deg);
  }

  /* האובייקט היחיד בעמוד שנראה אחרת. האדום העמוק בטקסט שמור לו בלבד,
     בכל האתר — הכוח שלו בא מנדירות. */
  .closing {
    font-size: 1.55em;
    font-weight: 700;
    line-height: 1.55;
    color: var(--brick);
    text-align: center;
    text-wrap: balance;
  }

  .closing :global(strong) {
    font-weight: 700;
  }
</style>
