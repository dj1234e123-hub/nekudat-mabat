---
// דלתות המצבים של קבוצה אחת — שורות מדף: שם המצב, שורת הדלת, וסימן הקו.
// משמש גם בעמוד הכניסה (בתוך הקבוצות המתקפלות) וגם בעמוד השער.
//
// מצב בלי תוכן עדיין מוצג (הוא חלק מהמבנה) אבל אינו קישור — כדי שלא
// להוביל למדף ריק. צבעי הקבוצה מגיעים דרך המשתנים --accent ו---title
// שמוגדרים אצל ההורה.
import { FEELING_MARKS } from '../data/feeling-marks';
import type { FeelingGroup } from '../data/feelings';
import { FEELING_LABELS_ES, FEELING_LINES_ES } from '../data/site-es';

interface Props {
  group: FeelingGroup;
  filled: Set<string>;
  /** 'es' — תוויות ושורות בספרדית, וכתובות תחת /es/momentos/. המבנה, הסימנים
      והצבעים זהים לעברית — אותן דלתות, שפה אחרת. */
  lang?: 'he' | 'es';
  /** 'grid' — רשת של שני טורים (עמוד השער, 2026-09-16): כל דלתות הקבוצה
      נראות יחד בלי לגלול. 'rows' (ברירת המחדל) — שורות המדף של עמוד הכניסה. */
  layout?: 'rows' | 'grid';
}
const { group, filled, lang = 'he', layout = 'rows' } = Astro.props;
const es = lang === 'es';
const hrefBase = es ? '/es/momentos' : '/moments';
---

<ul class:list={["doors", { "doors-grid": layout === "grid" }]}>
  {
    group.feelings.map((feeling) => {
      const inner = (
        <>
          <span class="door-text">
            <span class="door-name">{es ? FEELING_LABELS_ES[feeling.slug] : feeling.label}</span>
            <span class="door-line">{es ? FEELING_LINES_ES[feeling.slug] : feeling.line}</span>
          </span>
          <svg
            class="door-mark"
            width="66"
            height="33"
            viewBox="0 0 56 28"
            aria-hidden="true"
            set:html={FEELING_MARKS[feeling.slug]}
          />
        </>
      );
      return (
        <li>
          {filled.has(feeling.slug) ? (
            <a class="door" href={`${hrefBase}/${feeling.slug}/`}>{inner}</a>
          ) : (
            <span class="door is-empty" aria-disabled="true">{inner}</span>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .doors {
    list-style: none;
    padding: 0 0 1rem;
    margin: 0;
  }

  .doors li + li {
    border-top: 1px solid var(--line);
  }

  /* דלת: שורה ברוחב מלא, כמו מדף בספרייה. לא קופסה ולא כרטיס פוסט. */
  .door {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 72px;
    padding: 1rem 0.4rem;
    text-decoration: none;
  }

  .door-text {
    display: flex;
    flex-direction: column;
  }

  /* צבע הקבוצה כברירת מחדל — לא רק ב-hover, שרוב הקוראים (בטלפון) לעולם
     לא רואים. אותו עיקרון בדיוק שכבר עובד בכרטיסי עולמות הסיפורים. */
  .door-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--title);
  }

  .door-line {
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-top: 0.15rem;
  }

  /* הסימן יושב בקצה השורה, שקט אך נוכח. בריחוף הוא מתחזק — הדלת עונה למגע.
     מוגדל מעט מגודל הציור (viewBox) כדי שלא ייעלם בגלילה מהירה בטלפון. */
  .door-mark {
    flex-shrink: 0;
    margin-inline-start: 0.35rem;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  a.door:hover .door-name {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  a.door:hover .door-mark {
    opacity: 1;
  }

  /* מצב שעדיין אין בו תוכן — נוכח במבנה, אך לא מוביל לשום מקום */
  .door.is-empty .door-name,
  .door.is-empty .door-line {
    color: var(--muted);
  }

  .door.is-empty .door-mark {
    opacity: 0.3;
  }

  /* ── רשת (עמוד השער) ──
     שמונה דלתות ב-4 שורות במקום 8, כדי שכולן ייראו יחד. אותו תוכן בדיוק:
     שם, שורת דלת וסימן — הסימן קטן יותר ויושב בפינת האריח. */
  .doors-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    padding-bottom: 0.5rem;
  }

  .doors-grid li + li {
    border-top: 0;
  }

  .doors-grid .door {
    position: relative;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 0;
    min-height: 44px;
    height: 100%;
    padding: 0.5rem 0.75rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--paper);
  }

  .doors-grid .door-name {
    font-size: 1.12rem;
    line-height: 1.25;
  }

  .doors-grid .door-line {
    font-size: 0.8rem;
    line-height: 1.4;
    margin-top: 0.1rem;
    /* מקום לסימן שיושב בפינה */
    padding-inline-end: 2.4rem;
  }

  .doors-grid .door-mark {
    position: absolute;
    inset-inline-end: 0.45rem;
    bottom: 0.4rem;
    width: 40px;
    height: 20px;
    margin: 0;
    opacity: 0.7;
  }

  a.doors-grid .door:hover,
  .doors-grid a.door:hover {
    border-color: var(--gold);
  }
</style>
