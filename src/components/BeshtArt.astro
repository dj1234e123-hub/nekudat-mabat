---
// תמונת פינת "מעשה שהיה" — צילום קבוע, משותף לכל סיפורי הפינה (בשונה
// משערי הרגעים, שם יש תמונה נפרדת לכל קבוצה). נר הבדלה דלוק, כוס קידוש
// ובשמים באור שקיעה על ירושלים — בלי דמויות, בלי כיתוב.
//
// אותו דפוס בדיוק כמו GateArt.astro: הקשת/המסגרת והחותם יושבים בעמוד
// עצמו ואינם משתנים. החלפת תמונה = קובץ חדש ב-src/assets/besht/havdalah.png.
import { Image } from 'astro:assets';
import havdalah from '../assets/besht/havdalah.png';
---

{/* הגודל/החיתוך נקבעים מהעמוד שמכיל (.art-frame / .besht-art :global(img)) —
    אותו דפוס בדיוק כמו GateArt.astro, כי כל עמוד עוטף אותה תמונה במסגרת אחרת. */}
<Image
  src={havdalah}
  alt=""
  widths={[480, 960]}
  sizes="(max-width: 30rem) 100vw, 416px"
  loading="eager"
/>
