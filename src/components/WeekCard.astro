---
// כרטיס גדול לפינה השבועית בדף הבית (מבט לשבת, מעשה שהיה): תמונת הזהות של הפינה, "חדש", שם הפינה
// והמועד, כותרת, פתיחה וכפתור בצבע הפינה. אותו כרטיס בשתי השפות. תוכן שאין לו (אין גיליון, אין סיפור) – לא מוצג.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kind: 'mabat' | 'besht';
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  kicker: string; // שם הפינה
  when: string; // פרשת וירא · מוצאי שבת וירא
  title: string;
  text: string;
  cta: string;
  isNew?: boolean;
  newLabel?: string;
  ph: string;
}
const { kind, href, image, imageAlt, kicker, when, title, text, cta, isNew = false, newLabel = '', ph } = Astro.props;
---

<a class:list={['wk', kind]} href={href} data-ph={ph}>
  <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 52rem) 100vw, 34rem" />
  <span class="tx">
    <span class="kk">
      {isNew && <span class="nw">{newLabel}</span>}
      <span class="c">{kicker}</span>
      <span>{when}</span>
    </span>
    <span class="tt">{title}</span>
    <span class="ds">{text}</span>
    <span class="go">{cta}</span>
  </span>
</a>

<style>
  .wk {
    --c: var(--blue);
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
  }
  .wk.besht {
    --c: var(--gold-deep);
  }
  .wk :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  /* מחשב: שני הכרטיסים זה לצד זה, והתמונה נמוכה יותר כדי שהטקסט והכפתור יופיעו
     בלי לגלול (ב-16:9 התמונה לבדה תפסה 290px מ-900) */
  @media (min-width: 52rem) {
    .wk :global(img) {
      aspect-ratio: 2 / 1;
    }
  }
  .tx {
    display: block;
    padding: 0.9rem 1rem 1.1rem;
  }
  .kk {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.7rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 600;
  }
  .kk .c {
    color: var(--c);
    font-weight: 700;
  }
  .nw {
    background: var(--gold);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    border-radius: 0.25rem;
    padding: 0 0.5rem;
  }
  .tt {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    margin: 0.4rem 0 0.25rem;
  }
  .ds {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--secondary);
  }
  .go {
    display: inline-flex;
    align-items: center;
    margin-top: 0.7rem;
    min-height: 44px;
    padding: 0 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--white);
    background: var(--c);
  }
  .wk:hover .tt,
  .wk:focus-visible .tt {
    color: var(--c);
  }
</style>
