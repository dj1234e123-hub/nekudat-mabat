---
// ציור השער של קבוצת מצבים — ממלא מקום עד שבעל הפרויקט יעלה תמונות משלו.
//
// כל ציור הוא מחווה מופשטת בצבעי הקבוצה, בלי דמויות (בהתאם להחלטת שערי
// הסיפורים): קנה נכפף באדום, השתקפות בכחול, מדרגות בערפל, אור זהב, סולם
// אל כוכבים. הציורים חיים כאן בלבד.
//
// החלפה בתמונה אמיתית: מניחים קובץ ב-src/assets/gates/<slug>.jpg ומחליפים
// כאן את ה-SVG של אותה קבוצה ב-<Image>. המסגרת, הקשת והשם יושבים בעמוד
// עצמו ואינם משתנים — תמונה מתחלפת, השער נשאר שער.
interface Props {
  group: 'hurting' | 'self' | 'stuck' | 'beginning' | 'upward';
}
const { group } = Astro.props;
---

{
  group === 'hurting' && (
    <svg viewBox="0 0 260 170" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gate-hurting" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#8E3931" />
          <stop offset="0.65" stop-color="#B0463B" />
          <stop offset="1" stop-color="#D9A08A" />
        </linearGradient>
      </defs>
      <rect width="260" height="170" fill="url(#gate-hurting)" />
      <line x1="0" y1="128" x2="260" y2="128" stroke="#F3E9D3" stroke-width="1" opacity="0.5" />
      <path d="M150 128 Q150 88 128 74 Q140 96 138 128" fill="#F3E9D3" opacity="0.55" />
      <circle cx="60" cy="50" r="2" fill="#F3E9D3" opacity="0.4" />
      <circle cx="205" cy="38" r="1.5" fill="#F3E9D3" opacity="0.3" />
    </svg>
  )
}

{
  group === 'self' && (
    <svg viewBox="0 0 260 170" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gate-self" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#00293F" />
          <stop offset="0.7" stop-color="#003B5C" />
          <stop offset="1" stop-color="#2E6285" />
        </linearGradient>
      </defs>
      <rect width="260" height="170" fill="url(#gate-self)" />
      <circle cx="130" cy="66" r="24" fill="none" stroke="#F3E9D3" stroke-width="1.4" opacity="0.85" />
      <circle cx="130" cy="138" r="24" fill="none" stroke="#F3E9D3" stroke-width="1" opacity="0.28" />
      <line x1="86" y1="102" x2="174" y2="102" stroke="#F3E9D3" stroke-width="1" opacity="0.5" />
    </svg>
  )
}

{
  group === 'stuck' && (
    <svg viewBox="0 0 260 170" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gate-stuck" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#DCE5DC" />
          <stop offset="0.55" stop-color="#5D8781" />
          <stop offset="1" stop-color="#1F5C57" />
        </linearGradient>
      </defs>
      <rect width="260" height="170" fill="url(#gate-stuck)" />
      <path
        d="M40 160 L100 160 L100 130 L150 130 L150 100 L196 100 L196 74 L236 74"
        fill="none"
        stroke="#F3E9D3"
        stroke-width="2"
        opacity="0.9"
      />
      <circle cx="244" cy="62" r="3" fill="#F3E9D3" opacity="0.8" />
    </svg>
  )
}

{
  group === 'beginning' && (
    <svg viewBox="0 0 260 170" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gate-beginning" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#F6E9C8" />
          <stop offset="0.6" stop-color="#E4C583" />
          <stop offset="1" stop-color="#C9A24D" />
        </linearGradient>
      </defs>
      <rect width="260" height="170" fill="url(#gate-beginning)" />
      <circle cx="130" cy="120" r="34" fill="#FBF3DC" opacity="0.9" />
      <line x1="130" y1="62" x2="130" y2="46" stroke="#FBF3DC" stroke-width="2" opacity="0.8" />
      <line x1="86" y1="82" x2="74" y2="70" stroke="#FBF3DC" stroke-width="2" opacity="0.6" />
      <line x1="174" y1="82" x2="186" y2="70" stroke="#FBF3DC" stroke-width="2" opacity="0.6" />
      <line x1="0" y1="152" x2="260" y2="152" stroke="#A8823A" stroke-width="1.5" opacity="0.6" />
    </svg>
  )
}

{
  group === 'upward' && (
    <svg viewBox="0 0 260 170" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gate-upward" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#0C2A30" />
          <stop offset="0.7" stop-color="#17444C" />
          <stop offset="1" stop-color="#2E6A74" />
        </linearGradient>
      </defs>
      <rect width="260" height="170" fill="url(#gate-upward)" />
      <line x1="112" y1="170" x2="128" y2="30" stroke="#E3C98A" stroke-width="1.6" opacity="0.85" />
      <line x1="148" y1="170" x2="164" y2="30" stroke="#E3C98A" stroke-width="1.6" opacity="0.85" />
      <line x1="116" y1="140" x2="151" y2="140" stroke="#E3C98A" stroke-width="1.4" opacity="0.8" />
      <line x1="120" y1="108" x2="155" y2="108" stroke="#E3C98A" stroke-width="1.4" opacity="0.8" />
      <line x1="123" y1="76" x2="158" y2="76" stroke="#E3C98A" stroke-width="1.4" opacity="0.8" />
      <circle cx="60" cy="42" r="1.6" fill="#E3C98A" opacity="0.8" />
      <circle cx="212" cy="56" r="1.3" fill="#E3C98A" opacity="0.6" />
      <circle cx="188" cy="26" r="1.8" fill="#E3C98A" opacity="0.9" />
      <circle cx="84" cy="80" r="1.1" fill="#E3C98A" opacity="0.5" />
    </svg>
  )
}
