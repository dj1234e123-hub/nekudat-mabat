---
// תמונת השער של קבוצת מצבים — חמישה צילומים של בעל הפרויקט (2026-08-25).
//
// דפוס הסדרה: אור אחד קטן בתוך שדה גדול ושקט, שהולך ומתקרב משער לשער —
// חלון דולק בשקיעה → השתקפותו במים → פנס בקצה שביל בערפל → אור שנכנס
// בדלת פתוחה → כוכב בשמי הלילה. בלי דמויות.
//
// החלפת תמונה: קובץ חדש ב-src/assets/gates/<slug>.jpg — הקשת, מסגרת הזהב
// והשם יושבים בעמוד עצמו ואינם משתנים. תמונה מתחלפת, השער נשאר שער.
import { Image } from 'astro:assets';
import hurtingImg from '../assets/gates/hurting.jpg';
import selfImg from '../assets/gates/self.jpg';
import stuckImg from '../assets/gates/stuck.jpg';
import beginningImg from '../assets/gates/beginning.jpg';
import upwardImg from '../assets/gates/upward.jpg';

interface Props {
  group: 'hurting' | 'self' | 'stuck' | 'beginning' | 'upward';
}
const { group } = Astro.props;

const IMAGES = {
  hurting: hurtingImg,
  self: selfImg,
  stuck: stuckImg,
  beginning: beginningImg,
  upward: upwardImg,
} as const;
---

<Image
  src={IMAGES[group]}
  alt=""
  widths={[480, 960]}
  sizes="(max-width: 30rem) 100vw, 416px"
  loading="eager"
/>
