---
// תגובה פרטית לסוף סיפור — במקום תגובות ציבוריות (החלטה 2026-08-23).
// קופסת תגובות מבקשת מהקורא להיחשף בשמו בקהילה שכולם מכירים בה, ודווקא מי
// שהתוכן נכתב בשבילו לא יכתוב שם. הודעה פרטית לאפרים היא אותה מחווה בלי המחיר,
// והיא גם התחלה של שיחה אמיתית ולא מספר בעמוד.
//
// הפנייה בלשון יחיד ("נגע בך") ולא ברבים כמו שורת השיתוף שמעליה: זו מחווה של
// אדם אחד אל אדם אחד. בכתיב לא מנוקד "בך" זהה לשני המינים.
//
// הנוסח ("להמשיך שיחה" ולא "להתחיל" אחת) נבחר כי הוא מחסום נמוך בהרבה: הקורא
// כבר בילה כמה דקות עם אפרים, והמשפט רק מציע לא לעצור. זו גם ההזמנה השיווקית
// היחידה בעמוד, והיא בעדינות — בלי "לתיאום שיחה" ובלי הבטחה.
import { SITE } from '../data/site';

interface Props {
  /** שם הסיפור — נכנס לתוך ההודעה כדי שאפרים ידע על מה מדובר */
  title: string;
}

const { title } = Astro.props;

// טקסט פתיחה מוכן, ואחריו שורה ריקה שבה הקורא כותב את שלו.
const message = `שלום אפרים, קראתי את "${title}" באתר.\n`;
const href = `https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(message)}`;
---

<p class="write-to-me">
  <span class="lead">סיפור הוא התחלה של שיחה.</span>
  <span>אם משהו כאן נגע בך — <a href={href} rel="noopener" target="_blank" data-ph="write_private">אפשר להמשיך אותה איתי</a></span>
</p>

<style>
  .write-to-me {
    text-align: center;
    color: var(--secondary);
    font-size: 0.95rem;
    margin-top: 1.8rem;
    line-height: 1.75;
  }

  /* שתי שורות ולא אחת: המשפט הפותח צריך רגע משלו לפני ההזמנה. */
  .write-to-me span {
    display: block;
  }

  .lead {
    color: var(--muted);
  }

  /* קישור שקט ולא כפתור: שורת השיתוף שמעליה וכרטיס הקבוצה שמתחתיה כבר
     מבקשים פעולה, ופעולה שלישית באותו משקל הייתה מבטלת את שתיהן. */
  .write-to-me a {
    color: var(--teal);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    /* שטח מגע נוח בלי לשבור את השורה */
    display: inline-block;
    padding-block: 0.6rem;
  }

  .write-to-me a:hover {
    color: var(--teal-deep);
  }
</style>
