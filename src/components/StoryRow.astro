---
// שורת סיפור בארכיון: תמונה בצד, עולם · זמן קריאה (+ "חדש"), כותרת, hook, צפיות · תאריך יחסי.
// נושאת את כל מה שהסינון הלקוחי צריך כתכונות data-*, כך שאין צורך בשום בקשה נוספת.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SECTIONS_META } from '../data/sections';
import { SECTIONS_ES } from '../data/site-es';
import { DEFAULT_COVERS } from '../data/default-covers';
import { esStoryPath } from '../data/es-slugs';
import { STORY_UI, type Lang } from '../data/story-ui';
import { hookOf, isNew, minutesOf, relativeDate, viewsOf } from '../lib/story-meta';
import { readingLabel } from '../lib/reading-time';
import Views from './Views.astro';

interface Props {
  story: CollectionEntry<'stories'> | CollectionEntry<'storiesEs'>;
  lang?: Lang;
  /** סלאגים של הנושאים שהסיפור משויך אליהם (src/data/themes.mjs) */
  themes?: string[];
  /** טקסט נוסף לחיפוש (תגיות), כי בספרדית התגיות חיות בקובץ העברי */
  searchExtra?: string;
  hidden?: boolean;
}
const { story, lang = 'he', themes = [], searchExtra = '', hidden = false } = Astro.props;
const es = lang === 'es';
const { title, section, date, excerpt } = story.data;
const cover = story.data.cover ?? DEFAULT_COVERS[section];
const href = es ? esStoryPath(story.id) : `/stories/${story.id}/`;
const worldLabel = es ? SECTIONS_ES[section].label : SECTIONS_META[section].label;
const hook = hookOf(story);
const views = viewsOf(story.id);
const mins = minutesOf(story);
const search = `${title} ${story.data.hook ?? ''} ${excerpt} ${searchExtra}`;
---

<li
  class="row"
  data-row
  data-id={story.id}
  data-world={section}
  data-themes={themes.join(' ')}
  data-date={date.toISOString()}
  data-views={views}
  data-mins={mins}
  data-search={search}
  hidden={hidden}
>
  <a href={href} data-story-id={story.id}>
    <Image src={cover} alt="" widths={[192, 384]} sizes="6rem" class="th" />
    <span class="tx">
      <span class="lab">
        <span class="w" style={`--accent: ${SECTIONS_META[section].accent}`}>{worldLabel}</span>
        <span>{readingLabel(story, lang).replace(' קריאה', '').replace(' de lectura', '')}</span>
        {isNew(date) && <span class="nw">{STORY_UI[lang].isNew}</span>}
      </span>
      <span class="ti">{title}</span>
      <span class:list={['hk', { q: hook.isHook }]}>{hook.text}</span>
      <span class="mt">
        <Views count={views} {lang} />
        <span>{relativeDate(date, lang)}</span>
        <span class="rd" data-read-badge hidden>{STORY_UI[lang].read}</span>
      </span>
    </span>
  </a>
</li>

<style>
  .row {
    list-style: none;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }
  .row[hidden] {
    display: none;
  }
  a {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.9rem;
    padding: 0.9rem 0;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  @media (min-width: 52rem) {
    a {
      grid-template-columns: 8rem 1fr;
      gap: 1.1rem;
    }
  }
  .row :global(.th) {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    border-radius: 0.75rem;
    background: var(--line);
  }
  @media (min-width: 52rem) {
    .row :global(.th) {
      width: 8rem;
      height: 6.4rem;
    }
  }
  .tx {
    display: block;
    min-width: 0;
  }
  .lab {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.6rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .w::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    margin-inline-end: 0.3rem;
  }
  .ti {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.28;
    margin: 0.2rem 0;
  }
  a:hover .ti,
  a:focus-visible .ti {
    color: var(--teal);
  }
  .hk {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--secondary);
  }
  .hk.q {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--blue);
  }
  .mt {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin-top: 0.3rem;
    font-size: 0.74rem;
    color: var(--muted);
  }
  .nw {
    background: var(--gold);
    color: var(--ink);
    font-size: 0.68rem;
    font-weight: 700;
    border-radius: 0.25rem;
    padding: 0 0.45rem;
  }
  .rd {
    color: var(--teal);
    font-weight: 600;
  }
</style>
