---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SECTIONS_META } from '../data/sections';
import { SECTIONS_ES } from '../data/site-es';
import { DEFAULT_COVERS, DEFAULT_COVER_ALT, DEFAULT_COVER_ALT_ES } from '../data/default-covers';
import { formatDate } from '../utils/format-date';

interface Props {
  story: CollectionEntry<'stories'> | CollectionEntry<'storiesEs'>;
  /** 'es' — תוויות, תאריך וכתובות של האזור הספרדי. הצבעים והמבנה זהים. */
  lang?: 'he' | 'es';
}

const { story, lang = 'he' } = Astro.props;
const es = lang === 'es';
const { title, section, date, excerpt } = story.data;
const cover = story.data.cover ?? DEFAULT_COVERS[section];
const coverAlt = story.data.coverAlt ?? (es ? DEFAULT_COVER_ALT_ES : DEFAULT_COVER_ALT);
const storyHref = es ? `/es/historias/${story.id}/` : `/stories/${story.id}/`;
const sectionHref = es ? `/es/secciones/${section}/` : `/sections/${section}/`;
const sectionLabel = es ? SECTIONS_ES[section].label : SECTIONS_META[section].label;
---

<li class="card">
  <a href={storyHref} class="card-link">
    <Image src={cover} alt={coverAlt} widths={[480, 800]} sizes="(max-width: 42rem) 100vw, 42rem" class="card-cover" />
    <h2>{title}</h2>
  </a>
  <p class="card-meta">
    <a class="label world" href={sectionHref} style={`--accent: ${SECTIONS_META[section].accent}`}>
      {sectionLabel}
    </a>
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time>
  </p>
  <p class="card-excerpt">{excerpt}</p>
</li>

<style>
  /* התווית נושאת את צבע העולם שלה — אותו צבע שבדלת בעמוד הסיפורים.
     כך הקורא לומד את המפה בלי שאיש מסביר לו. נקודה בלבד, לא מילוי:
     צבעי המותג הם נגיעות עדינות ולא אתר צבעוני. */
  .world::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    margin-inline-end: 0.4rem;
    vertical-align: 0.05em;
  }

  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-cover {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 0.9rem;
  }

  .card h2 {
    font-size: 1.5rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .card-link:hover h2 {
    color: var(--teal);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.4rem 0 0.2rem;
  }

  .card-meta time {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .card-excerpt {
    color: var(--secondary);
    line-height: 1.75;
  }
</style>
