---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SECTIONS } from '../data/sections';
import { DEFAULT_COVERS, DEFAULT_COVER_ALT } from '../data/default-covers';
import { formatDate } from '../utils/format-date';

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { title, section, date, excerpt } = story.data;
const cover = story.data.cover ?? DEFAULT_COVERS[section];
const coverAlt = story.data.coverAlt ?? DEFAULT_COVER_ALT;
---

<li class="card">
  <a href={`/stories/${story.id}/`} class="card-link">
    <Image src={cover} alt={coverAlt} widths={[480, 800]} sizes="(max-width: 42rem) 100vw, 42rem" class="card-cover" />
    <h2>{title}</h2>
  </a>
  <p class="card-meta">
    <a class="topic-tag" href={`/sections/${section}/`}>{SECTIONS[section]}</a>
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  </p>
  <p class="card-excerpt">{excerpt}</p>
</li>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
  }

  .card-cover {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 0.9rem;
  }

  .card h2 {
    font-size: 1.5rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }

  .card-link:hover h2 {
    color: var(--teal);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.4rem 0 0.2rem;
  }

  .card-meta time {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .card-excerpt {
    color: var(--muted);
    line-height: 1.75;
  }
</style>
