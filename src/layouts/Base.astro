---
// שלד עמוד משותף + שפת העיצוב של האתר.
// פונטים (החלטה סופית): Frank Ruhl Libre לכותרות, Heebo לטקסט השוטף ולממשק.
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** כתובת מוחלטת לתמונת התצוגה המקדימה בשיתוף; ברירת מחדל — הלוגו */
  ogImage?: string;
  ogType?: 'website' | 'article';
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, ogImage, ogType = 'website', bodyClass, noindex = false } = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultOg = await getImage({ src: logo, width: 640, format: 'jpeg' });
const ogImageUrl = ogImage ?? new URL(defaultOg.src, Astro.site).href;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Heebo:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <header>
      <a href="/" class="brand">
        <Image src={logo} alt="הלוגו של נקודת מבט" width={144} densities={[1, 2]} class="logo" />
        <span class="site-name">נקודת מבט</span>
      </a>
      <p class="tagline">{SITE.slogan}</p>
      <nav class="site-nav" aria-label="ניווט ראשי">
        <a href="/">הסיפורים</a>
        <a href="/about/">אודות</a>
        <a href={SITE.whatsappGroupUrl} rel="noopener">קבוצת הוואטסאפ</a>
      </nav>
    </header>
    <slot />
    <footer>
      <span class="dot" aria-hidden="true"></span>
      <p><a href="/">{SITE.name}</a> · {SITE.slogan}</p>
      <p class="credit">מאת {SITE.ownerName} · <a href="/about/">אודות</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* צבעים — בסיס נייר חם, צבעי המותג כנגיעות */
    --paper: #fbf7ee;
    --surface: #f3e9d3;
    --line: #e7dcc4;
    --ink: #2e2a24;
    --muted: #75695a;
    --teal: #1f5c57;
    --teal-deep: #17453f;
    --blue: #003b5c;
    --brick: #b0463b;
    --gold: #c9a24d;

    /* טיפוגרפיה — החלטה סופית: Frank Ruhl Libre לכותרות, Heebo לטקסט ולממשק */
    --font-display: 'Frank Ruhl Libre', 'David Libre', serif;
    --font-body: 'Heebo', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;

    --radius: 0.9rem;
    --shadow: 0 1px 3px rgba(46, 42, 36, 0.08);
  }

  * {
    margin: 0;
    box-sizing: border-box;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  a {
    color: var(--teal);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* כותרת האתר */
  header {
    text-align: center;
    padding: 2.25rem 1.5rem 0.75rem;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .logo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .site-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--teal-deep);
    letter-spacing: 0.01em;
  }

  .tagline {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.3rem;
  }

  .site-nav {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 0.9rem;
    font-size: 0.95rem;
  }

  .site-nav a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
  }

  .site-nav a:hover {
    color: var(--teal-deep);
  }

  main {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 3rem;
    flex: 1;
  }

  /* תחתית */
  footer {
    text-align: center;
    padding: 2rem 1.5rem 2.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  footer .dot {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 0 auto 1rem;
  }

  footer a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
  }

  footer .credit {
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  /* תגית נושא */
  .topic-tag {
    display: inline-block;
    background: var(--surface);
    color: var(--teal-deep);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.2rem 0.8rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
    transition: background 0.15s ease;
  }

  .topic-tag:hover {
    background: var(--gold);
    color: #fff;
    border-color: var(--gold);
  }
</style>
