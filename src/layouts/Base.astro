---
// שלד עמוד משותף + שפת העיצוב של האתר.
// פונטים (החלטה סופית): Frank Ruhl Libre לכותרות, Heebo לטקסט השוטף ולממשק.
// הקבצים מוגשים מתוך האתר (public/fonts) ולא משרת חיצוני – מהירות, עמידות,
// ותנאי מקדים ליצירת תמונות שיתוף בזמן בנייה (שלב 4.7).
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { SITE } from '../data/site';
import { SITE_ES } from '../data/site-es';
// מדידה: כמה נכנסו לכל עמוד ומאיפה הגיעו. בלי עוגיות ובלי מעקב אחרי אדם –
// הבסיס להחלטות תוכן ("איזה סיפור באמת נקרא"), במקום מונה לייקים גלוי.
import Analytics from '@vercel/analytics/astro';
import MenuDrawer from '../components/MenuDrawer.astro';

interface Props {
  title: string;
  description: string;
  /** כתובת מוחלטת לתמונת התצוגה המקדימה בשיתוף; ברירת מחדל – הלוגו */
  ogImage?: string;
  /** מידות תמונת השיתוף בפיקסלים. כמה קוראי תגיות (בהם וואטסאפ) לא
      מציגים תמונה בלי og:image:width/height מפורשים – בלעדיהם התצוגה
      המקדימה חוזרת לקישור בלבד, גם כשה-og:image תקין לגמרי. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  /** כותרת מצומצמת (עמודי סיפור): שורת מותג אחת, בלי סלוגן ותפריט – הקורא מגיע מהר לסיפור */
  compact?: boolean;
  /** תפריט נפתח (☰) בכותרת המצומצמת – כרגע בעמודי סיפור בלבד. */
  /** כותרת דף הבית: ריווח עליון מעט גדול יותר. גודל הלוגו והשם זהה מאז
      2026-09-16 לכל העמודים (קודם דף הבית היה הקטן מבין השניים).
      הסלוגן מופיע גם כאן, באותו מקום ובאותו עיצוב כמו בשאר העמודים –
      זהות אחידה של האתר (החלטת בעל הפרויקט, 2026-08-24). */
  homeHeader?: boolean;
  bodyClass?: string;
  noindex?: boolean;
  /** נתונים מובנים (JSON-LD) – כך גוגל מבין שהעמוד הוא מאמר של אפרים עטייה
      ולא סתם דף. מתקבל כאובייקט מוכן מהעמוד עצמו, או כמה אובייקטים (למשל
      Article + BreadcrumbList) – כל אחד יוצא כתגית <script> נפרדת. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** שפת העמוד. 'es' מחליף כיוון, תפריט ותחתית – האתר העברי אינו מושפע. */
  lang?: 'he' | 'es';
  /** העמוד התאום בשפה השנייה (המבנה שאושר על סקיצה 2026-08-26): גלולת שפה
      בכותרת שמובילה אליו, וזוג תגיות hreflang שמסבירות לגוגל שאלו אותו
      עמוד בשתי שפות. עמוד בלי תאום פשוט לא מעביר את הפרופ. */
  altLangHref?: string;
  /** false – הקישור הוא לשער השפה ולא לתאום אמיתי: גלולה כן, hreflang לא. */
  altLangTwin?: boolean;
  /** true – העמוד מציג את מעבר השפה בגוף העמוד (שורת ההזמנה בדפי הבית),
      ו-Base מוסיף hreflang בלבד, בלי גלולה. */
  altLangInline?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  compact = false,
  homeHeader = false,
  bodyClass,
  noindex = false,
  jsonLd,
  lang = 'he',
  altLangHref,
  altLangTwin = true,
  altLangInline = false,
} = Astro.props;

const es = lang === 'es';
const dir = es ? 'ltr' : 'rtl';
const brand = es ? SITE_ES : SITE;
// התפריט הספרדי – אותם יעדים כמו העברי, מאז שהסיפורים ומבט לשבת תורגמו
// (שלב 4.33): סיפורים, רגעים, שבת, מי אני.
const navLinks = es
  ? [
      { href: '/es/historias/', label: 'Historias' },
      { href: '/es/momentos/', label: 'Momentos' },
      { href: '/es/shabat/', label: 'Shabat' },
      { href: '/es/sobre-mi/', label: 'Sobre mí' },
    ]
  : [
      { href: '/stories/', label: 'סיפורים' },
      { href: '/moments/', label: 'מה עובר עליך' },
      { href: '/mabat-leshabbat/', label: 'מבט לשבת' },
      { href: '/besht/', label: 'מעשה שהיה' },
      { href: '/about/', label: 'מי אני' },
    ];
const aboutHref = es ? '/es/sobre-mi/' : '/about/';
const homeHref = es ? '/es/' : '/';
const byLine = es ? 'Por' : 'מאת';
const rights = es ? 'Todos los derechos reservados' : 'כל הזכויות שמורות';
const logoAlt = es ? `${SITE_ES.name} – logo` : 'הלוגו של נקודת מבט';
// טעינה מוקדמת של תת-הקבוצה שהעמוד באמת מציג: עמוד ספרדי שטוען מראש
// את הקבצים העבריים משלם על שני קבצים שלא ישמשו אותו, ומחכה לשניים שכן.
const preloadFonts = es
  ? ['/fonts/frank-ruhl-libre-latin.woff2', '/fonts/heebo-latin.woff2']
  : ['/fonts/frank-ruhl-libre-hebrew.woff2', '/fonts/heebo-hebrew.woff2'];

// גלולת השפה: בעברית היא אומרת "Español" ומובילה לספרדית, ולהפך.
// lang/dir על הקישור עצמו – מילה עברית בתוך עמוד LTR (ולהפך) מוצגת נכון.
const altLang = altLangHref
  ? {
      href: altLangHref,
      label: es ? 'עברית' : 'Español',
      lang: es ? 'he' : 'es',
      dir: es ? 'rtl' : 'ltr',
      aria: es ? 'Este texto en hebreo' : 'העמוד הזה בספרדית',
    }
  : null;
const showLangPill = altLang !== null && !altLangInline;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultOg = await getImage({ src: logo, width: 640, format: 'jpeg' });
const ogImageUrl = ogImage ?? new URL(defaultOg.src, Astro.site).href;
const ogImageDims = ogImage
  ? { width: ogImageWidth, height: ogImageHeight }
  : { width: defaultOg.attributes.width, height: defaultOg.attributes.height };
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* מצב לילה: נקבע לפני הציור הראשון, כדי שלא יהבהב עמוד בהיר בטעינה. */}
    <script is:inline>
      try {
        var t = localStorage.getItem('nm_theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={es ? "es_LA" : "he_IL"} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    {ogImageDims.width && <meta property="og:image:width" content={String(ogImageDims.width)} />}
    {ogImageDims.height && <meta property="og:image:height" content={String(ogImageDims.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    {
      altLang && altLangTwin && (
        <>
          <link rel="alternate" hreflang={es ? 'es' : 'he'} href={pageUrl} />
          <link
            rel="alternate"
            hreflang={es ? 'he' : 'es'}
            href={new URL(altLang.href, Astro.site).href}
          />
        </>
      )
    }
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {
      preloadFonts.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <title>{title}</title>
    {
      jsonLd &&
        (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((item) => (
          <script type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
    }
  </head>
  <body class={bodyClass}>
    {
      compact ? (
        <header class="header-compact">
          <a href={homeHref} class="brand-row">
            <Image src={logo} alt={logoAlt} width={80} densities={[1, 2]} class="logo-sm" />
            <span class="brand-text">
              <span class="site-name-sm">{brand.name}</span>
              <span class="tagline">{brand.slogan}</span>
            </span>
          </a>
          {showLangPill && (
            <a
              class="lang-pill lang-pill-corner"
              href={altLang.href}
              lang={altLang.lang}
              dir={altLang.dir}
              aria-label={altLang.aria}
            >
              {altLang.label}
            </a>
          )}
          <MenuDrawer es={es} homeHref={homeHref} brandName={brand.name} links={navLinks} current={Astro.url.pathname} />
        </header>
      ) : (
        <header class={homeHeader ? 'header-home' : undefined}>
          <a href={homeHref} class="brand">
            <Image src={logo} alt={logoAlt} width={128} densities={[1, 2]} class="logo" />
            <span class="brand-text">
              <span class="site-name">{brand.name}</span>
              <span class="tagline">{brand.slogan}</span>
            </span>
          </a>
          {/* שמות התפריט הם בשפת הקורא ולא בשפה הפנימית שלנו: "מה עובר עליך"
              הוא בדיוק נוסח הכפתור הראשי בדף הבית – אותה דלת, אותן מילים.
              קבוצת הוואטסאפ ירדה מכאן: היא הקישור היחיד שיוצא מהאתר, והיא כבר
              מופיעה ככרטיס בתחתית כל עמוד. תפריט הוא לְמקומות בתוך הבית. */}
          <nav class="site-nav" aria-label={es ? 'Navegación principal' : 'ניווט ראשי'}>
            {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            <button
              class="theme-icon"
              type="button"
              data-theme-toggle
              aria-pressed="false"
              aria-label={es ? 'Modo noche' : 'מצב לילה'}
              data-ph="theme_toggle"
            >
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            </button>
            {showLangPill && (
              <a
                class="lang-pill"
                href={altLang.href}
                lang={altLang.lang}
                dir={altLang.dir}
                aria-label={altLang.aria}
              >
                {altLang.label}
              </a>
            )}
          </nav>
          {showLangPill && (
            <a
              class="lang-pill lang-pill-corner lang-pill-phone"
              href={altLang.href}
              lang={altLang.lang}
              dir={altLang.dir}
              aria-label={altLang.aria}
            >
              {altLang.label}
            </a>
          )}
          <MenuDrawer es={es} homeHref={homeHref} brandName={brand.name} links={navLinks} current={Astro.url.pathname} />
        </header>
      )
    }
    <slot />
    <script>
      import posthog from 'posthog-js';

      // מצב "בעלים": ביקור בכתובת עם ‎?owner=1 שומר דגל בדפדפן הזה (localStorage
      // בלבד, בלי עוגיות) – ומאותו רגע אף ביקור מהדפדפן הזה לא נספר, לא ב-PostHog
      // ולא ב-Vercel Analytics. ‎?owner=0 מבטל את הדגל. חד-פעמי לכל דפדפן/מכשיר.
      const ownerParam = new URLSearchParams(location.search).get('owner');
      if (ownerParam === '1') localStorage.setItem('nm_owner', '1');
      else if (ownerParam === '0') localStorage.removeItem('nm_owner');
      const isOwner = localStorage.getItem('nm_owner') === '1';

      // Vercel Analytics קורא למשתנה הגלובלי הזה (מנגנון מתועד של הרכיב ל-Astro)
      // ומבטל כל אירוע לפני שליחה כשמצב הבעלים דלוק.
      window.webAnalyticsBeforeSend = (event) => (isOwner ? null : event);

      // מדידת התנהגות (PostHog, שלב 4.28) – משלימה את Vercel Analytics:
      // מסלולים, נקודות עזיבה ולחיצות, לא רק ספירת צפיות.
      // הנתונים עוברים דרך האתר עצמו (/ingest ב-vercel.json) – בלי סקריפט
      // מדומיין זר, בלי פתיחת ה-CSP, ועמיד בפני חוסמים וסינון.
      // רץ רק בדומיין הציבורי: תצוגות מקדימות והגלישות של בעל הפרויקט
      // בכתובת ה-vercel.app לא מזהמות את המדידה. מצב הבעלים חוסם גם כאן.
      if (!isOwner && ['nekudatmabat.blog', 'www.nekudatmabat.blog'].includes(location.hostname)) {
        // תיוג קישור (?s=wa-he): הודעה בקבוצה מוסיפה אותו לכתובת, וכך אפשר להפריד
        // בין "ישיר" שהגיע מהקבוצה לבין העברה. נשמר ל-sessionStorage כדי שיישאר
        // על כל אירוע בביקור, גם אחרי מעבר עמוד. שפה נגזרת מהכתובת.
        let linkTag = new URLSearchParams(location.search).get('s');
        try {
          if (linkTag) sessionStorage.setItem('nm_s', linkTag.slice(0, 40));
          else linkTag = sessionStorage.getItem('nm_s');
        } catch {}
        const siteLang = location.pathname === '/es' || location.pathname.startsWith('/es/') ? 'es' : 'he';

        posthog.init('phc_Ao9zMFiwEvJyA7G3LchesR4N7mmJdfggEkrMZF86Z3Lb', {
          api_host: '/ingest',
          ui_host: 'https://us.posthog.com',
          defaults: '2025-05-24',
          // localStorage ולא עוגיות – הזיהוי חדש/חוזר נשאר בדפדפן של הקורא בלבד.
          persistence: 'localStorage',
          disable_session_recording: true,
          // before_send ולא register: רק כך גם ה-$pageview הראשון נושא את התיוג.
          before_send: (e) => {
            if (e) {
              e.properties = { ...e.properties, site_lang: siteLang, ...(linkTag ? { link_tag: linkTag.slice(0, 40) } : {}) };
            }
            return e;
          },
        });

        // אירועים מותאמים: רכיב מסמן data-ph="שם" וההאזנה חיה כאן פעם אחת.
        // sendBeacon – כדי שגם לחיצה שמנווטת מיד (סיפור אקראי, טלפון) תיקלט.
        document.addEventListener('click', (event) => {
          const el = (event.target as Element).closest?.('[data-ph]');
          if (el instanceof HTMLElement && el.dataset.ph) {
            posthog.capture(el.dataset.ph, undefined, { transport: 'sendBeacon' });
          }
        });

        // אירוע שאינו לחיצה (הצגת חלון ההזמנה) – רכיב קורא ל-nmTrack.
        window.nmTrack = (name: string, props?: Record<string, unknown>) =>
          posthog.capture(name, props, { transport: 'sendBeacon' });

        // מדידת קריאה אמיתית (שלב 4.84). $pageleave לא מגיע מהדפדפן הפנימי של
        // וואטסאפ ופייסבוק (נמדד: 33–67% מהצפיות), ולכן שני אירועים נשלחים ברגע
        // שקורים ולא ביציאה: story_end – תחתית הגוף של הטקסט (ה-article) נכנסה
        // למסך, בלי אזור החתימה וה"סיפור הבא"; nextup_seen – כרטיס ההמשך נראה.
        // רק בעמודי קריאה: סיפור, גיליון שבת, מעשה שהיה ורגע (לא בית/אודות).
        const readingPage = /^\/(es\/)?(stories|historias|mabat-leshabbat|shabat|besht|asi-sucedio|moments\/[^/]+\/[^/]+|momentos\/[^/]+\/[^/]+)\//.test(
          location.pathname,
        );
        const article = readingPage ? document.querySelector('article') : null;
        if (article && 'IntersectionObserver' in window) {
          const t0 = performance.now();
          const seen = (el: Element, name: string, extra?: () => Record<string, unknown>) => {
            const io = new IntersectionObserver((entries) => {
              if (!entries.some((en) => en.isIntersecting)) return;
              io.disconnect();
              window.nmTrack?.(name, extra?.());
            });
            io.observe(el);
          };
          // סנטינל בתחתית ה-article: תחתית הטקסט עצמו, לא תחתית העמוד.
          const end = document.createElement('div');
          end.setAttribute('aria-hidden', 'true');
          end.style.cssText = 'height:1px;margin-top:-1px;pointer-events:none';
          article.append(end);
          seen(end, 'story_end', () => ({ seconds_to_end: Math.round((performance.now() - t0) / 1000) }));
          const nextUp = document.querySelector('.next-up');
          if (nextUp) seen(nextUp, 'nextup_seen');
        }
      }

      // מי שכבר לחץ "להצטרפות לקבוצה" – בכל עמוד שהוא – לא יקבל שוב את חלון
      // ההזמנה. מחוץ לבלוק המדידה בכוונה: הדגל הוא התנהגות של האתר ולא מדידה,
      // והוא חייב לעבוד גם במצב בעלים וגם בתצוגה מקדימה. localStorage בלבד,
      // בדפדפן של הקורא, כמו זיכרון הקריאה (nm_read).
      document.addEventListener('click', (event) => {
        if ((event.target as Element).closest?.('[data-ph="join_group"]')) {
          try {
            localStorage.setItem('nm_joined', '1');
          } catch {}
        }
      });
    </script>
    <footer>
      <span class="dot" aria-hidden="true"></span>
      <p><a href={homeHref}>{brand.name}</a> · {brand.slogan}</p>
      <p class="credit">
        {byLine} {brand.ownerName} · <a href={aboutHref}>{es ? 'Sobre mí' : 'אודות'}</a>
      </p>
      <p class="rights">{rights}</p>
    </footer>
    <Analytics />
  </body>
</html>

<style is:global>
  /* שני הפונטים הם variable – קובץ אחד לכל תת-קבוצה משרת את כל המשקלים.
     unicode-range מוריד את הקובץ הלטיני רק בעמוד שבאמת מציג ספרות או אותיות לטיניות. */
  @font-face {
    font-family: 'Frank Ruhl Libre';
    font-style: normal;
    font-weight: 300 900;
    font-display: swap;
    src: url('/fonts/frank-ruhl-libre-hebrew.woff2') format('woff2');
    unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
  }

  @font-face {
    font-family: 'Frank Ruhl Libre';
    font-style: normal;
    font-weight: 300 900;
    font-display: swap;
    src: url('/fonts/frank-ruhl-libre-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Heebo';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/heebo-hebrew.woff2') format('woff2');
    unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
  }

  @font-face {
    font-family: 'Heebo';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/heebo-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }

  :root {
    /* צבעים – בסיס נייר חם, צבעי המותג כנגיעות */
    --paper: #fbf7ee;
    --surface: #f3e9d3;
    --line: #e7dcc4;
    --ink: #2e2a24;
    /* טקסט משני – תקצירים ופסקאות פתיחה. כהה מספיק כדי להיקרא, בהיר מספיק כדי לא להתחרות בכותרת. */
    --secondary: #554b40;
    /* טקסט שלישוני – תאריכים, סלוגן, תחתית. */
    --muted: #75695a;
    --teal: #1f5c57;
    --teal-deep: #17453f;
    --blue: #003b5c;
    --brick: #b0463b;
    --gold: #c9a24d;

    /* טיפוגרפיה – החלטה סופית: Frank Ruhl Libre לכותרות, Heebo לטקסט ולממשק */
    --font-display: 'Frank Ruhl Libre', 'David Libre', serif;
    --font-body: 'Heebo', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;

    /* צבעים שהיו כתובים קבוע בעמודים, ומשתנים במצב לילה */
    --on-accent: #fff; /* טקסט על כפתור מלא */
    --gold-text: #8f6f28; /* זהב כטקסט – זהב המותג על שמנת נמדד 2.24 */
    --card: #fffdf6; /* דף המכתב במי אני */
    --frame: #fff; /* המסגרת של תצלום מודפס */

    --radius: 0.9rem;
    --shadow: 0 1px 3px rgba(46, 42, 36, 0.08);
    color-scheme: light;
  }

  /* ---------- מצב לילה (2026-10-26) ----------
     ברירת המחדל עוקבת אחרי הגדרת הטלפון; הכפתור בתפריט גובר עליה ונשמר
     בדפדפן (nm_theme). רקע חום-כהה חם ולא שחור, טקסט שמנת ולא לבן – אותו
     ספר, באור מנורה. צבעי המותג בגרסה בהירה של אותו גוון: הכחול העמוק
     והירוק־כחול נעלמים על רקע כהה. כל זוג נמדד מול --paper: דיו 13.8,
     משני 9.3, שקט 5.9, ירוק־כחול 8.2, כחול 8.4, אדום 6.5, זהב 8.1.
     כפתור מלא נעשה בהיר עם טקסט כהה (--on-accent). */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --paper: #1b1814;
      --surface: #24201b;
      --line: #3a342b;
      --ink: #ebe2d1;
      --secondary: #c7baa4;
      --muted: #a1937c;
      --teal: #7dbcb2;
      --teal-deep: #9fd0c6;
      --blue: #8fb7d6;
      --brick: #e2836f;
      --gold: #d1aa55;
      --on-accent: #1b1814;
      --gold-text: #d8b768;
      --card: #221e19;
      --frame: #e6dccb;
      --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
      color-scheme: dark;
    }
  }

  :root[data-theme='dark'] {
    --paper: #1b1814;
    --surface: #24201b;
    --line: #3a342b;
    --ink: #ebe2d1;
    --secondary: #c7baa4;
    --muted: #a1937c;
    --teal: #7dbcb2;
    --teal-deep: #9fd0c6;
    --blue: #8fb7d6;
    --brick: #e2836f;
    --gold: #d1aa55;
    --on-accent: #1b1814;
    --gold-text: #d8b768;
    --card: #221e19;
    --frame: #e6dccb;
    --shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
    color-scheme: dark;
  }

  * {
    margin: 0;
    box-sizing: border-box;
  }

  /* נוכח לקורא מסך ולגוגל, בלי להופיע על המסך – לעמוד שמעוצב בכוונה
     בלי כותרת גלויה. לא display:none, שמסתיר גם מקוראי מסך. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  body {
    /* עוגן לגלולת השפה בפינת הדף (.lang-pill-corner) */
    position: relative;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  a {
    color: var(--teal);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* כותרת האתר */
  header {
    text-align: center;
    padding: 1.4rem 1rem 0.5rem;
  }

  /* שורת המותג: הלוגו והשם זה לצד זה, והסלוגן שורה מתחת לשם.
     קודם לכן שלושתם היו זה מתחת לזה, והכותרת בעמודי הפנים תפסה 263px –
     כמעט שליש ממסך טלפון לפני שהתחיל תוכן. */
  .brand {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
  }

  /* גודל המותג אחיד לכל העמודים (2026-09-16): עד כה דף הבית הציג לוגו 52px
     ושם 1.45rem ועמודי הפנים 64px/1.7rem – שני מותגים לאתר אחד. הגודל הקטן
     נבחר לשניהם: הוא גם מה שמפנה בטלפון פינה לגלולת השפה ליד המותג הממורכז.
     שטח המגע נשאר מעל 44px. */
  .logo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .site-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--teal-deep);
    letter-spacing: 0.01em;
  }

  .tagline {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }

  /* חמישה פריטים בשורה אחת ב-390px (נמדד אחרי ש"מעשה שהיה" החליף את "ליווי
     אישי", 2026-10-17: 312px טקסט + 4 רווחים של 0.65rem = 354px, בתוך 358px
     פנויים). קודם, עם גופן 0.95rem ורווח 1.25rem, ארבעה
     נכנסו לשורה, הפריט החמישי נותר יתום בשנייה, וגלולת השפה נפלה לשלישית –
     201px של כותרת לפני התוכן. */
  .site-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 0.65rem;
    margin-top: 0.3rem;
    font-size: 0.9rem;
  }

  /* שטח מגע של 44px בלי להגדיל את גובה הכותרת – הריווח הופך לשטח לחיץ. */
  .site-nav a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .site-nav a:hover {
    color: var(--teal-deep);
  }

  /* ממסך רחב מ-34rem יש מקום לשורה אחת: המותג בצד אחד, הניווט בשני.
     בטלפון זה לא נכנס – נמדד ב-390px: הניווט לבדו 218px, ונשארים 108px
     ללוגו ולשם שצריכים 124px. שם הכותרת נשארת שתי שורות. */
  @media (min-width: 34rem) {
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      max-width: 48rem;
      margin-inline: auto;
      padding: 1.25rem 1.5rem 0.75rem;
    }

    .site-nav {
      margin-top: 0;
      gap: 0 1rem;
      font-size: 0.95rem;
    }
  }

  /* כותרת דף הבית – ריווח עליון מעט גדול יותר לפני הכותרת הראשית */
  .header-home {
    padding-top: 1.75rem;
  }


  /* ---------- גלולת השפה ----------
     המבנה שאושר על סקיצה (2026-08-26): בעמודים פנימיים גלולה קטנה שמובילה
     לעמוד התאום בשפה השנייה; בדפי הבית – שורת הזמנה בגוף העמוד במקומה.
     בכותרת המלאה היא יושבת בסוף שורת הניווט; בכותרת המצומצמת (עמודי רגע
     וסיפור) – בפינת הכותרת, כדי לא להוסיף שורה לפני התוכן. */
  .lang-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    align-self: center;
    padding: 0.1rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .lang-pill:hover {
    color: var(--teal);
    border-color: var(--teal);
  }

  /* בטלפון הגלולה יוצאת משורת התפריט לפינת הדף – אותו מקום שכבר יש לה
     בכותרת המצומצמת (.lang-pill-corner). המותג ממורכז, ושתי הפינות פנויות
     (נמדד ב-360px: המותג נגמר ב-275px, הגלולה מתחילה ב-286px). כך התפריט
     נושא רק את חמשת היעדים, ואינו נשבר לשורה שלישית בגלל מילה לועזית אחת. */
  @media (max-width: 33.99rem) {
    .site-nav .lang-pill {
      position: absolute;
      top: 1.6rem;
      inset-inline-end: 0.6rem;
      padding: 0 0.5rem;
      font-size: 0.72rem;
    }
  }

  /* תפריט ☰ בטלפון בכל העמודים (2026-10-26). השורה של חמשת הפריטים נכנסה
     ב-390px בלי שום מרווח, וגופן מערכת מוגדל ב-15% (הגדרה נפוצה באנדרואיד)
     הפיל את "מי אני" לשורה שנייה. עכשיו בטלפון: המותג באמצע, ☰ בפינה אחת
     וגלולת השפה בשנייה – שורה אחת, כמו בעמודי הסיפור. במסך רחב השורה נשארת. */
  @media (max-width: 33.99rem) {
    header:not(.header-compact) .site-nav {
      display: none;
    }

    /* שתי הפינות שמורות ל-☰ ולגלולה: בגופן מערכת מוגדל המותג נשבר לשתי
       שורות במקום לגלוש מתחתיהן. */
    header,
    header.header-compact {
      padding-inline: 4.6rem;
    }

    /* בספרדית הגלולה ("עברית") צרה, והסלוגן הספרדי רחב – פינות צרות יותר. */
    html[lang='es'] header {
      padding-inline: 3.6rem;
    }

    .header-home .menu-btn {
      top: 1.75rem;
    }
  }

  @media (min-width: 34rem) {
    header:not(.header-compact) .menu-btn,
    .lang-pill-phone {
      display: none;
    }
  }

  /* טלפונים צרים (360px): חמשת הפריטים נכנסים לשורה אחת רק בגופן מעט קטן
     יותר וברווח צר יותר. עדיין מעל 13px, ושטח המגע האנכי נשאר 44px. */
  @media (max-width: 23.5rem) {
    .site-nav {
      gap: 0 0.5rem;
      font-size: 0.84rem;
    }

    /* הסלוגן הספרדי ("Ponemos el punto en el centro") הוא החלק הרחב במותג,
       וב-360px הוא נגע בגלולת השפה – קטן במעט רק במסך הצר. */
    .tagline {
      font-size: 0.78rem;
    }
  }

  /* הגלולה מעוגנת לפינת הדף עצמו (body) ולא לכותרת: הכותרת המצומצמת היא
     פריט flex עם margin-inline: auto שמתכווץ לרוחב התוכן במסך רחב, וגלולה
     שנצמדת אליה נוחתת על המותג. inset-inline-end נמדד לפי כיוון הגלולה
     עצמה (dir על הקישור, הפוך משפת העמוד): עברי – פינה ימנית־עליונה,
     ספרדי – שמאלית־עליונה. המותג בכותרת המצומצמת ממורכז, ושתי הפינות פנויות. */
  /* ---------- תפריט נפתח בעמוד סיפור ----------
     בפינה הנגדית לגלולת השפה: הגלולה עוגנה לפי הכיוון שלה עצמה (הפוך מהעמוד),
     והכפתור לפי כיוון העמוד – כך הם לעולם לא באותה פינה. מעוגן ל-body כמוה. */
  .menu-btn {
    position: absolute;
    top: 1.1rem;
    inset-inline-end: 0.6rem;
    width: 44px;
    height: 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu-btn span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--teal);
  }

  .menu-btn:focus-visible,
  .menu-close:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .menu-drawer {
    display: none;
    position: fixed;
    z-index: 100;
    inset-block: 0;
    inset-inline-start: auto;
    inset-inline-end: 0;
    margin: 0;
    width: min(80vw, 20rem);
    height: 100%;
    max-height: none;
    padding: 1.5rem 1.6rem;
    border: 0;
    background: var(--paper);
    box-shadow: 0 0 30px rgb(0 0 0 / 0.15);
    text-align: start;
    font-family: var(--font-body);
  }

  .menu-drawer.is-open {
    display: flex;
    flex-direction: column;
  }

  .menu-drawer:popover-open {
    display: flex;
    flex-direction: column;
  }

  .menu-drawer::backdrop {
    background: rgb(40 30 20 / 0.35);
  }

  .menu-close {
    align-self: flex-end;
    width: 44px;
    height: 44px;
    margin-bottom: 0.75rem;
    border: 0;
    background: none;
    font-size: 1.4rem;
    color: var(--muted);
    cursor: pointer;
  }

  .menu-drawer a {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--line);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .menu-drawer a[aria-current='page'] {
    color: var(--ink);
  }

  /* מצב לילה – שורה בתחתית המגירה, ומתג במקום מילה "פעיל". */
  .theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 52px;
    margin-top: 0.5rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--secondary);
    cursor: pointer;
  }

  .theme-switch {
    position: relative;
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: var(--line);
    transition: background 0.2s ease;
    flex: 0 0 auto;
  }

  .theme-switch span {
    position: absolute;
    top: 3px;
    inset-inline-start: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    transition: inset-inline-start 0.2s ease;
  }

  .theme-row[aria-pressed='true'] .theme-switch {
    background: var(--gold);
  }

  .theme-row[aria-pressed='true'] .theme-switch span {
    inset-inline-start: 23px;
  }

  /* במסך רחב – ירח קטן בסוף שורת הניווט, ליד גלולת השפה. */
  .theme-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-icon:hover,
  .theme-icon[aria-pressed='true'] {
    color: var(--gold);
  }

  .theme-row:focus-visible,
  .theme-icon:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-switch,
    .theme-switch span {
      transition: none;
    }
  }

  .menu-drawer a.menu-home {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--blue);
  }

  .lang-pill-corner {
    position: absolute;
    top: 1.1rem;
    inset-inline-end: 1rem;
  }

  /* בטלפון הגלולה בכותרת המצומצמת קטנה ונצמדת יותר לשוליים, כמו בכותרת
     המלאה. בלי זה, בעמוד ספרדי ב-360px "עברית" נגעה בלוגו (נמדד: הגלולה
     נגמרה ב-75px והמותג התחיל ב-70px). */
  @media (max-width: 33.99rem) {
    .lang-pill-corner {
      top: 1.6rem;
      inset-inline-end: 0.6rem;
      padding: 0 0.5rem;
      font-size: 0.72rem;
    }
  }

  /* כותרת מצומצמת – עמודי סיפור, רגעים ומבט לשבת.
