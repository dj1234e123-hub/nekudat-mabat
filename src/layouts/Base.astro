---
// שלד עמוד משותף + שפת העיצוב של האתר.
// פונטים (החלטה סופית): Frank Ruhl Libre לכותרות, Heebo לטקסט השוטף ולממשק.
// הקבצים מוגשים מתוך האתר (public/fonts) ולא משרת חיצוני — מהירות, עמידות,
// ותנאי מקדים ליצירת תמונות שיתוף בזמן בנייה (שלב 4.7).
import { Image, getImage } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { SITE } from '../data/site';
import { SITE_ES } from '../data/site-es';

interface Props {
  title: string;
  description: string;
  /** כתובת מוחלטת לתמונת התצוגה המקדימה בשיתוף; ברירת מחדל — הלוגו */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** כותרת מצומצמת (עמודי סיפור): שורת מותג אחת, בלי סלוגן ותפריט — הקורא מגיע מהר לסיפור */
  compact?: boolean;
  /** כותרת דף הבית: לוגו קטן יותר ובלי שורת סלוגן — הכותרת הראשית ממלאת את מקומה.
      הסלוגן "שמים את הנקודה במרכז" נשאר סלוגן המותג וחי בתחתית ובשאר העמודים. */
  homeHeader?: boolean;
  bodyClass?: string;
  noindex?: boolean;
  /** נתונים מובנים (JSON-LD) — כך גוגל מבין שהעמוד הוא מאמר של אפרים עטיה
      ולא סתם דף. מתקבל כאובייקט מוכן מהעמוד עצמו. */
  jsonLd?: Record<string, unknown>;
  /** שפת העמוד. 'es' מחליף כיוון, תפריט ותחתית — האתר העברי אינו מושפע. */
  lang?: 'he' | 'es';
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  compact = false,
  homeHeader = false,
  bodyClass,
  noindex = false,
  jsonLd,
  lang = 'he',
} = Astro.props;

const es = lang === 'es';
const dir = es ? 'ltr' : 'rtl';
const brand = es ? SITE_ES : SITE;
// התפריט הספרדי אינו מוביל לסיפורים: הם לא תורגמו, וקישור לעמוד שאי אפשר
// לקרוא גרוע יותר מהיעדרו.
const navLinks = es
  ? [
      { href: '/es/momentos/', label: 'Momentos' },
      { href: '/es/sobre-mi/', label: 'Sobre mí' },
    ]
  : [
      { href: '/', label: 'סיפורים' },
      { href: '/moments/', label: 'מה עובר עליך' },
      { href: '/about/', label: 'מי אני' },
    ];
const aboutHref = es ? '/es/sobre-mi/' : '/about/';
const homeHref = es ? '/es/' : '/';
const byLine = es ? 'Por' : 'מאת';
const rights = es ? 'Todos los derechos reservados' : 'כל הזכויות שמורות';
const logoAlt = es ? `${SITE_ES.name} — logo` : 'הלוגו של נקודת מבט';
// טעינה מוקדמת של תת-הקבוצה שהעמוד באמת מציג: עמוד ספרדי שטוען מראש
// את הקבצים העבריים משלם על שני קבצים שלא ישמשו אותו, ומחכה לשניים שכן.
const preloadFonts = es
  ? ['/fonts/frank-ruhl-libre-latin.woff2', '/fonts/heebo-latin.woff2']
  : ['/fonts/frank-ruhl-libre-hebrew.woff2', '/fonts/heebo-hebrew.woff2'];

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultOg = await getImage({ src: logo, width: 640, format: 'jpeg' });
const ogImageUrl = ogImage ?? new URL(defaultOg.src, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={es ? "es_ES" : "he_IL"} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      preloadFonts.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <title>{title}</title>
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
  </head>
  <body class={bodyClass}>
    {
      compact ? (
        <header class="header-compact">
          <a href={homeHref} class="brand-row">
            <Image src={logo} alt={logoAlt} width={80} densities={[1, 2]} class="logo-sm" />
            <span class="site-name-sm">{brand.name}</span>
          </a>
        </header>
      ) : (
        <header class={homeHeader ? 'header-home' : undefined}>
          <a href={homeHref} class="brand">
            <Image
              src={logo}
              alt={logoAlt}
              width={homeHeader ? 112 : 144}
              densities={[1, 2]}
              class="logo"
            />
            <span class="site-name">{brand.name}</span>
          </a>
          {!homeHeader && <p class="tagline">{brand.slogan}</p>}
          {/* שמות התפריט הם בשפת הקורא ולא בשפה הפנימית שלנו: "מה עובר עליך"
              הוא בדיוק נוסח הכפתור הראשי בדף הבית — אותה דלת, אותן מילים.
              קבוצת הוואטסאפ ירדה מכאן: היא הקישור היחיד שיוצא מהאתר, והיא כבר
              מופיעה ככרטיס בתחתית כל עמוד. תפריט הוא לְמקומות בתוך הבית. */}
          <nav class="site-nav" aria-label={es ? 'Navegación principal' : 'ניווט ראשי'}>
            {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
        </header>
      )
    }
    <slot />
    <footer>
      <span class="dot" aria-hidden="true"></span>
      <p><a href={homeHref}>{brand.name}</a> · {brand.slogan}</p>
      <p class="credit">
        {byLine} {brand.ownerName} · <a href={aboutHref}>{es ? 'Sobre mí' : 'אודות'}</a>
      </p>
      <p class="rights">{rights}</p>
    </footer>
  </body>
</html>

<style is:global>
  /* שני הפונטים הם variable — קובץ אחד לכל תת-קבוצה משרת את כל המשקלים.
     unicode-range מוריד את הקובץ הלטיני רק בעמוד שבאמת מציג ספרות או אותיות לטיניות. */
  @font-face {
    font-family: 'Frank Ruhl Libre';
    font-style: normal;
    font-weight: 300 900;
    font-display: swap;
    src: url('/fonts/frank-ruhl-libre-hebrew.woff2') format('woff2');
    unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
  }

  @font-face {
    font-family: 'Frank Ruhl Libre';
    font-style: normal;
    font-weight: 300 900;
    font-display: swap;
    src: url('/fonts/frank-ruhl-libre-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Heebo';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/heebo-hebrew.woff2') format('woff2');
    unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
  }

  @font-face {
    font-family: 'Heebo';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/heebo-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }

  :root {
    /* צבעים — בסיס נייר חם, צבעי המותג כנגיעות */
    --paper: #fbf7ee;
    --surface: #f3e9d3;
    --line: #e7dcc4;
    --ink: #2e2a24;
    /* טקסט משני — תקצירים ופסקאות פתיחה. כהה מספיק כדי להיקרא, בהיר מספיק כדי לא להתחרות בכותרת. */
    --secondary: #554b40;
    /* טקסט שלישוני — תאריכים, סלוגן, תחתית. */
    --muted: #75695a;
    --teal: #1f5c57;
    --teal-deep: #17453f;
    --blue: #003b5c;
    --brick: #b0463b;
    --gold: #c9a24d;

    /* טיפוגרפיה — החלטה סופית: Frank Ruhl Libre לכותרות, Heebo לטקסט ולממשק */
    --font-display: 'Frank Ruhl Libre', 'David Libre', serif;
    --font-body: 'Heebo', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;

    --radius: 0.9rem;
    --shadow: 0 1px 3px rgba(46, 42, 36, 0.08);
  }

  * {
    margin: 0;
    box-sizing: border-box;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.9;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  a {
    color: var(--teal);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* כותרת האתר */
  header {
    text-align: center;
    padding: 2.25rem 1.5rem 0.75rem;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .logo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .site-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--teal-deep);
    letter-spacing: 0.01em;
  }

  .tagline {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.3rem;
  }

  .site-nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  /* שטח מגע של 44px בלי להגדיל את גובה הכותרת — הריווח הופך לשטח לחיץ. */
  .site-nav a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .site-nav a:hover {
    color: var(--teal-deep);
  }

  /* כותרת דף הבית — מפנה מקום לכותרת הראשית: 263px ← 192px */
  .header-home {
    padding-top: 1.75rem;
  }

  .header-home .logo {
    width: 56px;
    height: 56px;
  }

  .header-home .site-name {
    font-size: 1.45rem;
  }

  /* שם האתר בדף הבית — מעבר גוונים עדין בין שלושה מצבעי המותג:
     כחול עמוק → ירוק־כחול → אדום עמוק. אותם צבעים שכבר חיים באתר ובלוגו,
     רק שהם זורמים זה לתוך זה במקום להיות גוון אחד.
     הצבע הרגיל מוגדר קודם ומשמש כנפילה לאחור; רק דפדפן שתומך בגזירת רקע
     לטקסט מחליף אותו במעבר. כך אין מצב של שם בלתי נראה. */
  .header-home .site-name {
    background-image: linear-gradient(
      100deg,
      var(--blue) 0%,
      var(--teal-deep) 34%,
      var(--teal) 54%,
      var(--brick) 94%
    );
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .header-home .site-name {
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }

  /* כותרת מצומצמת — עמודי סיפור */
  .header-compact {
    text-align: center;
    padding: 1.1rem 1.5rem 0.25rem;
  }

  .brand-row {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }

  .logo-sm {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .site-name-sm {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--teal-deep);
  }

  main {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    padding: 1.5rem 1.25rem 3rem;
    flex: 1;
  }

  /* תחתית */
  footer {
    text-align: center;
    padding: 2rem 1.5rem 2.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  footer .dot {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 0 auto 1rem;
  }

  footer a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
  }

  footer .credit {
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  /* בעברית בלבד ובלי שנה — כדי שקובץ הפונט הלטיני (30KB) לא יירד בעמודים
     שאין בהם ספרות, כמו הרגעים והאודות. */
  footer .rights {
    font-size: 0.75rem;
    margin-top: 0.6rem;
  }

  /* ---------- שלושת רכיבי הגלולה ----------
     עד כה רכיב אחד (.topic-tag) שימש לארבע מטרות בארבע רמות חשיבות שונות.
     אותה שפה עיצובית, אבל כל תפקיד מקבל את המשקל ושטח המגע שמתאימים לו:

       .label   — תווית מידע. לא יעד עיקרי. קטנה ושקטה.
       .choice  — בחירה או ניווט. יעד מגע מלא (44px).
       .action  — פעולה (ולא מקום). כמו .choice, בצבע הפעולה של המותג.
  */

  .label,
  .choice,
  .action {
    background: var(--surface);
    color: var(--teal-deep);
    text-decoration: none;
    font-weight: 600;
    border-radius: 1rem;
    border: 1px solid var(--line);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  /* תווית */
  .label {
    display: inline-block;
    font-size: 0.85rem;
    padding: 0.2rem 0.8rem;
  }

  /* בחירה / ניווט */
  .choice,
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: 0.9rem;
    padding: 0.35rem 1.05rem;
    font-family: inherit;
    line-height: 1.3;
  }

  .action {
    color: var(--brick);
    cursor: pointer;
  }

  .label:hover,
  .choice:hover,
  .action:hover {
    background: var(--line);
    border-color: var(--muted);
  }

  /* הפעולה הראשית של האתר. אדום עמוק — הצבע המזוהה בלוגו, יחס 5.55 מול לבן.
     יש רק כפתור אחד כזה בעמוד; ההצטרפות לקבוצה היא פעולה משנית ושקטה יותר. */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    background: var(--brick);
    color: #fff;
    font-weight: 700;
    font-size: 1.02rem;
    text-decoration: none;
    padding: 0.6rem 1.9rem;
    border-radius: 2rem;
    transition: filter 0.15s ease;
  }

  .cta:hover {
    filter: brightness(0.93);
  }
</style>
