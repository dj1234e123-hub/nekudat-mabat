---
// שלד עמוד משותף. העיצוב כאן בסיסי בכוונה — שפת העיצוב המלאה נבנית בשלב 3.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" class="site-name">נקודת מבט</a>
      <p class="tagline">ספרייה חיה של סיפורים</p>
    </header>
    <slot />
    <footer>
      <a href="/">נקודת מבט</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #faf6ec;
    --ink: #2b2620;
    --muted: #6f665a;
    --accent: #1f5c57;
    --brick: #b0463b;
    --gold: #c9a24d;
    --cream: #f3e9d3;
  }

  * {
    margin: 0;
    box-sizing: border-box;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;
    line-height: 1.8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  header {
    text-align: center;
    padding: 2.5rem 1.5rem 1.5rem;
  }

  .site-name {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }

  .tagline {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  main {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    padding: 0 1.25rem 3rem;
    flex: 1;
  }

  footer {
    text-align: center;
    padding: 2rem 1.5rem;
    font-size: 0.85rem;
  }

  footer a {
    color: var(--muted);
    text-decoration: none;
  }

  a {
    color: var(--accent);
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .topic-tag {
    display: inline-block;
    background: var(--cream);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.15rem 0.7rem;
    border-radius: 1rem;
  }
</style>
