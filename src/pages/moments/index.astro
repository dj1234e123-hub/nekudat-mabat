---
// עמוד הכניסה ל"רגע של נקודת מבט".
// הניווט כאן הוא לפי *רגש*, לא לפי זמן — הקורא מגיע עם מה שעובר עליו עכשיו.
// שלוש הקבוצות מסודרות כתנועה: מכאב, דרך קושי, אל התחלה.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { FEELING_GROUPS } from '../../data/feelings';

const moments = await getCollection('moments');
// מצב בלי תוכן עדיין מוצג (הוא חלק מהמבנה) אבל אינו קישור — כדי שלא להוביל למדף ריק.
const filled = new Set(moments.map((moment) => moment.data.feeling));
// דלת למי שלא מצליח לקרוא לזה בשם — רגע אקראי במקום בחירה מתוך רשימה.
const momentUrls = moments.map((moment) => `/moments/${moment.data.feeling}/${moment.id}/`);
---

<Base
  title="רגע של נקודת מבט"
  description="משפטים ותובנות קצרות לפי מה שעובר עליך עכשיו. רגע לעצור."
>
  <main>
    <h1 class="page-title">רגע של נקודת מבט</h1>
    <p class="question">מה עובר עליך עכשיו?</p>
    <button id="random-moment" class="unsure" type="button">לא יודע מה אני מרגיש עכשיו</button>

    {
      FEELING_GROUPS.map((group) => (
        <section class="group">
          <h2 class="group-label">{group.label}</h2>
          <ul class="feelings">
            {group.feelings.map((feeling) =>
              filled.has(feeling.slug) ? (
                <li>
                  <a class="choice" href={`/moments/${feeling.slug}/`}>{feeling.label}</a>
                </li>
              ) : (
                <li>
                  <span class="choice is-empty" aria-disabled="true">{feeling.label}</span>
                </li>
              )
            )}
          </ul>
        </section>
      ))
    }

    <p class="soon">מצבים נוספים ותכנים נוספים — בדרך.</p>
  </main>
</Base>

<script is:inline define:vars={{ momentUrls }}>
  document.getElementById('random-moment').addEventListener('click', () => {
    location.href = momentUrls[Math.floor(Math.random() * momentUrls.length)];
  });
</script>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.75rem;
  }

  .question {
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--teal-deep);
    margin-bottom: 0.9rem;
  }

  /* קישור שקט למי שלא מצליח לבחור מצב */
  .unsure {
    display: block;
    min-height: 44px;
    margin: 0 auto 2.5rem;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line);
    cursor: pointer;
  }

  .unsure:hover {
    color: var(--teal);
    text-decoration-color: var(--teal);
  }

  .group {
    margin-bottom: 2.25rem;
  }

  .group-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--secondary);
    text-align: center;
    margin-bottom: 0.85rem;
  }

  .feelings {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  /* מצב שעדיין אין בו תוכן — נוכח במבנה, אך לא מוביל לשום מקום */
  .choice.is-empty {
    color: var(--muted);
    background: transparent;
    border-style: dashed;
    cursor: default;
  }

  .choice.is-empty:hover {
    background: transparent;
    border-color: var(--line);
  }

  .soon {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 2.5rem;
  }
</style>
