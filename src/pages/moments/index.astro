---
// עמוד הכניסה ל"רגע של נקודת מבט" — חמישה שערים.
//
// הקורא לא סורק רשימה: הוא עומד מול חמש קשתות, אחת לכל קבוצת מצבים, ובוחר
// לאן להיכנס. לחיצה על שער פותחת את קבוצת המצבים שלו וגוללת אליה — המדפים,
// שורות הדלת, הסימנים והעוגנים של שלב 4.18/4.21 נשארים בדיוק כמו שהיו.
//
// התמונות שבתוך הקשתות הן ממלאות מקום (src/components/GateArt.astro) עד
// שבעל הפרויקט ייצור ויעלה תמונות משלו — קובץ אחד לכל שער. הקשת, מסגרת
// הזהב, השם והשורה קבועים ואינם תלויים בתמונה.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { FEELING_GROUPS } from '../../data/feelings';
import { SITE } from '../../data/site';
import GateArt from '../../components/GateArt.astro';
import FeelingDoors from '../../components/FeelingDoors.astro';

const moments = await getCollection('moments');
// מצב בלי תוכן עדיין מוצג (הוא חלק מהמבנה) אבל אינו קישור — כדי שלא להוביל למדף ריק.
const filled = new Set(moments.map((moment) => moment.data.feeling));
// דלת למי שלא מצליח לקרוא לזה בשם — רגע אקראי במקום בחירה מתוך רשימה.
const momentUrls = moments.map((moment) => `/moments/${moment.data.feeling}/${moment.id}/`);

// דלת למי שדווקא יודע מה עובר עליו — ואין לזה מדף. פנייה פרטית לאפרים,
// באותה שפה של שורת התגובה שבסוף הסיפורים: קישור שקט, לא כפתור.
// זה גם ערוץ האמת היחיד לדעת אילו מצבים חסרים. הרגעים עצמם נשארים נקיים —
// הדלת הזו חיה בעמוד הכניסה בלבד (החלטת בעל הפרויקט 2026-08-24).
const tellMeMessage = 'שלום אפרים, חיפשתי בפינת הרגעים משהו שעובר עליי, ולא מצאתי:\n';
const tellMeHref = `https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(tellMeMessage)}`;
---

<Base
  title="רגע של נקודת מבט"
  description="משפטים ותובנות קצרות לפי מה שעובר עליך עכשיו. רגע לעצור."
  altLangHref="/es/momentos/"
>
  <main>
    <h1 class="page-title">רגע של נקודת מבט</h1>
    <p class="question">מה עובר עליך עכשיו?</p>
    <p class="invite">חמישה שערים. תיכנס בזה שקורא לך.</p>

    <ul class="gates">
      {
        FEELING_GROUPS.map((group) => (
          <li>
            <a
              class="gate"
              href={`/moments/${group.slug}/`}
              style={`--accent: ${group.accent}; --title: ${group.titleAccent}`}
            >
              <span class="arch">
                <GateArt group={group.slug} />
              </span>
              <span class="gate-name">{group.label}</span>
              <span class="gate-line">{group.line}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <button id="random-moment" class="unsure" type="button" data-ph="random_moment">לא יודע מה אני מרגיש עכשיו</button>

    <h2 class="map-label" id="all-feelings">כל המצבים</h2>

    {
      /* קבוצה מתקפלת: עם 22 מצבים, רשימה פתוחה אחת הופכת לעמוד ארוך שצריך
         לגלול בו כדי לסרוק. <details> נבחר כי הוא עובד גם בלי JavaScript,
         נגיש למקלדת ולקורא מסך, וניתן לפתיחה מכל מקום בלי שנצטרך לנהל מצב.
         כשהשערים למעלה הם הדלת הראשית, כל הקבוצות מתחילות סגורות — שער
         שנלחץ פותח את שלו. */
      FEELING_GROUPS.map((group) => (
        <details
          class="group"
          id={group.slug}
          style={`--accent: ${group.accent}; --title: ${group.titleAccent}`}
        >
          <summary class="group-label">
            <span class="group-dot" aria-hidden="true" />
            {group.label}
          </summary>
          <FeelingDoors group={group} filled={filled} />
        </details>
      ))
    }

    <p class="soon">מצבים נוספים ותכנים נוספים — בדרך.</p>
    <p class="tell-me">
      לא מצאת כאן את מה שעובר עליך?
      <a href={tellMeHref} rel="noopener" target="_blank" data-ph="tell_me">אפשר לספר לי</a>
    </p>
  </main>
</Base>

<script is:inline define:vars={{ momentUrls }}>
  document.getElementById('random-moment').addEventListener('click', () => {
    location.href = momentUrls[Math.floor(Math.random() * momentUrls.length)];
  });

  // עוגן ישן (למשל /moments/#upward, מהתקופה שלפני עמודי השער) עדיין פותח
  // את הקבוצה שלו במפת "כל המצבים" וגולל אליה — כתובות ששותפו לא נשברות.
  // בלי JavaScript הדפדפן עדיין גולל לכותרת הקבוצה; היא רק נשארת סגורה עד הקשה.
  const target = location.hash && document.getElementById(location.hash.slice(1));
  if (target && target.tagName === 'DETAILS') {
    target.open = true;
    target.scrollIntoView();
  }
</script>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.75rem;
  }

  .question {
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--teal-deep);
    margin-bottom: 0.35rem;
  }

  .invite {
    text-align: center;
    color: var(--secondary);
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  /* ── השערים ── */
  .gates {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 26rem;
    display: grid;
    gap: 1.7rem;
  }

  .gate {
    display: block;
    text-align: center;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* קשת השער: התמונה יושבת בתוך המסגרת, והמסגרת נשארת גם כשהתמונה תתחלף */
  .arch {
    position: relative;
    display: block;
    height: 170px;
    border-radius: 130px 130px 6px 6px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 10px 26px rgba(46, 42, 36, 0.14);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  /* מסגרת זהב פנימית דקה — חתימת השער, נשארת מעל כל תמונה */
  .arch::after {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(201, 162, 77, 0.55);
    border-radius: 122px 122px 3px 3px;
    pointer-events: none;
  }

  .arch :global(svg),
  .arch :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .gate:hover .arch,
  .gate:focus-visible .arch {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(46, 42, 36, 0.2);
  }

  .gate:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 6px;
    border-radius: 8px;
  }

  .gate-name {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--title);
  }

  .gate-line {
    display: block;
    margin-top: 0.1rem;
    color: var(--secondary);
    font-size: 0.92rem;
  }

  /* קישור שקט למי שלא מצליח לבחור שער */
  .unsure {
    display: block;
    min-height: 44px;
    margin: 2.4rem auto 3rem;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line);
    cursor: pointer;
  }

  .unsure:hover {
    color: var(--teal);
    text-decoration-color: var(--teal);
  }

  /* ── מפת המצבים המלאה ── */
  .map-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 0.9rem;
  }

  .group {
    border-top: 1px solid var(--line);
  }

  .group:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  /* כותרת הקבוצה נושאת את צבע הזהות (--title). ברוב הקבוצות הוא זהה
     ל---accent; בקבוצת הזהב הוא דיו — זהב נמדד 2.24:1 כטקסט (התקן 4.5). */
  .group-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 52px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--title);
    cursor: pointer;
    list-style: none;
  }

  /* נקודת הצבע של הקבוצה — אותו דפוס של עולמות הסיפורים: נקודה, לא מילוי */
  .group-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ברירת המחדל של הדפדפן היא משולש בצד; מוחלף בחץ משלנו שמסתובב בפתיחה */
  .group-label::-webkit-details-marker {
    display: none;
  }

  .group-label::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-inline-start: 2px solid var(--gold);
    border-block-end: 2px solid var(--gold);
    transform: rotate(-45deg) translate(0.1rem, -0.1rem);
    transition: transform 0.15s ease;
  }

  .group[open] > .group-label::after {
    transform: rotate(135deg) translate(-0.05rem, -0.05rem);
  }

  .group-label:hover {
    opacity: 0.8;
  }

  .soon {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 2.5rem;
  }

  /* דלת למי שלא מצא את המצב שלו — קישור שקט באותה שפה של שורת התגובה
     שבסוף הסיפורים. פעולה שלישית בעמוד הייתה רועשת מדי ככפתור. */
  .tell-me {
    text-align: center;
    color: var(--secondary);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .tell-me a {
    color: var(--teal);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    /* שטח מגע נוח בלי לשבור את השורה */
    display: inline-block;
    padding-block: 0.6rem;
  }

  .tell-me a:hover {
    color: var(--teal-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .gate:hover .arch,
    .gate:focus-visible .arch {
      transform: none;
    }
  }
</style>
