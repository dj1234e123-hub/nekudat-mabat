---
// עמוד הכניסה ל"רגע של נקודת מבט".
// הניווט כאן הוא לפי *רגש*, לא לפי זמן — הקורא מגיע עם מה שעובר עליו עכשיו.
//
// כל מצב הוא "דלת": שם המצב, שורת דלת שמזהה ("זה מוכר לי") בלי לתייג,
// וסימן — מחווה של קו שמתנהגת כמו הרגש. שורת מדף, לא כרטיס: בלי רקע
// ובלי צל, רק קו מפריד דק — כך 22 מצבים נשארים עמוד שסורקים, לא פיד.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { FEELING_GROUPS } from '../../data/feelings';
import { FEELING_MARKS } from '../../data/feeling-marks';

const moments = await getCollection('moments');
// מצב בלי תוכן עדיין מוצג (הוא חלק מהמבנה) אבל אינו קישור — כדי שלא להוביל למדף ריק.
const filled = new Set(moments.map((moment) => moment.data.feeling));
// דלת למי שלא מצליח לקרוא לזה בשם — רגע אקראי במקום בחירה מתוך רשימה.
const momentUrls = moments.map((moment) => `/moments/${moment.data.feeling}/${moment.id}/`);
---

<Base
  title="רגע של נקודת מבט"
  description="משפטים ותובנות קצרות לפי מה שעובר עליך עכשיו. רגע לעצור."
>
  <main>
    <h1 class="page-title">רגע של נקודת מבט</h1>
    <p class="question">מה עובר עליך עכשיו?</p>
    <button id="random-moment" class="unsure" type="button">לא יודע מה אני מרגיש עכשיו</button>

    {
      /* קבוצה מתקפלת: עם 22 מצבים, רשימה פתוחה אחת הופכת לעמוד ארוך שצריך
         לגלול בו כדי לסרוק. ארבע כותרות זו סריקה של שנייה. <details> נבחר
         כי הוא עובד גם בלי JavaScript, נגיש למקלדת ולקורא מסך, וניתן לפתיחה
         מכל מקום בלי שנצטרך לנהל מצב. הראשונה פתוחה כדי שהעמוד לא ייראה סגור. */
      FEELING_GROUPS.map((group, index) => (
        <details
          class="group"
          open={index === 0}
          style={`--accent: ${group.accent}; --title: ${group.titleAccent}`}
        >
          <summary class="group-label">
            <span class="group-dot" aria-hidden="true" />
            {group.label}
          </summary>
          <ul class="doors">
            {group.feelings.map((feeling) => {
              const inner = (
                <>
                  <span class="door-text">
                    <span class="door-name">{feeling.label}</span>
                    <span class="door-line">{feeling.line}</span>
                  </span>
                  <svg
                    class="door-mark"
                    width="66"
                    height="33"
                    viewBox="0 0 56 28"
                    aria-hidden="true"
                    set:html={FEELING_MARKS[feeling.slug]}
                  />
                </>
              );
              return (
                <li>
                  {filled.has(feeling.slug) ? (
                    <a class="door" href={`/moments/${feeling.slug}/`}>{inner}</a>
                  ) : (
                    <span class="door is-empty" aria-disabled="true">{inner}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      ))
    }

    <p class="soon">מצבים נוספים ותכנים נוספים — בדרך.</p>
  </main>
</Base>

<script is:inline define:vars={{ momentUrls }}>
  document.getElementById('random-moment').addEventListener('click', () => {
    location.href = momentUrls[Math.floor(Math.random() * momentUrls.length)];
  });
</script>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.75rem;
  }

  .question {
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--teal-deep);
    margin-bottom: 0.9rem;
  }

  /* קישור שקט למי שלא מצליח לבחור מצב */
  .unsure {
    display: block;
    min-height: 44px;
    margin: 0 auto 2.5rem;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line);
    cursor: pointer;
  }

  .unsure:hover {
    color: var(--teal);
    text-decoration-color: var(--teal);
  }

  .group {
    border-top: 1px solid var(--line);
  }

  .group:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  /* כותרת הקבוצה נושאת את צבע הזהות (--title). ברוב הקבוצות הוא זהה
     ל---accent; בקבוצת הזהב הוא דיו — זהב נמדד 2.24:1 כטקסט (התקן 4.5). */
  .group-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 52px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--title);
    cursor: pointer;
    list-style: none;
  }

  /* נקודת הצבע של הקבוצה — אותו דפוס של עולמות הסיפורים: נקודה, לא מילוי */
  .group-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ברירת המחדל של הדפדפן היא משולש בצד; מוחלף בחץ משלנו שמסתובב בפתיחה */
  .group-label::-webkit-details-marker {
    display: none;
  }

  .group-label::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-inline-start: 2px solid var(--gold);
    border-block-end: 2px solid var(--gold);
    transform: rotate(-45deg) translate(0.1rem, -0.1rem);
    transition: transform 0.15s ease;
  }

  .group[open] > .group-label::after {
    transform: rotate(135deg) translate(-0.05rem, -0.05rem);
  }

  .group-label:hover {
    opacity: 0.8;
  }

  .doors {
    list-style: none;
    padding: 0 0 1rem;
    margin: 0;
  }

  .doors li + li {
    border-top: 1px solid var(--line);
  }

  /* דלת: שורה ברוחב מלא, כמו מדף בספרייה. לא קופסה ולא כרטיס פוסט. */
  .door {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 72px;
    padding: 1rem 0.4rem;
    text-decoration: none;
  }

  .door-text {
    display: flex;
    flex-direction: column;
  }

  .door-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .door-line {
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-top: 0.15rem;
  }

  /* הסימן יושב בקצה השורה, שקט אך נוכח. בריחוף הוא מתחזק — הדלת עונה למגע.
     מוגדל מעט מגודל הציור (viewBox) כדי שלא ייעלם בגלילה מהירה בטלפון. */
  .door-mark {
    flex-shrink: 0;
    margin-inline-start: 0.35rem;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  a.door:hover .door-name {
    color: var(--title);
  }

  a.door:hover .door-mark {
    opacity: 1;
  }

  /* מצב שעדיין אין בו תוכן — נוכח במבנה, אך לא מוביל לשום מקום */
  .door.is-empty .door-name,
  .door.is-empty .door-line {
    color: var(--muted);
  }

  .door.is-empty .door-mark {
    opacity: 0.3;
  }

  .soon {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 2.5rem;
  }
</style>
