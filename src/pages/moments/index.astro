---
// עמוד הרגעים — בגרסה חדשה ומהפכנית.
//
// במקום רשימת מצבים מתקפלת, הקורא נקלט בלי בחירה:
// - רגע אקראי בהתחלה (בלי הקשר)
// - גלילה → המצב שלו מופיע בהדרגה
// - גלילה → רגעים דומים מופיעים בהדרגה
// - זרימה אינסופית: כל הרגעים הנותרים
//
// זה הופך את עמוד הרגעים מ"מסך בחירה" ל"מסע קריאה".

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { FEELING_GROUPS, feelingLabel } from '../../data/feelings';
import { FEELING_MARKS } from '../../data/feeling-marks';
import { SITE } from '../../data/site';
import MomentBody from '../../components/MomentBody.astro';
import { parseMoment } from '../../lib/moment-format';

const moments = await getCollection('moments');

// אוספים רגעים לפי מצב
const momentsByFeeling = new Map<string, any[]>();
for (const moment of moments) {
  const feeling = moment.data.feeling;
  if (!momentsByFeeling.has(feeling)) {
    momentsByFeeling.set(feeling, []);
  }
  momentsByFeeling.get(feeling)!.push(moment);
}

// רגע פתיחה אקראי — בלי בחירה
const allMomentsArray = Array.from(moments);
const starterMoment = allMomentsArray[Math.floor(Math.random() * allMomentsArray.length)];
const starterFeeling = starterMoment.data.feeling;
const starterFormat = parseMoment(starterMoment.body ?? '', starterMoment.data.title);
const starterLabel = feelingLabel(starterFeeling);

// רגעים דומים (אותו מצב)
const relatedMoments = (momentsByFeeling.get(starterFeeling) || [])
  .filter((m) => m.id !== starterMoment.id)
  .map((m) => ({
    id: m.id,
    feeling: m.data.feeling,
    format: parseMoment(m.body ?? '', m.data.title),
    url: `/moments/${m.data.feeling}/${m.id}/`,
  }))
  .slice(0, 6); // מראים שישה רגעים דומים בלבד

// כל הרגעים האחרים, לגלילה אינסופית
const allOtherMoments = Array.from(moments)
  .filter((m) => m.id !== starterMoment.id)
  .map((m) => ({
    id: m.id,
    feeling: m.data.feeling,
    format: parseMoment(m.body ?? '', m.data.title),
    url: `/moments/${m.data.feeling}/${m.id}/`,
    label: feelingLabel(m.data.feeling),
  }))
  .sort(() => Math.random() - 0.5); // שיבוט אקראי

// דלת למי שלא מצא את המצב שלו
const tellMeMessage = 'שלום אפרים, חיפשתי בפינת הרגעים משהו שעובר עליי, ולא מצאתי:\n';
const tellMeHref = `https://wa.me/${SITE.whatsappNumber}?text=${encodeURIComponent(tellMeMessage)}`;
---

<Base
  title="רגע של נקודת מבט"
  description="משפטים ותובנות קצרות לפי מה שעובר עליך עכשיו."
>
  <main class="moments-stream">
    {/* רגע פתיחה אקראי — בלי בחירה, בלי הקשר */}
    <section class="stream-opening" id="stream-opening">
      <article class="moment-intro">
        <h1 class="moment-title">
          <a href={`/moments/${starterFeeling}/${starterMoment.id}/`}>
            {starterFormat.title}
          </a>
        </h1>
        <div class="moment-content">
          <MomentBody format={starterFormat} />
        </div>
        <p class="moment-hint">גלול למטה לחקירה עמוקה יותר</p>
      </article>
    </section>

    {/* המצב שלו מופיע בהדרגה */}
    <section class="stream-feeling" id="stream-feeling">
      <div class="feeling-reveal">
        <span class="feeling-dot" aria-hidden="true"></span>
        <span class="feeling-name">{starterLabel}</span>
      </div>
      <a href={`/moments/${starterFeeling}/`} class="feeling-door">
        כל הרגעים של {starterLabel}
      </a>
    </section>

    {/* רגעים דומים — מתחת */}
    {relatedMoments.length > 0 && (
      <section class="stream-related" id="stream-related">
        <h2 class="section-title">עוד ב{starterLabel}</h2>
        <ul class="moment-cards">
          {relatedMoments.map((m) => (
            <li class="moment-card-item">
              <a href={m.url} class="moment-card-link">
                <h3 class="moment-card-title">{m.format.title}</h3>
                <div class="moment-preview">
                  <MomentBody format={m.format} firstStanzaOnly={true} />
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* גלילה אינסופית — כל הרגעים האחרים */}
    <section class="stream-infinite" id="stream-infinite">
      <h2 class="section-title">רגעים נוספים</h2>
      <ul class="moment-cards" id="infinite-list">
        {allOtherMoments.slice(0, 12).map((m) => (
          <li class="moment-card-item" data-moment-id={m.id}>
            <a href={m.url} class="moment-card-link">
              <span class="moment-feeling-tag">{m.label}</span>
              <h3 class="moment-card-title">{m.format.title}</h3>
              <div class="moment-preview">
                <MomentBody format={m.format} firstStanzaOnly={true} />
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div id="load-more" class="load-more-trigger"></div>
    </section>

    <p class="tell-me">
      לא מצאת כאן את מה שעובר עליך?
      <a href={tellMeHref} rel="noopener" target="_blank">אפשר לספר לי</a>
    </p>
  </main>
</Base>

<script define:vars={{ allOtherMoments: JSON.stringify(allOtherMoments) }}>
  // גלילה אינסופית — כשמגיע לתחתון, טוענים עוד רגעים
  let displayedCount = 12;
  const infiniteList = document.getElementById('infinite-list');
  const loadMoreTrigger = document.getElementById('load-more-trigger');
  const momentsData = JSON.parse(allOtherMoments);

  if (loadMoreTrigger && infiniteList) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const nextItems = momentsData.slice(displayedCount, displayedCount + 12);
          if (nextItems.length === 0) {
            observer.unobserve(loadMoreTrigger);
            loadMoreTrigger.style.display = 'none';
            return;
          }

          nextItems.forEach((m) => {
            const li = document.createElement('li');
            li.className = 'moment-card-item';
            li.innerHTML = `
              <a href="${m.url}" class="moment-card-link">
                <span class="moment-feeling-tag">${m.label}</span>
                <h3 class="moment-card-title">${m.format.title}</h3>
              </a>
            `;
            infiniteList.appendChild(li);
          });

          displayedCount += 12;

          if (displayedCount >= momentsData.length) {
            observer.unobserve(loadMoreTrigger);
          }
        }
      });
    });

    observer.observe(loadMoreTrigger);
  }

  // המצב מתגלה בהדרגה כשגוללים
  const feeling = document.getElementById('stream-feeling');
  const opening = document.getElementById('stream-opening');

  if (feeling && opening) {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            feeling.classList.add('is-visible');
          }
        });
      },
      { threshold: 0.1 }
    );

    revealObserver.observe(opening);
  }
</script>

<style>
  .moments-stream {
    padding-top: 1rem;
  }

  /* רגע פתיחה — בפוקוס מלא, בלי בחירה */
  .stream-opening {
    margin-bottom: 5rem;
  }

  .moment-intro {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .moment-title {
    font-size: 1.85rem;
    line-height: 1.3;
    color: var(--blue);
    margin-bottom: 2rem;
    text-wrap: balance;
  }

  .moment-title a {
    color: inherit;
    text-decoration: none;
  }

  .moment-title a:hover {
    color: var(--teal-deep);
  }

  .moment-content {
    --moment-size: 1.3rem;
    margin-bottom: 1.5rem;
  }

  .moment-hint {
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
    margin-top: 2rem;
  }

  /* המצב מופיע בהדרגה */
  .stream-feeling {
    text-align: center;
    padding: 3.5rem 0;
    opacity: 0;
    transition: opacity 0.8s ease-out;
  }

  .stream-feeling.is-visible {
    opacity: 1;
  }

  .feeling-reveal {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.8rem;
    background: var(--surface);
    border-radius: 2rem;
    border: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }

  .feeling-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--teal);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.6;
    }
  }

  .feeling-name {
    font-weight: 600;
    color: var(--ink);
    font-family: var(--font-display);
  }

  .feeling-door {
    display: inline-block;
    min-height: 44px;
    padding: 0.6rem 1.2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 1rem;
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .feeling-door:hover {
    background: var(--line);
    border-color: var(--muted);
  }

  /* רגעים דומים */
  .stream-related {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 1.15rem;
    font-weight: 600;
    text-align: center;
    color: var(--secondary);
    margin-bottom: 1.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .moment-cards {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .moment-card-item {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .moment-card-item:hover {
    border-color: var(--muted);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .moment-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .moment-feeling-tag {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.6rem;
  }

  .moment-card-title {
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 1rem;
    font-family: var(--font-display);
  }

  .moment-preview {
    --moment-size: 0.95rem;
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* גלילה אינסופית */
  .stream-infinite {
    margin-bottom: 3rem;
  }

  .load-more-trigger {
    height: 100px;
    margin-top: 3rem;
  }

  /* דלת למי שלא מצא את המצב שלו */
  .tell-me {
    text-align: center;
    color: var(--secondary);
    font-size: 0.9rem;
    margin-top: 3rem;
  }

  .tell-me a {
    color: var(--teal);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    display: inline-block;
    padding-block: 0.6rem;
  }

  .tell-me a:hover {
    color: var(--teal-deep);
  }
</style>
