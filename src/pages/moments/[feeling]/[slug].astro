---
// עמוד של רגע בודד — הכתובת שמשתפים.
// העמוד שקט בכוונה: הטקסט, ומסביבו אוויר. בלי תמונה, בלי תאריך, בלי זמן קריאה.
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ShareRow from '../../../components/ShareRow.astro';
import { feelingLabel, groupLabel, type FeelingSlug } from '../../../data/feelings';
import { articleJsonLd } from '../../../lib/structured-data';
import { momentTitle } from '../../../lib/moment-title';

export async function getStaticPaths() {
  const moments = await getCollection('moments');
  return moments.map((moment) => ({
    params: { feeling: moment.data.feeling, slug: moment.id },
    props: { moment },
  }));
}

const { moment } = Astro.props;
const { Content } = await render(moment);
const feeling = moment.data.feeling as FeelingSlug;
const label = feelingLabel(feeling);

// הטקסט כמלל נקי — לתיאור העמוד ולשיתוף בוואטסאפ (הרגע נשלח כמו שהוא).
const plainText = moment.body!.replace(/\s+/g, ' ').trim();
const summary = plainText.length > 200 ? `${plainText.slice(0, 197)}…` : plainText;

const pageUrl = new URL(`/moments/${feeling}/${moment.id}/`, Astro.site).href;
// תמונת שיתוף ממותגת, נוצרת בזמן הבנייה מהטקסט עצמו (ראו og.png.ts באותה תיקייה).
// חשוב בעיקר לשיתוף בסטטוס, שבו הקישור נעלם והתמונה היא כל מה שנשאר.
const ogImage = new URL(`/moments/${feeling}/${moment.id}/og.png`, Astro.site).href;

// כותרת ייחודית לכל רגע, נגזרת מהטקסט (ראו moment-title.ts). קודם לכן שלושת
// הרגעים של כל מצב חלקו כותרת אחת, וגוגל ראה בהם שכפול ובחר אחד מהם.
// בלי שם המותג בסוף: הכותרת קצרה ממילא, ושם האתר כבר מגיע לגוגל דרך
// og:site_name והנתונים המובנים — ולוותר על מילים מהמשפט לטובתו זה הפסד.
const title = momentTitle(moment.body!);
---

<Base
  title={title}
  description={summary}
  ogImage={ogImage}
  ogType="article"
  compact={true}
  jsonLd={articleJsonLd(Astro.site!, {
    url: pageUrl,
    headline: title,
    description: summary,
    datePublished: moment.data.date,
    image: ogImage,
  })}
>
  <main>
    <article class="moment">
      {/* העמוד מעוצב בכוונה בלי כותרת גלויה — הטקסט עצמו הוא הפתיחה.
          h1 מוסתר חזותית נותן לקורא מסך ולגוגל את הכותרת שהעמוד צריך,
          בלי לשנות דבר במה שרואים. */}
      <h1 class="visually-hidden">{title}</h1>
      <p class="eyebrow">
        <span class="group">{groupLabel(feeling)}</span>
        <a class="label" href={`/moments/${feeling}/`}>{label}</a>
      </p>
      <div class="moment-body">
        <Content />
      </div>
      <span class="end-dot" aria-hidden="true"></span>
    </article>

    <ShareRow title={label} url={pageUrl} shareText={plainText} label="לשלוח את זה למישהו:" />

    <nav class="moment-footer">
      <a href={`/moments/${feeling}/`}>עוד ב{label}</a>
      <a href="/moments/">לכל המצבים</a>
    </nav>
  </main>
</Base>

<style>
  .moment {
    padding-top: 1.5rem;
  }

  .eyebrow {
    text-align: center;
    margin-bottom: 2rem;
  }

  .eyebrow .group {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }

  /* יישור לימין ולא למרכז: טקסט ממורכז על פני כמה שורות קשה לקריאה בטלפון,
     ונוחות הקריאה קודמת לאפקט החזותי. */
  .moment-body {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 2.05;
    max-width: 30rem;
    margin-inline: auto;
  }

  .moment-body :global(p + p) {
    margin-top: 1.5rem;
  }

  .end-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 2.75rem auto 0;
  }

  .moment-footer {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .moment-footer a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
