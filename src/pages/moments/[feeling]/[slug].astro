---
// עמוד של רגע בודד — הכתובת שמשתפים.
// המבנה נגזר מ-docs/MOMENT-FORMAT.md: כותרת → המציאות → המסקנה → הסיבוב →
// קישוט → סיום. העמוד שקט מסביב: בלי תמונה, בלי תאריך, בלי זמן קריאה.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ShareRow from '../../../components/ShareRow.astro';
import MomentBody from '../../../components/MomentBody.astro';
import { feelingLabel, groupLabel, groupOf, type FeelingSlug } from '../../../data/feelings';
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/structured-data';
import { momentTitle } from '../../../lib/moment-title';
import { parseMoment, momentPlainText } from '../../../lib/moment-format';

export async function getStaticPaths() {
  const moments = await getCollection('moments');
  return moments.map((moment) => ({
    params: { feeling: moment.data.feeling, slug: moment.id },
    props: { moment },
  }));
}

const { moment } = Astro.props;
const feeling = moment.data.feeling as FeelingSlug;
const label = feelingLabel(feeling);
const group = groupOf(feeling);

const format = parseMoment(moment.body ?? '', moment.data.title);

// הטקסט כמלל נקי — לתיאור העמוד ולשיתוף בוואטסאפ (הרגע נשלח כמו שהוא).
const plainText = momentPlainText(format);
const flat = plainText.replace(/\s+/g, ' ').trim();
const summary = flat.length > 200 ? `${flat.slice(0, 197)}…` : flat;

// כותרת-הוו כשהיא נכתבה, ואחרת גזירה מהמשפט הראשון (moment-title.ts) —
// כדי שרגע שטרם הוגר לפורמט החדש ימשיך לשאת כותרת ייחודית לגוגל.
const title = format.title ?? momentTitle(moment.body!);

const pageUrl = new URL(`/moments/${feeling}/${moment.id}/`, Astro.site).href;
// תמונת שיתוף ממותגת, נוצרת בזמן הבנייה מהטקסט עצמו (ראו og.png.ts באותה תיקייה).
// חשוב בעיקר לשיתוף בסטטוס, שבו הקישור נעלם והתמונה היא כל מה שנשאר.
const ogImage = new URL(`/moments/${feeling}/${moment.id}/og.png`, Astro.site).href;
---

<Base
  title={title}
  description={summary}
  ogImage={ogImage}
  ogType="article"
  compact={true}
  jsonLd={[
    articleJsonLd(Astro.site!, {
      url: pageUrl,
      headline: title,
      description: summary,
      datePublished: moment.data.date,
      image: ogImage,
    }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'נקודת מבט', path: '/' },
      { name: 'מה עובר עליך', path: '/moments/' },
      ...(group ? [{ name: group.label, path: `/moments/${group.slug}/` }] : []),
      { name: label, path: `/moments/${feeling}/` },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="moment">
      {
        format.title ? (
          /* הכותרת היא הדבר הראשון שהקורא רואה, ושום דבר לא בא לפניה —
             תווית מצב בראש העמוד מפרשת את הקורא לפני שהוא זיהה את עצמו. */
          <header class="moment-head">
            <h1 class="hook">{format.title}</h1>
            <span class="hook-rule" aria-hidden="true" />
          </header>
        ) : (
          /* רגע שטרם הוגר: העיצוב הישן הוא בלי כותרת גלויה, ולכן ה-h1 נשאר
             מוסתר חזותית — נוכח לקורא מסך ולגוגל, בלי לשנות דבר במסך. */
          <h1 class="visually-hidden">{title}</h1>
        )
      }

      <MomentBody format={format} />

      {!format.isNew && <span class="end-dot" aria-hidden="true" />}
    </article>

    <ShareRow title={label} url={pageUrl} label="לשלוח את זה למישהו:" imageUrl={ogImage} />

    <nav class="moment-footer">
      {/* התווית חיה כאן ולא בראש העמוד: כאן היא ניווט והקשר, וזה מה שהיא באמת. */}
      <span class="feeling-tag">
        <span class="group" style={group ? `color: ${group.titleAccent}` : undefined}>
          {groupLabel(feeling)}
        </span>
        <a href={`/moments/${feeling}/`}>עוד ב{label}</a>
      </span>
      <a href="/moments/">לכל המצבים</a>
    </nav>
  </main>
</Base>

<style>
  .moment {
    padding-top: 1rem;
  }

  .moment-head {
    text-align: center;
    margin-bottom: 2.1rem;
  }

  .hook {
    font-size: 2rem;
    line-height: 1.3;
    color: var(--blue);
    margin: 0;
    text-wrap: balance;
  }

  .hook-rule {
    display: block;
    width: 4.5rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.8;
    margin: 1.1rem auto 0;
  }

  .end-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 2.75rem auto 0;
  }

  .moment-footer {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem 1.5rem;
  }

  .moment-footer a {
    text-decoration: none;
    font-weight: 600;
  }

  .feeling-tag .group {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    margin-inline-end: 0.45rem;
  }
</style>
