---
// מדף של מצב אחד — כל הרגעים ששייכים אליו.
// המדף הוא מסנן: הקורא סורק ובוחר איזה מהרגעים הוא שלו (docs/MOMENT-FORMAT.md).
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import MomentBody from '../../../components/MomentBody.astro';
import { FEELING_SLUGS, feelingLabel, groupLabel, type FeelingSlug } from '../../../data/feelings';
import { parseMoment } from '../../../lib/moment-format';

export async function getStaticPaths() {
  const moments = await getCollection('moments');
  // נבנים רק מדפים שיש בהם תוכן — כדי שלא ייווצרו עמודים ריקים.
  return FEELING_SLUGS.filter((feeling) =>
    moments.some((moment) => moment.data.feeling === feeling)
  ).map((feeling) => ({ params: { feeling } }));
}

const feeling = Astro.params.feeling as FeelingSlug;
const label = feelingLabel(feeling);

const moments = (await getCollection('moments', (m) => m.data.feeling === feeling)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
// בפורמט החדש המדף מציג **כותרת + מהלך המציאות בלבד**. עם כותרת-וו אמיתית
// תפקיד המדף משתנה מ"לקרוא כאן" ל"איזה מהשלושה הוא שלי", ומהלך המציאות הוא
// בדיוק המסנן הזה. הסיום אינו מוצג — לא שורפים אותו לפני שהקורא הגיע אליו.
// רגע שטרם הוגר ממשיך להיות מוצג במלואו, בדיוק כפי שהיה.
const cards = moments.map((moment) => ({
  moment,
  format: parseMoment(moment.body ?? '', moment.data.title),
}));
---

<Base title={`${label} · רגע של נקודת מבט`} description={`רגע של נקודת מבט — ${label}`}>
  <main>
    <p class="group-label">{groupLabel(feeling)}</p>
    <h1 class="page-title">{label}</h1>

    <ul class="moment-list">
      {
        cards.map(({ moment, format }) => (
          <li class="moment-card">
            <a class="moment-link" href={`/moments/${feeling}/${moment.id}/`}>
              {format.title && <span class="moment-hook">{format.title}</span>}
              <MomentBody format={format} firstStanzaOnly={format.isNew} />
              <span class="moment-more">
                {format.isNew ? 'לרגע המלא →' : 'לרגע הזה →'}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="page-footer">
      <a href="/moments/">→ לכל המצבים</a>
    </nav>
  </main>
</Base>

<style>
  .group-label {
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.2rem 0 2rem;
  }

  .moment-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .moment-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  .moment-card:hover {
    border-color: var(--gold);
  }

  .moment-link {
    --moment-size: 1.15rem;
    display: block;
    padding: 1.6rem 1.4rem 1.2rem;
    text-decoration: none;
    color: inherit;
  }

  .moment-hook {
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 1.1rem;
    text-wrap: balance;
  }

  .moment-more {
    display: block;
    margin-top: 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
  }

  .page-footer {
    text-align: center;
    margin-top: 2.75rem;
  }

  .page-footer a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
