---
// מדף של מצב אחד — כל הרגעים ששייכים אליו.
// הטקסטים קצרים, ולכן הם מוצגים כאן במלואם: המדף עצמו הוא כבר קריאה, לא רשימת קישורים.
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { FEELING_SLUGS, feelingLabel, groupLabel, type FeelingSlug } from '../../../data/feelings';

export async function getStaticPaths() {
  const moments = await getCollection('moments');
  // נבנים רק מדפים שיש בהם תוכן — כדי שלא ייווצרו עמודים ריקים.
  return FEELING_SLUGS.filter((feeling) =>
    moments.some((moment) => moment.data.feeling === feeling)
  ).map((feeling) => ({ params: { feeling } }));
}

const feeling = Astro.params.feeling as FeelingSlug;
const label = feelingLabel(feeling);

const moments = (await getCollection('moments', (m) => m.data.feeling === feeling)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const rendered = await Promise.all(
  moments.map(async (moment) => ({ moment, Content: (await render(moment)).Content }))
);
---

<Base title={`${label} · רגע של נקודת מבט`} description={`רגע של נקודת מבט — ${label}`}>
  <main>
    <p class="group-label">{groupLabel(feeling)}</p>
    <h1 class="page-title">{label}</h1>

    <ul class="moment-list">
      {
        rendered.map(({ moment, Content }) => (
          <li class="moment-card">
            <a class="moment-link" href={`/moments/${feeling}/${moment.id}/`}>
              <div class="moment-text">
                <Content />
              </div>
              <span class="moment-more">לרגע הזה →</span>
            </a>
          </li>
        ))
      }
    </ul>

    <nav class="page-footer">
      <a href="/moments/">→ לכל המצבים</a>
    </nav>
  </main>
</Base>

<style>
  .group-label {
    text-align: center;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.2rem 0 2rem;
  }

  .moment-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .moment-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  .moment-card:hover {
    border-color: var(--gold);
  }

  .moment-link {
    display: block;
    padding: 1.6rem 1.4rem 1.2rem;
    text-decoration: none;
    color: inherit;
  }

  .moment-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.95;
  }

  .moment-text :global(p + p) {
    margin-top: 1rem;
  }

  .moment-more {
    display: block;
    margin-top: 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
  }

  .page-footer {
    text-align: center;
    margin-top: 2.75rem;
  }

  .page-footer a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
