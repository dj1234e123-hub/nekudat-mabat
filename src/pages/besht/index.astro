---
// שער "מעשה שהיה" (שלב 4.99) – ראו CornerGate.astro.
import '../../styles/corner.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CornerGate from '../../components/CornerGate.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import { newestFirst } from '../../lib/sort';
import { isPublished } from '../../lib/published';
import { readingLabel } from '../../lib/reading-time';
import { monthLabel } from '../../lib/corner';
import { CORNER_COVERS } from '../../data/corner-covers';

const stories = (await getCollection('besht', isPublished)).sort(newestFirst);
const [latest, ...rest] = stories;
const cover = CORNER_COVERS.besht;
// תמונת הזהות של הפינה היא גם התמונה שנפתחת כשמשתפים את השער.
const og = cover ? await getImage({ src: cover.src, width: 1200, format: 'jpeg' }) : undefined;
---

<Base
  ogImage={og && new URL(og.src, Astro.site).href}
  ogImageWidth={og?.attributes.width}
  ogImageHeight={og?.attributes.height}
  title="מעשה שהיה · נקודת מבט"
  description="סיפור של הבעל שם טוב לכל מוצאי שבת – קצר, ובסופו מחשבה אחת."
  altLangHref="/es/asi-sucedio/"
>
  <main>
    <CornerGate
      kind="besht"
      name="מעשה שהיה"
      rhythm={`כל מוצאי שבת · ${stories.length} סיפורים`}
      promise="סיפור אחד של הבעל שם טוב, ומחשבה אחת לשבוע."
      cover={cover && { src: cover.src, alt: cover.alt }}
      featured={{
        href: `/besht/${latest.id}/`,
        kicker: `הסיפור של השבוע · ${latest.data.occasion}`,
        title: latest.data.title,
        text: latest.data.excerpt,
        meta: readingLabel(latest),
        cta: 'לקרוא ←',
      }}
      items={rest.map((s) => ({
        href: `/besht/${s.id}/`,
        small: s.data.occasion,
        title: s.data.title,
        group: monthLabel(s.data.hebrewDate, 'he'),
      }))}
      bridge={{ href: '/mabat-leshabbat/', small: 'וביום שישי', title: 'מבט לשבת: הטור השבועי על הפרשה', image: CORNER_COVERS.mabat?.src }}
    />
    <JoinGroup />
  </main>
</Base>
