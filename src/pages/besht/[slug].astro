---
// עמוד סיפור ב"מעשה שהיה" – אותה תבנית של "מבט לשבת" (שלב 4.99), בזהב:
// תווית, כותרת, שורת הקדמה ושורת כותב; תמונת ההבדלה בתוך השוליים; הסיפור
// באותיות ספר; המחשבה לשבוע; כרטיס כותב; שיתוף; והמשך לגיליון של אותה שבת.
import '../../styles/corner.css';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ShareRow from '../../components/ShareRow.astro';
import CornerHead from '../../components/CornerHead.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import CornerNext from '../../components/CornerNext.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import JoinPopup from '../../components/JoinPopup.astro';
import havdala from '../../assets/besht/havdala.png';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/structured-data';
import { isPublished } from '../../lib/published';
import { newestFirst } from '../../lib/sort';
import { esBeshtPath } from '../../data/es-slugs';
import { readingLabel } from '../../lib/reading-time';
import { kicker } from '../../lib/mabat-format';
import { issueBefore, isThisWeek } from '../../lib/corner';

export async function getStaticPaths() {
  const stories = await getCollection('besht', isPublished);
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const { title, occasion, hebrewDate, date, excerpt, thought } = story.data;

const pageUrl = new URL(`/besht/${story.id}/`, Astro.site).href;
const og = await getImage({ src: havdala, width: 1200, format: 'jpeg' });
const ogImage = new URL(og.src, Astro.site).href;

const all = (await getCollection('besht', isPublished)).sort(newestFirst);
const beshtEs = await getCollection('beshtEs', isPublished);
const hasEsTwin = beshtEs.some((s) => s.id === story.id);
const altLangHref = hasEsTwin ? esBeshtPath(story.id) : '/es/asi-sucedio/';

// ההמשך: הגיליון של אותה שבת (נקרא לפני הסיפור), או האחרון אם אין זוג.
const issues = (await getCollection('mabatLeshabbat', isPublished)).sort(newestFirst);
const paired = issueBefore(story, issues);
const issue = paired ?? issues[0];
const idx = all.findIndex((s) => s.id === story.id);
const prev = all[idx + 1];
const rows = [
  ...(prev ? [{ href: `/besht/${prev.id}/`, small: `הסיפור הקודם · ${prev.data.occasion}`, title: prev.data.title }] : []),
  { href: '/besht/', small: 'כל הסיפורים', title: `${all.length} סיפורים של מעשה שהיה` },
];
---

<Base
  title={`${title} · מעשה שהיה`}
  description={excerpt}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={og.attributes.width}
  ogImageHeight={og.attributes.height}
  compact={true}
  altLangHref={altLangHref}
  altLangTwin={hasEsTwin}
  jsonLd={[
    articleJsonLd(Astro.site!, { url: pageUrl, headline: title, description: excerpt, datePublished: date, image: ogImage }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'נקודת מבט', path: '/' },
      { name: 'מעשה שהיה', path: '/besht/' },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="corner is-besht">
      <CornerHead
        corner="מעשה שהיה"
        cornerHref="/besht/"
        label={`${occasion} · ${hebrewDate}`}
        now={isThisWeek(story, all) ? 'הסיפור של השבוע' : undefined}
        title={title}
        deck={excerpt}
        meta={readingLabel(story)}
      />

      <Image
        src={havdala}
        alt="נר הבדלה קלוע ודולק על מעקה אבן, לצידו גביע כסף וקופסת בשמים, ומאחור נוף ירושלים באור שקיעה"
        widths={[480, 800, 1200]}
        sizes="(max-width: 42rem) 100vw, 42rem"
        class="ca-photo"
      />

      <div class="ca-body">
        <Content />
      </div>

      <div class="ca-close">
        <small>מחשבה לשבוע</small>
        <p>{thought.split('\n').map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
      </div>

      <AuthorCard />
    </article>

    <section class="ca-send">
      <p class="ca-lab">לשלוח הלאה</p>
      <ShareRow title={`${title} · מעשה שהיה`} url={pageUrl} label={`סיפור של ${occasion}:`} />
    </section>

    {
      issue && (
        <CornerNext
          heading="מאותה שבת"
          pair={{
            href: `/mabat-leshabbat/${issue.id}/`,
            kicker: paired ? 'מאותה שבת · מבט לשבת' : 'מבט לשבת · הגיליון האחרון',
            title: issue.data.title,
            quote: issue.data.quoteImageAlt,
            cta: `לגיליון של ${kicker(issue.data.parasha)} ←`,
            color: 'var(--blue)',
          }}
          rows={rows}
        />
      )
    }

    <JoinGroup />
    <JoinPopup />
  </main>
</Base>
