---
// עמוד הכניסה של האזור הספרדי — "מה עובר עליך עכשיו?" בספרדית.
// מצב בלי תוכן מתורגם מוצג באפור ואינו קישור, בדיוק כמו בעברית:
// **מבחר ולא מראה** — האזור מציג רק את מה שקיים בו בפועל.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { FEELING_GROUPS } from '../../../data/feelings';
import { FEELING_LABELS_ES, GROUP_LABELS_ES } from '../../../data/site-es';
import { isPublished } from '../../../lib/published';

const moments = await getCollection('momentsEs', isPublished);
const counts = new Map<string, number>();
for (const m of moments) {
  counts.set(m.data.feeling, (counts.get(m.data.feeling) ?? 0) + 1);
}
const urls = moments.map((m) => `/es/momentos/${m.data.feeling}/${m.id}/`);
---

<Base
  lang="es"
  noindex={true}
  title="Un momento de perspectiva"
  description="Textos breves para lo que estás pasando ahora. Un momento para detenerte."
>
  <main>
    <h1 class="page-title">Un momento de perspectiva</h1>
    <p class="question">¿Qué te está pasando ahora?</p>
    <button id="random-moment" class="unsure" type="button">
      No sé qué estoy sintiendo ahora
    </button>

    {
      FEELING_GROUPS.map((group) => {
        const available = group.feelings.filter((f) => counts.get(f.slug));
        return available.length === 0 ? null : (
          <section class="group">
            <h2 class="group-label">{GROUP_LABELS_ES[group.slug]}</h2>
            <ul class="feelings">
              {available.map((f) => (
                <li>
                  <a class="choice" href={`/es/momentos/${f.slug}/`}>
                    {FEELING_LABELS_ES[f.slug]}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <p class="soon">Más textos, en camino.</p>
  </main>
</Base>

<script is:inline define:vars={{ urls }}>
  document.getElementById('random-moment').addEventListener('click', () => {
    location.href = urls[Math.floor(Math.random() * urls.length)];
  });
</script>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.75rem;
  }

  .question {
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--teal-deep);
    margin-bottom: 0.9rem;
  }

  .unsure {
    display: block;
    min-height: 44px;
    margin: 0 auto 2.5rem;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line);
    cursor: pointer;
  }

  .unsure:hover {
    color: var(--teal);
    text-decoration-color: var(--teal);
  }

  .group {
    margin-bottom: 2.25rem;
  }

  .group-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--secondary);
    text-align: center;
    margin-bottom: 0.85rem;
  }

  .feelings {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .soon {
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 2.5rem;
  }
</style>
