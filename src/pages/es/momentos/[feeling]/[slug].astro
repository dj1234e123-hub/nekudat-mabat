---
// עמוד של רגע בודד בספרדית — הכתובת שמשתפים.
// כמו בעברית: הטקסט, ומסביבו אוויר. בלי תמונה ובלי תאריך. התווית יורדת
// לתחתית (ניווט, לא פרשנות), בצבע הזהות של הקבוצה — עד סוף המסע (4.31).
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import ShareRow from '../../../../components/ShareRow.astro';
import MomentBody from '../../../../components/MomentBody.astro';
import { groupOf, type FeelingSlug } from '../../../../data/feelings';
import { FEELING_LABELS_ES, GROUP_LABELS_ES } from '../../../../data/site-es';
import { articleJsonLd, breadcrumbJsonLd } from '../../../../lib/structured-data';
import { momentTitle } from '../../../../lib/moment-title';
import { parseMoment, momentPlainText } from '../../../../lib/moment-format';
import { isPublished } from '../../../../lib/published';

export async function getStaticPaths() {
  const moments = await getCollection('momentsEs', isPublished);
  return moments.map((moment) => ({
    params: { feeling: moment.data.feeling, slug: moment.id },
    props: { moment },
  }));
}

const { moment } = Astro.props;
const feeling = moment.data.feeling as FeelingSlug;
const label = FEELING_LABELS_ES[feeling];
const group = groupOf(feeling);

const format = parseMoment(moment.body ?? '', moment.data.title);

// הטקסט כמלל נקי — לתיאור העמוד ולשיתוף בוואטסאפ (הרגע נשלח כמו שהוא).
const plainText = momentPlainText(format);
const flat = plainText.replace(/\s+/g, ' ').trim();
const summary = flat.length > 200 ? `${flat.slice(0, 197)}…` : flat;

// כותרת-הוו כשהיא נכתבה, ואחרת גזירה מהמשפט הראשון (moment-title.ts)
const title = format.title ?? momentTitle(moment.body!);

const pageUrl = new URL(`/es/momentos/${feeling}/${moment.id}/`, Astro.site).href;

// תמונת השיתוף של הרגע — נבנית לצד העמוד (og.png.ts), בספרדית בלבד.
const ogImage = new URL(`/es/momentos/${feeling}/${moment.id}/og.png`, Astro.site).href;

// העמוד התאום בעברית — אותו רגע, אותו שם קובץ.
const altLangHref = `/moments/${feeling}/${moment.id}/`;
---

<Base
  lang="es"
  title={title}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  compact={true}
  altLangHref={altLangHref}
  jsonLd={[
    articleJsonLd(Astro.site!, {
      url: pageUrl,
      headline: title,
      description: summary,
      datePublished: moment.data.date,
      image: ogImage,
      inLanguage: 'es',
    }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'Punto de Vista', path: '/es/' },
      { name: 'Qué te está pasando', path: '/es/momentos/' },
      ...(group
        ? [{ name: GROUP_LABELS_ES[group.slug], path: `/es/momentos/${group.slug}/` }]
        : []),
      { name: label, path: `/es/momentos/${feeling}/` },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="moment">
      {
        format.title ? (
          <header class="moment-head">
            <h1 class="hook">{format.title}</h1>
            <span class="hook-rule" aria-hidden="true" />
          </header>
        ) : (
          <h1 class="visually-hidden">{title}</h1>
        )
      }

      <MomentBody format={format} />

      {!format.isNew && <span class="end-dot" aria-hidden="true" />}
    </article>

    {/* כמו בעברית: וואטסאפ משתף את התמונה עצמה כקובץ; בלי תמיכה — קישור נקי. */}
    <ShareRow
      title={title}
      url={pageUrl}
      lang="es"
      label="Envíaselo a alguien:"
      shareText={plainText}
      imageUrl={ogImage}
    />

    <nav class="moment-footer">
      <span class="feeling-tag">
        <span class="group" style={group ? `color: ${group.titleAccent}` : undefined}>
          {group ? GROUP_LABELS_ES[group.slug] : ''}
        </span>
        <a href={`/es/momentos/${feeling}/`}>Más sobre {label.toLowerCase()}</a>
      </span>
      <a href="/es/momentos/">Todos los estados</a>
    </nav>
  </main>
</Base>

<style>
  .moment {
    padding-top: 1rem;
  }

  .moment-head {
    text-align: center;
    margin-bottom: 2.1rem;
  }

  .hook {
    font-size: 2rem;
    line-height: 1.3;
    color: var(--blue);
    margin: 0;
    text-wrap: balance;
  }

  .hook-rule {
    display: block;
    width: 4.5rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.8;
    margin: 1.1rem auto 0;
  }

  .end-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 2.75rem auto 0;
  }

  .moment-footer {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem 1.5rem;
  }

  .moment-footer a {
    text-decoration: none;
    font-weight: 600;
  }

  .feeling-tag .group {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
    margin-inline-end: 0.45rem;
  }
</style>
