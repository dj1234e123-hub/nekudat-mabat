---
// מדף של מצב אחד באזור הספרדי — אותה תצוגה כמו המדף העברי:
// כותרת-וו + מהלך המציאות בלבד. הסיום אינו מוצג — לא שורפים אותו
// לפני שהקורא הגיע אליו (docs/MOMENT-FORMAT.md).
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import MomentBody from '../../../../components/MomentBody.astro';
import { FEELING_LABELS_ES } from '../../../../data/site-es';
import { parseMoment } from '../../../../lib/moment-format';
import { newestFirst } from '../../../../lib/sort';

export async function getStaticPaths() {
  const moments = await getCollection('momentsEs');
  const byFeeling = new Map<string, typeof moments>();
  for (const m of moments) {
    byFeeling.set(m.data.feeling, [...(byFeeling.get(m.data.feeling) ?? []), m]);
  }
  return [...byFeeling].map(([feeling, items]) => ({
    params: { feeling },
    props: { items },
  }));
}

const { items } = Astro.props;
const { feeling } = Astro.params;
const label = FEELING_LABELS_ES[feeling!];

const cards = items
  .sort(newestFirst)
  .map((moment) => ({
    moment,
    format: parseMoment(moment.body ?? '', moment.data.title),
  }));
---

<Base
  lang="es"
  noindex={true}
  title={`${label} · Un momento de perspectiva`}
  description={`Textos breves sobre ${label.toLowerCase()}.`}
>
  <main>
    <p class="eyebrow"><a href="/es/momentos/">Todos los estados</a></p>
    <h1 class="page-title">{label}</h1>

    <ul class="moment-list">
      {
        cards.map(({ moment, format }) => (
          <li class="moment-card">
            <a class="moment-link" href={`/es/momentos/${feeling}/${moment.id}/`}>
              {format.title && <span class="moment-hook">{format.title}</span>}
              <MomentBody format={format} firstStanzaOnly={format.isNew} />
              <span class="moment-more">Al momento completo →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .eyebrow {
    text-align: center;
    font-size: 0.9rem;
  }

  .eyebrow a {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    padding-block: 0.35rem;
  }

  .eyebrow a:hover {
    color: var(--teal);
  }

  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.2rem 0 2rem;
  }

  .moment-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .moment-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  .moment-card:hover {
    border-color: var(--gold);
  }

  .moment-link {
    --moment-size: 1.15rem;
    display: block;
    padding: 1.6rem 1.4rem 1.2rem;
    text-decoration: none;
    color: inherit;
  }

  .moment-hook {
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 1.1rem;
    text-wrap: balance;
  }

  .moment-more {
    display: block;
    margin-top: 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
  }
</style>
