---
// מדף של מצב אחד באזור הספרדי.
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { FEELING_LABELS_ES } from '../../../../data/site-es';

export async function getStaticPaths() {
  const moments = await getCollection('momentsEs');
  const byFeeling = new Map<string, typeof moments>();
  for (const m of moments) {
    byFeeling.set(m.data.feeling, [...(byFeeling.get(m.data.feeling) ?? []), m]);
  }
  return [...byFeeling].map(([feeling, items]) => ({
    params: { feeling },
    props: { items },
  }));
}

const { items } = Astro.props;
const { feeling } = Astro.params;
const label = FEELING_LABELS_ES[feeling!];

const excerpt = (body: string) => {
  const text = body.replace(/\s+/g, ' ').trim();
  return text.length > 130 ? `${text.slice(0, 127)}…` : text;
};
---

<Base
  lang="es"
  noindex={true}
  title={`${label} · Un momento de perspectiva`}
  description={`Textos breves sobre ${label.toLowerCase()}.`}
>
  <main>
    <p class="eyebrow"><a href="/es/momentos/">Todos los estados</a></p>
    <h1 class="page-title">{label}</h1>
    <ul class="list">
      {
        items.map((m) => (
          <li>
            <a href={`/es/momentos/${feeling}/${m.id}/`}>{excerpt(m.body!)}</a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .eyebrow {
    text-align: center;
    font-size: 0.9rem;
  }

  .eyebrow a {
    color: var(--muted);
    text-decoration: none;
  }

  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.35rem 0 1.75rem;
  }

  .list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .list a {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.75;
  }

  .list a:hover {
    border-color: var(--muted);
  }
</style>
