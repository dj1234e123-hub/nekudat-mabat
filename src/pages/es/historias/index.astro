---
// עמוד הסיפורים בספרדית — אותו מבנה כמו /stories/ העברי (שלב 4.27):
// רצועה לכל עולם עם סיפור אמיתי בתוכה, ואחריה הארכיון המלא מהחדש לישן.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import StoryCard from '../../../components/StoryCard.astro';
import JoinGroup from '../../../components/JoinGroup.astro';
import { SECTIONS_META, SECTION_SLUGS } from '../../../data/sections';
import { SECTIONS_ES } from '../../../data/site-es';
import { SECTION_GATE_IMAGES } from '../../../data/section-gate-images';
import { newestFirst } from '../../../lib/sort';

const stories = (await getCollection('storiesEs')).sort(newestFirst);

const featured = stories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);

// עולם בלי סיפורים מתורגמים אינו מוצג — "מבחר ולא מראה".
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const inWorld = stories.filter((s) => s.data.section === slug);
  if (inWorld.length === 0) return null;
  const sample = featured.find((s) => s.data.section === slug) ?? inWorld[0];
  return {
    slug,
    meta,
    metaEs: SECTIONS_ES[slug],
    sample,
    count: inWorld.length,
    gate: SECTION_GATE_IMAGES[slug] ?? null,
  };
}).filter((w) => w !== null);

const countLabel = (n: number) => (n === 1 ? 'una historia' : `${n} historias`);
---

<Base
  lang="es"
  title="Historias · Punto de Vista"
  description="Historias de la vida, parábolas e historias de tzadikim. Cada una termina en un lugar distinto de donde empezó."
  altLangHref="/stories/"
>
  <main>
    <h1 class="page-title">Historias</h1>
    <p class="intro">
      Tres mundos. {stories.length} historias. Cada una termina en un lugar distinto de donde
      empezó.
    </p>

    <ul class="bands">
      {
        worlds.map(({ slug, meta, metaEs, sample, count, gate }) => (
          <li class="band" style={`--accent: ${meta.accent}`}>
            {gate && (
              <a href={`/es/secciones/${slug}/`} class="band-gate" aria-label={metaEs.linkText}>
                <Image
                  src={gate.image}
                  alt=""
                  widths={[480, 960]}
                  sizes="(max-width: 48rem) 100vw, 380px"
                  style={`object-position: ${gate.position}`}
                />
              </a>
            )}
            <div class="band-body">
              <h2 class="band-name">
                <a href={`/es/secciones/${slug}/`}>{metaEs.label}</a>
              </h2>
              <p class="band-line">{metaEs.line}</p>
              <p class="band-sample">
                Por ejemplo: <a href={`/es/historias/${sample.id}/`}>{sample.data.title}</a>
              </p>
              <p class="band-more">
                <span>{countLabel(count)}</span>
                <a href={`/es/secciones/${slug}/`}>{metaEs.linkText} →</a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="all" aria-labelledby="all-label">
      <h2 class="section-label" id="all-label">Todo, de lo más nuevo a lo más viejo</h2>
      <ul class="story-list">
        {stories.map((story) => <StoryCard story={story} lang="es" />)}
      </ul>
    </section>

    <JoinGroup lang="es" />
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.4rem;
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    margin: 0 auto 2.2rem;
    max-width: 26rem;
    line-height: 1.7;
  }

  .bands {
    list-style: none;
    padding: 0;
    margin: 0 0 3.25rem;
    display: grid;
    gap: 1.4rem;
  }

  .band {
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .band-gate {
    display: block;
    line-height: 0;
  }

  .band-gate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .band-body {
    padding: 1rem 1.1rem 1.1rem;
  }

  .band-name {
    font-size: 1.35rem;
    margin: 0;
    line-height: 1.3;
  }

  .band-name a {
    color: var(--accent);
    text-decoration: none;
  }

  .band-name a:hover,
  .band-name a:focus-visible {
    text-decoration: underline;
  }

  .band-line {
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0.35rem 0 0;
  }

  .band-sample {
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .band-sample a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
  }

  .band-sample a:hover,
  .band-sample a:focus-visible {
    text-decoration: underline;
  }

  .band-more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .band-more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .band-more a:hover,
  .band-more a:focus-visible {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .band {
      display: grid;
      grid-template-columns: 22rem 1fr;
      align-items: stretch;
    }

    .band-gate {
      height: 100%;
    }

    .band-gate :global(img) {
      height: 100%;
      aspect-ratio: auto;
    }

    .band-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1.5rem 1.6rem;
    }
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 1.2rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2.6rem;
  }
</style>
