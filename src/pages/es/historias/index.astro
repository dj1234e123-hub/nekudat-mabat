---
// עמוד הסיפורים בספרדית — אותו מבנה כמו /stories/ העברי (שלב 4.27):
// רצועה לכל עולם עם סיפור אמיתי בתוכה, ואחריה הארכיון המלא מהחדש לישן.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import StoryCard from '../../../components/StoryCard.astro';
import JoinGroup from '../../../components/JoinGroup.astro';
import { SECTIONS_META, SECTION_SLUGS } from '../../../data/sections';
import { SECTIONS_ES } from '../../../data/site-es';
import { SECTION_GATE_IMAGES } from '../../../data/section-gate-images';
import { newestFirst } from '../../../lib/sort';
import { isPublished } from '../../../lib/published';
import { readingLabel } from '../../../lib/reading-time';
import { storyOpening } from '../../../lib/story-opening';
import { esStoryPath, esSectionPath } from '../../../data/es-slugs';

const stories = (await getCollection('storiesEs', isPublished)).sort(newestFirst);

const featured = stories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);

// עולם בלי סיפורים מתורגמים אינו מוצג — "מבחר ולא מראה".
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const inWorld = stories.filter((s) => s.data.section === slug);
  if (inWorld.length === 0) return null;
  const sample = featured.find((s) => s.data.section === slug) ?? inWorld[0];
  return {
    slug,
    meta,
    metaEs: SECTIONS_ES[slug],
    sample,
    count: inWorld.length,
    gate: SECTION_GATE_IMAGES[slug] ?? null,
  };
}).filter((w) => w !== null);

const countLabel = (n: number) => (n === 1 ? 'una historia' : `${n} historias`);
---

<Base
  lang="es"
  title="Historias · Punto de Vista"
  description="Parábolas, historias de tzadikim, de mi diario y de la vida. Cada historia termina en un lugar distinto de donde empezó."
  altLangHref="/stories/"
>
  <main>
    <h1 class="page-title">Historias</h1>
    <p class="intro">
      Cuatro mundos. {stories.length} historias. Cada una termina en un lugar distinto de donde
      empezó.
    </p>

    <ul class="bands">
      {
        worlds.map(({ slug, meta, metaEs, sample, count, gate }) => (
          <li class="band" style={`--accent: ${meta.accent}`}>
            {gate && (
              <a href={esSectionPath(slug)} class="band-gate" aria-label={metaEs.linkText}>
                <Image
                  src={gate.image}
                  alt=""
                  widths={[360, 720]}
                  sizes="(max-width: 48rem) 50vw, 330px"
                  style={`object-position: ${gate.position}`}
                />
              </a>
            )}
            <div class="band-body">
              <h2 class="band-name">
                <a href={esSectionPath(slug)}>{metaEs.label}</a>
              </h2>
              <p class="band-line">{metaEs.line}</p>
              {/* הפיתוי: שאלה שהסיפור עונה עליה (hook), ומתחתיה השם וזמן הקריאה.
                  בלי hook — שתי שורות הפתיחה, כמו בכרטיס "הסיפור הבא". */}
              <a href={esStoryPath(sample.id)} class="band-sample">
                <span class="band-hook">{sample.data.hook ?? storyOpening(sample.body)}</span>
                <span class="band-story">
                  {sample.data.title} · <span class="nowrap">{readingLabel(sample, "es")}</span> →
                </span>
              </a>
              <p class="band-more">
                <span>{countLabel(count)}</span>
                <a href={esSectionPath(slug)}>{metaEs.linkText} →</a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="all" aria-labelledby="all-label">
      <h2 class="section-label" id="all-label">Todo, de lo más nuevo a lo más viejo</h2>
      <ul class="story-list">
        {stories.map((story) => <StoryCard story={story} lang="es" />)}
      </ul>
    </section>

    <JoinGroup lang="es" />
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.4rem;
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    margin: 0 auto 1.5rem;
    max-width: 26rem;
    line-height: 1.7;
  }

  /* ── כרטיסי העולמות — רשת 2×2 (2026-09-16) ──
     קודם ארבע רצועות ברוחב מלא, ~370px כל אחת בטלפון: הקורא ראה רצועה
     וחצי בכל פעם, והעולם הרביעי חיכה 1,500px למטה. "ארבעה עולמות. בחר
     מאיפה להתחיל" מחייב לראות את הארבעה יחד — עכשיו כולם במסך הראשון.
     מלבנים ולא קשתות, בכוונה (החלטת 4.27): הקשת שייכת לרגעים. שני עמודי
     הכניסה חולקים את העיקרון (כל הדלתות במסך אחד), לא את הצורה.
     כל מה שהיה ברצועה נשאר בכרטיס: צילום, קו הצבע, שם, שורת ההסבר,
     "למשל: סיפור אמיתי" ומספר הסיפורים. */
  .bands {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .band {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  /* התמונה היא הדלת — לחיצה עליה נכנסת לעולם */
  .band-gate {
    display: block;
    line-height: 0;
  }

  .band-gate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* 16:9 בטלפון — כדי ששתי השורות ייכנסו למסך הראשון; 3:2 במסך רחב */
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .band-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.65rem 0.8rem 0.6rem;
  }

  .band-name {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.25;
  }

  .band-name a {
    color: var(--accent);
    text-decoration: none;
  }

  .band-name a:hover,
  .band-name a:focus-visible {
    text-decoration: underline;
  }

  /* בטלפון הכרטיס צר, והשאלה היא הטעימה של העולם — שורת ההסבר המופשטת
     מוצגת רק ממסך רחב (והיא חיה גם בדף הבית ובתיאור המטא של עמוד העולם). */
  .band-line {
    display: none;
    color: var(--secondary);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0.3rem 0 0;
  }

  /* הסיבה להיכנס: שאלה שהסיפור עונה עליה, ולא שם. שם מושך רק את מי
     שכבר יודע מה מאחוריו; שאלה נלבשת על הקורא לפני שהוא יודע מי הגיבור.
     בפונט הכותרות בכחול — הסימן הקבוע באתר ל"פה מתחילה מחשבה" (כותרת-הוו
     של רגע). נדחף לתחתית הכרטיס כדי ששני כרטיסים בשורה יישרו קו. */
  .band-sample {
    display: block;
    margin: auto 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .band-hook {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.35;
    color: var(--blue);
    text-wrap: balance;
  }

  .band-story {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .band-sample:hover .band-hook,
  .band-sample:focus-visible .band-hook {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nowrap {
    white-space: nowrap;
  }

  .band-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 0.6rem;
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .band-more a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .band-more a:hover,
  .band-more a:focus-visible {
    text-decoration: underline;
  }

  /* במסך רחב הכרטיסים רחבים כפליים — הטקסט חוזר לגודלו הרגיל */
  @media (min-width: 34rem) {
    .bands {
      gap: 1.25rem;
    }

    .band-gate :global(img) {
      aspect-ratio: 3 / 2;
    }

    .band-body {
      padding: 0.9rem 1.1rem 0.8rem;
    }

    .band-name {
      font-size: 1.3rem;
    }

    .band-line {
      display: block;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .band-more,
    .band-story {
      font-size: 0.85rem;
    }

    .band-hook {
      font-size: 1.15rem;
    }
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 1.2rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.35rem;
  }
</style>
