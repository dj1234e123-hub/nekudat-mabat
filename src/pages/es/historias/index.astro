---
// עמוד הסיפורים בספרדית – אותו עיצוב ואותו מבנה כמו /stories/ העברי (2026-11-02).
// הנושאים והתגיות נלקחים מהתאום העברי (אותו שם קובץ), כי התגיות חיות שם.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import JoinGroup from '../../../components/JoinGroup.astro';
import StoriesIndexBody from '../../../components/StoriesIndexBody.astro';
import { newestFirst } from '../../../lib/sort';
import { isPublished } from '../../../lib/published';

const stories = (await getCollection('storiesEs', isPublished)).sort(newestFirst);
const heStories = await getCollection('stories');
const tagsById = Object.fromEntries(
  stories.map((s) => [s.id, heStories.find((h) => h.id === s.id)?.data.tags ?? []])
);
---

<Base
  lang="es"
  title="Historias · Punto de Vista"
  description="Parábolas, historias de tzadikim, de mi diario y de la vida. Cada historia termina en un lugar distinto de donde empezó."
  altLangHref="/stories/"
>
  <main>
    <StoriesIndexBody stories={stories} lang="es" {tagsById} />
    <JoinGroup lang="es" />
  </main>
</Base>

<style>
  main {
    max-width: 68rem;
  }
</style>
