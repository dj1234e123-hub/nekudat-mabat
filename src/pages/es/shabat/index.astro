---
// Portada de "Mirada de Shabat" (שלב 4.99) – ראו CornerGate.astro.
import '../../../styles/corner.css';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CornerGate from '../../../components/CornerGate.astro';
import JoinGroup from '../../../components/JoinGroup.astro';
import havdala from '../../../assets/besht/havdala.png';
import { MABAT_ES, BESHT_ES } from '../../../data/site-es';
import { newestFirst } from '../../../lib/sort';
import { parseBody, plainText, kickerEs } from '../../../lib/mabat-format';
import { isPublished } from '../../../lib/published';
import { readingLabel } from '../../../lib/reading-time';
import { monthLabel } from '../../../lib/corner';
import { CORNER_COVERS } from '../../../data/corner-covers';

const pieces = (await getCollection('mabatEs', isPublished)).sort(newestFirst);
const [latest, ...rest] = pieces;
const label = (p: string) => kickerEs(p, MABAT_ES.parashaPrefix);
const latestText = (() => {
  if (latest.data.description) return latest.data.description;
  const flat = plainText(parseBody(latest.body ?? '')).replace(/\s+/g, ' ').trim();
  return flat.length > 180 ? `${flat.slice(0, 177)}…` : flat;
})();
const cover = CORNER_COVERS.mabat;
---

<Base
  lang="es"
  title={`${MABAT_ES.name} · Punto de Vista`}
  description="Una columna semanal: una historia real, la parashá de la semana y una pregunta para Shabat."
  altLangHref="/mabat-leshabbat/"
>
  <main>
    <CornerGate
      lang="es"
      kind="mabat"
      name={MABAT_ES.name}
      rhythm={`Cada viernes por la mañana · ${pieces.length} ediciones`}
      promise="Una historia real, la parashá de la semana y una pregunta para Shabat."
      cover={cover && { src: cover.src, alt: cover.altEs }}
      featured={{
        href: `/es/shabat/${latest.id}/`,
        kicker: `La edición de esta semana · ${label(latest.data.parasha)}`,
        title: latest.data.title,
        text: latestText,
        meta: readingLabel({ body: latest.body, data: {} }, 'es'),
        cta: 'Leer →',
      }}
      items={rest.map((p) => ({
        href: `/es/shabat/${p.id}/`,
        small: `${label(p.data.parasha)} · ${p.data.hebrewDate}`,
        title: p.data.title,
        group: monthLabel(p.data.hebrewDate, 'es'),
      }))}
      bridge={{ href: '/es/asi-sucedio/', small: 'Y al terminar Shabat', title: `${BESHT_ES.name}: una historia del Baal Shem Tov`, image: havdala }}
    />
    <JoinGroup lang="es" />
  </main>
</Base>
