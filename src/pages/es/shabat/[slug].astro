---
// עמוד גיליון "מבט לשבת" בספרדית — אותו עיצוב "החתימה השקטה" כמו העברי:
// רייל כחול, תווית, גוף עם מפרידים שקטים, חתימת שבת.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ShareRow from '../../../components/ShareRow.astro';
import MabatBody from '../../../components/MabatBody.astro';
import { MABAT_ES } from '../../../data/site-es';
import { parseBody, plainText } from '../../../lib/mabat-format';
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/structured-data';
import { isPublished } from '../../../lib/published';

export async function getStaticPaths() {
  const pieces = await getCollection('mabatEs', isPublished);
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { title, parasha, hebrewDate, date, signoff, signedBy, quoteImage, quoteImageAlt } = piece.data;
const blocks = parseBody(piece.body ?? '');

const flat = plainText(blocks).replace(/\s+/g, ' ').trim();
const summary = flat.length > 200 ? `${flat.slice(0, 197)}…` : flat;

const pageUrl = new URL(`/es/shabat/${piece.id}/`, Astro.site).href;
const shareText = `${plainText(blocks)}\n\n${pageUrl}`;
---

<Base
  lang="es"
  title={`${title} · ${MABAT_ES.name}`}
  description={summary}
  ogType="article"
  compact={true}
  altLangHref={`/mabat-leshabbat/${piece.id}/`}
  jsonLd={[
    articleJsonLd(Astro.site!, {
      url: pageUrl,
      headline: title,
      description: summary,
      datePublished: date,
      inLanguage: 'es',
    }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'Punto de Vista', path: '/es/' },
      { name: MABAT_ES.name, path: '/es/shabat/' },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="mabat">
      <header class="mabat-head">
        <span class="rail" aria-hidden="true"></span>
        <div class="head-text">
          <p class="kicker-main">{MABAT_ES.name}</p>
          <p class="kicker-sub">{MABAT_ES.parashaPrefix} {parasha} · {hebrewDate}</p>
          <h1>{title}</h1>
        </div>
      </header>

      <MabatBody blocks={blocks} />

      {
        quoteImage && (
          <div class="quote-image">
            <Image src={quoteImage} alt={quoteImageAlt!} widths={[320, 480, 640]} sizes="(max-width: 30rem) 70vw, 320px" />
          </div>
        )
      }

      <div class="close-mark" aria-hidden="true"><span></span></div>

      <div class="signoff">
        <p set:html={signoff.trim().replace(/\n/g, '<br />')} />
        <p class="sig">{signedBy}</p>
      </div>
    </article>

    <ShareRow
      title={`${title} · ${MABAT_ES.name}`}
      url={pageUrl}
      lang="es"
      shareText={shareText}
      label="Envíaselo a alguien:"
    />

    <nav class="mabat-footer">
      <a href="/es/shabat/">Todas las ediciones de {MABAT_ES.name}</a>
    </nav>
  </main>
</Base>

<style>
  .mabat {
    padding-top: 0.5rem;
  }

  .mabat-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 2.2rem;
  }

  .rail {
    width: 3px;
    align-self: stretch;
    min-height: 5.6rem;
    background: var(--blue);
    border-radius: 2px;
    flex: 0 0 auto;
  }

  .head-text {
    flex: 1;
  }

  .kicker-main {
    color: var(--blue);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    font-weight: 700;
    margin: 0 0 0.35rem;
  }

  .kicker-sub {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0 0 1rem;
  }

  .mabat-head h1 {
    font-size: 1.7rem;
    line-height: 1.42;
    margin: 0;
    text-wrap: balance;
  }

  .quote-image {
    display: flex;
    justify-content: center;
    margin: 2.6rem 0 0.4rem;
  }

  .quote-image :global(img) {
    width: 100%;
    max-width: 15rem;
    height: auto;
    border-radius: 3px;
    box-shadow: var(--shadow);
  }

  .close-mark {
    display: flex;
    justify-content: center;
    margin: 2.3rem 0 1.6rem;
  }

  .close-mark span {
    width: 3px;
    height: 16px;
    border-radius: 2px;
    background: var(--blue);
    opacity: 0.55;
  }

  .signoff {
    text-align: center;
    margin: 0 0 0.5rem;
  }

  .signoff p {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 500;
  }

  .signoff .sig {
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 0;
  }

  .mabat-footer {
    text-align: center;
    margin-top: 2.5rem;
  }

  .mabat-footer a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
