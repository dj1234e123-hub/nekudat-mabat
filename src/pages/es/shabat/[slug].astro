---
// "Mirada de Shabat" – la misma plantilla que el hebreo (שלב 4.99): תווית,
// כותרת, הקדמה ושורת כותב; גוף באותיות ספר; השאלה לשבת; כרטיס כותב; שליחת
// תמונת הציטוט; והמשך לסיפור של מוצאי אותה שבת.
import '../../../styles/corner.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import MabatBody from '../../../components/MabatBody.astro';
import CornerHead from '../../../components/CornerHead.astro';
import AuthorCard from '../../../components/AuthorCard.astro';
import QuoteShare from '../../../components/QuoteShare.astro';
import CornerNext from '../../../components/CornerNext.astro';
import havdala from '../../../assets/besht/havdala.png';
import { MABAT_ES, BESHT_ES } from '../../../data/site-es';
import { esBeshtPath } from '../../../data/es-slugs';
import { parseBody, plainText, kickerEs } from '../../../lib/mabat-format';
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/structured-data';
import { isPublished } from '../../../lib/published';
import { newestFirst } from '../../../lib/sort';
import { readingLabel } from '../../../lib/reading-time';
import { storyAfter, isThisWeek } from '../../../lib/corner';
import JoinGroup from '../../../components/JoinGroup.astro';
import JoinPopup from '../../../components/JoinPopup.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('mabatEs', isPublished);
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { title, parasha, hebrewDate, date, signoff, quoteImage, quoteImageAlt, description } = piece.data;
const blocks = parseBody(piece.body ?? '');
const flat = plainText(blocks).replace(/\s+/g, ' ').trim();
const derived = flat.length > 200 ? `${flat.slice(0, 197)}…` : flat;
const summary = description ?? derived;
const pageUrl = new URL(`/es/shabat/${piece.id}/`, Astro.site).href;

let ogImage: string | undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;
if (quoteImage) {
  const og = await getImage({ src: quoteImage, width: 1080, format: 'png' });
  ogImage = new URL(og.src, Astro.site).href;
  ogImageWidth = og.attributes.width;
  ogImageHeight = og.attributes.height;
}

const label = (p: string) => kickerEs(p, MABAT_ES.parashaPrefix);
const issues = (await getCollection('mabatEs', isPublished)).sort(newestFirst);
const stories = (await getCollection('beshtEs', isPublished)).sort(newestFirst);
const paired = storyAfter(piece, stories);
const story = paired ?? stories[0];
const idx = issues.findIndex((p) => p.id === piece.id);
const prev = issues[idx + 1];
const sameParasha = issues.filter((p) => p.id !== piece.id && p.data.parasha === parasha);
const rows = [
  ...sameParasha.map((p) => ({ href: `/es/shabat/${p.id}/`, small: `Más sobre ${label(parasha)} · ${p.data.hebrewDate}`, title: p.data.title })),
  ...(prev ? [{ href: `/es/shabat/${prev.id}/`, small: `La edición anterior · ${label(prev.data.parasha)}`, title: prev.data.title }] : []),
  { href: '/es/shabat/', small: 'Todas las ediciones', title: `${issues.length} ediciones de ${MABAT_ES.name}` },
];
---

<Base
  lang="es"
  title={`${title} · ${MABAT_ES.name}`}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  compact={true}
  altLangHref={`/mabat-leshabbat/${piece.id}/`}
  jsonLd={[
    articleJsonLd(Astro.site!, { url: pageUrl, headline: title, description: summary, datePublished: date, image: ogImage, inLanguage: 'es' }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'Punto de Vista', path: '/es/' },
      { name: MABAT_ES.name, path: '/es/shabat/' },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="corner is-mabat">
      <CornerHead
        lang="es"
        corner={MABAT_ES.name}
        cornerHref="/es/shabat/"
        label={`${label(parasha)} · ${hebrewDate}`}
        now={isThisWeek(piece, issues) ? 'La edición de esta semana' : undefined}
        title={title}
        deck={description}
        meta={readingLabel({ body: piece.body, data: {} }, 'es')}
      />

      <MabatBody blocks={blocks} pullQuote={quoteImageAlt} closingLabel="La pregunta para Shabat" />

      <div class="ca-signoff">
        <p set:html={signoff.trim().replace(/\n/g, '<br />')} />
      </div>

      <AuthorCard lang="es" />
    </article>

    <QuoteShare lang="es" image={quoteImage} imageAlt={quoteImageAlt} imageUrl={ogImage} title={`${title} · ${MABAT_ES.name}`} url={pageUrl} />

    {
      story && (
        <CornerNext
          lang="es"
          heading="El Shabat sigue"
          pair={{
            href: esBeshtPath(story.id),
            kicker: paired ? `Al terminar este Shabat · ${BESHT_ES.name}` : `${BESHT_ES.name} · la historia más reciente`,
            title: story.data.title,
            text: story.data.excerpt,
            cta: 'Leer la historia →',
            image: havdala,
            color: 'var(--gold-deep)',
          }}
          rows={rows}
        />
      )
    }

    <JoinGroup lang="es" />
    <JoinPopup lang="es" />
  </main>
</Base>
