---
// Portada de "Así sucedió" (שלב 4.99) – ראו CornerGate.astro.
import '../../../styles/corner.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import CornerGate from '../../../components/CornerGate.astro';
import JoinGroup from '../../../components/JoinGroup.astro';
import { BESHT_ES, MABAT_ES } from '../../../data/site-es';
import { esBeshtPath } from '../../../data/es-slugs';
import { newestFirst } from '../../../lib/sort';
import { isPublished } from '../../../lib/published';
import { readingLabel } from '../../../lib/reading-time';
import { monthLabel } from '../../../lib/corner';
import { CORNER_COVERS } from '../../../data/corner-covers';

const stories = (await getCollection('beshtEs', isPublished)).sort(newestFirst);
const [latest, ...rest] = stories;
const cover = CORNER_COVERS.besht;
// תמונת הזהות של הפינה היא גם התמונה שנפתחת כשמשתפים את השער.
const og = cover ? await getImage({ src: cover.src, width: 1200, format: 'jpeg' }) : undefined;
---

<Base
  lang="es"
  ogImage={og && new URL(og.src, Astro.site).href}
  ogImageWidth={og?.attributes.width}
  ogImageHeight={og?.attributes.height}
  title={`${BESHT_ES.name} · Punto de Vista`}
  description="Una historia del Baal Shem Tov para cada Motzaei Shabat: corta, y con un pensamiento al final."
  altLangHref="/besht/"
>
  <main>
    <CornerGate
      lang="es"
      kind="besht"
      name={BESHT_ES.name}
      rhythm={`Cada sábado por la noche · ${stories.length} historias`}
      promise="Una historia del Baal Shem Tov y un pensamiento para la semana."
      cover={cover && { src: cover.src, alt: cover.altEs }}
      featured={{
        href: esBeshtPath(latest.id),
        kicker: `La historia de esta semana · ${latest.data.occasion}`,
        title: latest.data.title,
        text: latest.data.excerpt,
        meta: readingLabel(latest, 'es'),
        cta: 'Leer →',
      }}
      items={rest.map((s) => ({
        href: esBeshtPath(s.id),
        small: s.data.occasion,
        title: s.data.title,
        group: monthLabel(s.data.hebrewDate, 'es'),
      }))}
      bridge={{ href: '/es/shabat/', small: 'Y el viernes', title: `${MABAT_ES.name}: la columna semanal sobre la parashá`, image: CORNER_COVERS.mabat?.src }}
    />
    <JoinGroup lang="es" />
  </main>
</Base>
