---
// עמוד הכניסה ל"מעשה שהיה" בספרדית — "Así sucedió". אותו מבנה בדיוק
// כמו /besht/, בשפה אחרת. "Así sucedió" נבחר לפי הפונקציה של הביטוי
// העברי (פתיחת סיפור חסידי קלאסית) ולא תרגום מילולי.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { newestFirst } from '../../../lib/sort';
import { isPublished } from '../../../lib/published';
import { formatDate } from '../../../utils/format-date';
import { BESHT_NAME_ES, BESHT_SEGULA_ES, BESHT_DESCRIPTION_ES } from '../../../data/besht-es';
import beshtIdentityEs from '../../../assets/besht/og-identity-es.png';

const items = (await getCollection('beshtEs', isPublished)).sort(newestFirst);

const og = await getImage({ src: beshtIdentityEs, width: 1080, format: 'png' });
const ogImage = new URL(og.src, Astro.site).href;
---

<Base
  lang="es"
  title={`${BESHT_NAME_ES} · Punto de Vista`}
  description={BESHT_DESCRIPTION_ES}
  ogImage={ogImage}
  ogImageWidth={og.attributes.width}
  ogImageHeight={og.attributes.height}
  altLangHref="/besht/"
>
  <main>
    <h1 class="page-title">{BESHT_NAME_ES}</h1>
    <p class="intro">{BESHT_SEGULA_ES}</p>

    <ul class="issues">
      {
        items.map((item) => (
          <li class="issue">
            <a class="issue-link" href={`/es/asi-sucedio/${item.id}/`}>
              <p class="issue-occasion">
                {item.data.parasha} · {item.data.hebrewDate}
              </p>
              <p class="issue-kicker">
                <time datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate(item.data.date, 'es')}</time>
              </p>
              <h2>{item.data.title}</h2>
              <p class="issue-excerpt">{item.data.excerpt}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.5rem;
    color: var(--teal);
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    max-width: 30rem;
    margin: 0 auto 2.2rem;
    line-height: 1.75;
  }

  .issues {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .issue {
    border-inline-start: 3px solid var(--teal);
    border-radius: 4px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .issue-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.1rem 1.3rem;
  }

  .issue-occasion {
    color: var(--teal);
    font-size: 0.82rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .issue-kicker {
    color: var(--muted);
    font-size: 0.82rem;
    margin: 0 0 0.4rem;
  }

  .issue h2 {
    font-size: 1.25rem;
    line-height: 1.4;
    margin: 0 0 0.5rem;
    transition: color 0.15s ease;
  }

  .issue-link:hover h2 {
    color: var(--teal);
  }

  .issue-excerpt {
    color: var(--secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }
</style>
