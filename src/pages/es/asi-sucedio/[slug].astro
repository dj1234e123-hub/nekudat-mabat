---
// "Así sucedió" – la misma plantilla que "Mirada de Shabat" (שלב 4.99), en dorado.
import '../../../styles/corner.css';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ShareRow from '../../../components/ShareRow.astro';
import CornerHead from '../../../components/CornerHead.astro';
import AuthorCard from '../../../components/AuthorCard.astro';
import CornerNext from '../../../components/CornerNext.astro';
import JoinGroup from '../../../components/JoinGroup.astro';
import JoinPopup from '../../../components/JoinPopup.astro';
import havdala from '../../../assets/besht/havdala.png';
import { BESHT_ES, MABAT_ES } from '../../../data/site-es';
import { esBeshtPath, ES_BESHT_SLUGS } from '../../../data/es-slugs';
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/structured-data';
import { isPublished } from '../../../lib/published';
import { newestFirst } from '../../../lib/sort';
import { readingLabel } from '../../../lib/reading-time';
import { cornerViewsOf } from '../../../lib/story-meta';
import { kickerEs } from '../../../lib/mabat-format';
import { issueBefore, isThisWeek } from '../../../lib/corner';

export async function getStaticPaths() {
  const stories = await getCollection('beshtEs', isPublished);
  return stories.map((story) => ({ params: { slug: ES_BESHT_SLUGS[story.id] ?? esBeshtPath(story.id) }, props: { story } }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const { title, occasion, hebrewDate, date, excerpt, thought } = story.data;

const pageUrl = new URL(esBeshtPath(story.id), Astro.site).href;
const og = await getImage({ src: havdala, width: 1200, format: 'jpeg' });
const ogImage = new URL(og.src, Astro.site).href;
const all = (await getCollection('beshtEs', isPublished)).sort(newestFirst);

const issues = (await getCollection('mabatEs', isPublished)).sort(newestFirst);
const paired = issueBefore(story, issues);
const issue = paired ?? issues[0];
const idx = all.findIndex((s) => s.id === story.id);
const prev = all[idx + 1];
const rows = [
  ...(prev ? [{ href: esBeshtPath(prev.id), small: `La historia anterior · ${prev.data.occasion}`, title: prev.data.title, views: cornerViewsOf('besht', prev.id) }] : []),
  { href: '/es/asi-sucedio/', small: 'Todas las historias', title: `${all.length} historias de ${BESHT_ES.name}` },
];
---

<Base
  lang="es"
  title={`${title} · ${BESHT_ES.name}`}
  description={excerpt}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={og.attributes.width}
  ogImageHeight={og.attributes.height}
  compact={true}
  altLangHref={`/besht/${story.id}/`}
  jsonLd={[
    articleJsonLd(Astro.site!, { url: pageUrl, headline: title, description: excerpt, datePublished: date, image: ogImage, inLanguage: 'es' }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'Punto de Vista', path: '/es/' },
      { name: BESHT_ES.name, path: '/es/asi-sucedio/' },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="corner is-besht">
      <CornerHead
        lang="es"
        corner={BESHT_ES.name}
        cornerHref="/es/asi-sucedio/"
        label={`${occasion} · ${hebrewDate}`}
        now={isThisWeek(story, all) ? 'La historia de esta semana' : undefined}
        title={title}
        deck={excerpt}
        meta={readingLabel(story, 'es')}
        views={cornerViewsOf('besht', story.id)}
      />

      <Image
        src={havdala}
        alt="Una vela trenzada de Havdalá encendida sobre un muro de piedra, junto a una copa de plata y una cajita de especias, con Jerusalén al atardecer de fondo"
        widths={[480, 800, 1200]}
        sizes="(max-width: 42rem) 100vw, 42rem"
        class="ca-photo"
      />

      <div class="ca-body">
        <Content />
      </div>

      <div class="ca-close">
        <small>Un pensamiento para la semana</small>
        <p>{thought.split('\n').map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>
      </div>

      <AuthorCard lang="es" />
    </article>

    <section class="ca-send">
      <p class="ca-lab">Envíalo a alguien</p>
      <ShareRow title={`${title} · ${BESHT_ES.name}`} url={pageUrl} lang="es" label={`Una historia para ${occasion}:`} />
    </section>

    {
      issue && (
        <CornerNext
          lang="es"
          heading="Del mismo Shabat"
          pair={{
            href: `/es/shabat/${issue.id}/`,
            kicker: paired ? `Del mismo Shabat · ${MABAT_ES.name}` : `${MABAT_ES.name} · la edición más reciente`,
            title: issue.data.title,
            quote: issue.data.quoteImageAlt,
            cta: 'Leer la edición →',
            color: 'var(--blue)',
          }}
          rows={rows}
        />
      )
    }

    <JoinGroup lang="es" />
    <JoinPopup lang="es" />
  </main>
</Base>
