---
// עמוד מי אני בספרדית – אותו מבנה כמו העברי (שלב 4.105): תמונה אחת, שם ושורת
// זהות, ארבעה בלוקים קצרים, פעולה אחת, "Creo en ti,", גבולות. בלי מכתב ובלי כתב יד.
//
// שתי התאמות מחויבות מהחלטות מתועדות, כמו קודם:
//   1. אין הזמנה לשיחה אישית – בעל הפרויקט אינו מאמן בספרדית, והזמנה שאי אפשר
//      לקיים מייצרת רושם של מי שלא עונה. הפעולה היא הרגעים, והעמוד אומר במפורש
//      שהליווי בעברית.
//   2. כרטיס ההצטרפות הוא של הקבוצה הספרדית (JoinGroup במצב es).
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_ES } from '../../data/site-es';
import portrait from '../../assets/efraim-portrait.jpg';
import JoinGroup from '../../components/JoinGroup.astro';
import { isPublished } from '../../lib/published';
import { esStoryPath } from '../../data/es-slugs';

// תמונת השיתוף היא הפנים ולא הלוגו – כמו בעברית.
const portraitOg = await getImage({ src: portrait, width: 765, format: 'jpeg' });
const ogImage = new URL(portraitOg.src, Astro.site).href;

const stories = await getCollection('storiesEs', isPublished);
const storyUrls = stories.map((s) => esStoryPath(s.id));

const DESCRIPTION =
  'Efraim Atia: escribo historias y acompaño a muchachos. Quién soy, cómo trabajo y por dónde empezar.';
---

<Base
  lang="es"
  title="Quién soy – Efraim Atia · Punto de Vista"
  description={DESCRIPTION}
  ogImage={ogImage}
  ogImageWidth={portraitOg.attributes.width}
  ogImageHeight={portraitOg.attributes.height}
  altLangHref="/about/"
>
  <main>
    <article class="about">
      <h1 class="visually-hidden">Quién soy</h1>

      <Image
        class="portrait"
        src={portrait}
        alt="Efraim Atia con traje oscuro y kipá, sonriendo"
        widths={[360, 540, 720]}
        sizes="(min-width: 40rem) 30rem, 90vw"
        loading="eager"
      />

      <p class="name">{SITE_ES.ownerName}</p>
      <p class="role">Escribo historias. Acompaño a muchachos.</p>

      <p class="lead">
        Acompaño a muchachos que se sienten atascados, confundidos, o cuyo camino se alejó de lo
        que pensaban que serían.
      </p>

      <section class="block">
        <h2>Qué pasa en las conversaciones</h2>
        <p>
          Entendemos qué te pasa de verdad y qué te frena, y encontramos un paso pequeño hacia
          adelante. No decido por ti qué es lo correcto. Las conversaciones son en hebreo.
        </p>
      </section>

      <section class="block">
        <h2>Por qué yo</h2>
        <p>
          Pasé yo mismo por épocas difíciles. Hubo momentos en que me sentía atascado y no tenía
          con quién hablar de eso. Por eso sé escuchar sin juzgar.
        </p>
      </section>

      <section class="block">
        <h2>Y qué es este sitio</h2>
        <p>
          Historias y momentos breves que escribo yo mismo, para quien necesita detenerse. Se puede
          simplemente leer.
        </p>
      </section>

      <section class="block">
        <h2>Formación</h2>
        <p>NLP nivel Master, primeros auxilios emocionales y un curso de 12 pasos.</p>
      </section>

      <a class="cta" href="/es/momentos/">Un momento de Punto de Vista</a>
      <p class="note">Escribo en hebreo, y ahí nace este sitio. Aquí lees una selección traducida.</p>
      <p class="sign">Creo en ti,</p>

      {
        storyUrls.length > 0 && (
          <button id="start-story" class="start-story" type="button" data-ph="random_story">
            ¿No sabes por dónde empezar? Lee una historia
          </button>
        )
      }

      <p class="limits">
        Es acompañamiento personal, no terapia. Cuando hace falta un profesional, te lo digo y te
        oriento.
      </p>
    </article>

    <JoinGroup lang="es" />

    <script is:inline define:vars={{ storyUrls }}>
      var btn = document.getElementById('start-story');
      if (btn) {
        btn.addEventListener('click', function () {
          var read = [];
          try {
            read = JSON.parse(localStorage.getItem('nm_read') || '[]');
          } catch (e) {}
          var unread = storyUrls.filter(function (u) {
            return read.indexOf(u.split('/')[3]) === -1;
          });
          var pool = unread.length > 0 ? unread : storyUrls;
          location.href = pool[Math.floor(Math.random() * pool.length)];
        });
      }
    </script>
  </main>
</Base>

<style>
  .about {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.4rem 2.2rem;
    margin-top: 0.5rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  .portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 1.4rem;
  }
  /* מחשב: הדיוקן לא תופס מסך שלם (ב-4:5 הוא 620px גובה); הפנים נשארות בחתך */
  @media (min-width: 52rem) {
    .portrait {
      aspect-ratio: 4 / 3;
      object-position: 50% 0%;
    }
  }

  .name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1.15;
    font-weight: 500;
    color: var(--ink);
  }

  .role {
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .lead {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
    margin-top: 1.5rem;
    text-wrap: balance;
  }

  .block {
    margin-top: 1.4rem;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .block h2 {
    font-family: var(--font-body);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--gold-deep);
    margin-bottom: 0.15rem;
  }

  .about .cta {
    display: block;
    text-align: center;
    margin-top: 1.6rem;
  }

  .note {
    color: var(--secondary);
    font-size: 0.92rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .sign {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-align: center;
    margin-top: 1.1rem;
  }

  .start-story {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 0.9rem auto 0;
    padding: 0 0.5rem;
    background: none;
    border: 0;
    font: inherit;
    color: var(--teal);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .limits {
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
