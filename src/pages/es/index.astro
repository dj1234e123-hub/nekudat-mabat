---
// דף הבית בספרדית – אותו דף בית כמו העברי (2026-11-03), בשפה אחרת. הגוף משותף (HomeBody).
// הפינות מוצגות רק אם יש להן תוכן ספרדי ("מבחר ולא מראה"), והסדר נשאר לפי ההחלטה הקיימת:
// בספרדית הסיפורים הם המוצר.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import JoinPopup from '../../components/JoinPopup.astro';
import HomeBody from '../../components/HomeBody.astro';
import { newestFirst } from '../../lib/sort';
import { parseBody, plainText, kickerEs } from '../../lib/mabat-format';
import { isPublished } from '../../lib/published';
import { MABAT_ES, BESHT_ES } from '../../data/site-es';
import { esBeshtPath } from '../../data/es-slugs';
import { CORNER_COVERS } from '../../data/corner-covers';
import { daysSince } from '../../lib/story-meta';

const stories = (await getCollection('storiesEs', isPublished)).sort(newestFirst);
const mabat = (await getCollection('mabatEs', isPublished)).sort(newestFirst)[0];
const besht = (await getCollection('beshtEs', isPublished)).sort(newestFirst)[0];
const flat = mabat ? plainText(parseBody(mabat.body ?? '')).replace(/\s+/g, ' ').trim() : '';
const week = [
  mabat && {
    kind: 'mabat',
    href: `/es/shabat/${mabat.id}/`,
    image: CORNER_COVERS.mabat!.src,
    imageAlt: CORNER_COVERS.mabat!.altEs,
    kicker: MABAT_ES.name,
    when: kickerEs(mabat.data.parasha, MABAT_ES.parashaPrefix),
    title: mabat.data.title,
    text: mabat.data.description ?? (flat.length > 200 ? `${flat.slice(0, 197)}…` : flat),
    cta: 'Leer la columna',
    isNew: daysSince(mabat.data.date) <= 7,
    newLabel: 'Nueva',
    ph: 'home_week_mabat',
  },
  besht && {
    kind: 'besht',
    href: esBeshtPath(besht.id),
    image: CORNER_COVERS.besht!.src,
    imageAlt: CORNER_COVERS.besht!.altEs,
    kicker: BESHT_ES.name,
    when: besht.data.occasion,
    title: besht.data.title,
    text: besht.data.excerpt,
    cta: 'Leer la historia',
    isNew: daysSince(besht.data.date) <= 7,
    newLabel: 'Nueva',
    ph: 'home_week_besht',
  },
].filter(Boolean) as Record<string, unknown>[];

const DESCRIPTION =
  'Aquí te detienes un momento, lees una historia breve y sales con un punto de vista nuevo. Historias y momentos breves de Punto de Vista.';
---

<Base
  lang="es"
  title="Punto de Vista – un lugar para detenerse y ver distinto"
  description={DESCRIPTION}
  homeHeader={true}
  altLangHref="/"
  altLangInline={true}
>
  <main>
    <HomeBody {stories} lang="es" week={week} />
    <JoinGroup lang="es" />
    <JoinPopup lang="es" />
  </main>
</Base>

<style>
  main {
    max-width: 68rem;
  }
</style>
