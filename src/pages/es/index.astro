---
// שער האזור הספרדי. אותו עיקרון של דף הבית העברי: מציגים רגע אמיתי בשלמותו
// במקום לתאר את האתר — טקסט אחד מדגים יותר ממה שמשפט הסבר יסביר.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const moments = (await getCollection('momentsEs')).sort((a, b) => {
  const byDate = b.data.date.getTime() - a.data.date.getTime();
  return byDate !== 0 ? byDate : b.id.localeCompare(a.id);
});
const featured = moments[0];
const FeaturedMoment = featured ? (await render(featured)).Content : null;
const featuredUrl = featured
  ? `/es/momentos/${featured.data.feeling}/${featured.id}/`
  : '/es/momentos/';
---

<Base
  lang="es"
  noindex={true}
  homeHeader={true}
  title="Punto de Vista — un lugar para detenerte y mirar distinto"
  description="Un lugar para detenerte, tomar un punto de vista nuevo, y llevarte algo para el camino. Textos breves de Efraim Atia."
>
  <main>
    <section class="hero">
      <h1>Mirar distinto. Vivir distinto.</h1>
      <p class="promise">
        Un lugar para detenerte, tomar un punto de vista nuevo, y llevarte algo para el camino.
      </p>
    </section>

    <section class="lead-action">
      <p class="question">¿Qué estás pasando ahora?</p>
      <a class="cta" href="/es/momentos/">Encuentra un momento</a>
    </section>

    {
      FeaturedMoment && (
        <section class="feature">
          <h2 class="section-label">Un momento de perspectiva</h2>
          <article class="moment-card">
            <FeaturedMoment />
          </article>
          <p class="more">
            <a href={featuredUrl}>Ver este momento</a>
          </p>
        </section>
      )
    }

    <p class="about-line">
      <a href="/es/sobre-mi/">Quién escribe esto</a>
    </p>
  </main>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 0.5rem 0 2rem;
  }

  .hero h1 {
    font-size: 2rem;
    line-height: 1.35;
  }

  .promise {
    color: var(--secondary);
    margin-top: 0.9rem;
  }

  .lead-action {
    text-align: center;
    padding-bottom: 2.75rem;
  }

  .question {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--teal-deep);
    margin-bottom: 1rem;
  }

  .section-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--secondary);
    text-align: center;
    margin-bottom: 1rem;
  }

  .moment-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem 1.4rem;
    font-size: 1.1rem;
    line-height: 1.95;
  }

  .moment-card :global(p + p) {
    margin-top: 1.2rem;
  }

  .more {
    text-align: center;
    margin-top: 1.1rem;
  }

  .more a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .about-line {
    text-align: center;
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }

  .about-line a {
    color: var(--muted);
  }
</style>
