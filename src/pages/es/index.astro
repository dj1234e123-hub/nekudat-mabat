---
// דף הבית בספרדית — אותו דף בית כמו העברי (שלב 4.30), בשפה אחרת:
// פתיחה, דלת הרגעים (קשת, רגע מוגרל מקופל, שיתוף, כפתור ראשי), טעימת
// "מבט לשבת", ודלת הסיפורים עם שלושת העולמות — כל המבנה, אותם ערכים.
// הדף מציג רק תוכן שקיים בפועל: עולם בלי סיפורים מתורגמים אינו מוצג.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import MomentBody from '../../components/MomentBody.astro';
import { parseMoment } from '../../lib/moment-format';
import { groupOf, type FeelingSlug } from '../../data/feelings';
import { SECTIONS_META, SECTION_SLUGS, type SectionSlug } from '../../data/sections';
import { SECTIONS_ES, MABAT_ES } from '../../data/site-es';
import momentGate from '../../assets/gates/moments.png';
import { SECTION_GATE_IMAGES } from '../../data/section-gate-images';
import { newestFirst } from '../../lib/sort';
import MabatBody from '../../components/MabatBody.astro';
import { parseBody } from '../../lib/mabat-format';

const allStories = (await getCollection('storiesEs')).sort(newestFirst);

const picked = allStories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const featuredStories = picked.length >= 3 ? picked.slice(0, 3) : allStories.slice(0, 3);

const GATE_EMOJI: Record<SectionSlug, string> = {
  meshalim: '📖',
  tzadikim: '✨',
  yoman: '📔',
};
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const story =
    featuredStories.find((s) => s.data.section === slug) ??
    allStories.find((s) => s.data.section === slug);
  if (!story) return null;
  return {
    slug,
    meta,
    metaEs: SECTIONS_ES[slug],
    story,
    emoji: GATE_EMOJI[slug],
    image: SECTION_GATE_IMAGES[slug] ?? null,
  };
}).filter((w) => w !== null);

// אותו מנגנון כמו בעברית: הרגע מוגרל מחדש בכל טעינה בצד הקורא; בלי
// JavaScript נשאר החדש ביותר.
const moments = (await getCollection('momentsEs')).sort(newestFirst);
const momentPool = moments.map((m) => {
  const feeling = m.data.feeling as FeelingSlug;
  const path = `/es/momentos/${feeling}/${m.id}/`;
  return {
    url: path,
    href: new URL(path, Astro.site).href,
    format: parseMoment(m.body ?? '', m.data.title),
    accent: groupOf(feeling)?.accent ?? 'var(--gold)',
    ogImage: new URL(`${path}og.png`, Astro.site).href,
  };
});
const featuredMoment = momentPool[0] ?? null;

// טעימה מ"מבט לשבת" — הגיליון האחרון בלבד, שני מהלכים ראשונים.
const mabatPieces = (await getCollection('mabatEs')).sort(newestFirst);
const latestMabat = mabatPieces[0]
  ? { piece: mabatPieces[0], blocks: parseBody(mabatPieces[0].body ?? '') }
  : null;

const DESCRIPTION =
  'Un lugar para detenerse, obtener un nuevo punto de vista y llevar algo contigo en tu camino. Historias y momentos breves de Punto de Vista.';
---

<Base
  lang="es"
  title="Punto de Vista — un lugar para detenerse y ver diferente"
  description={DESCRIPTION}
  homeHeader={true}
  altLangHref="/"
  altLangInline={true}
>
  <main>
    <section class="hero">
      <h1>Ver diferente. Vivir diferente.</h1>
      <p class="triad">Historias. Momentos. Perspectivas.</p>
      <p class="promise">
        Un lugar para detenerse, obtener un nuevo punto de vista y llevar algo contigo en tu
        camino.
      </p>
      {/* המבנה שאושר על סקיצה (2026-08-26): שורת הזמנה לשפה השנייה מתחת
          למשפט ההבטחה — המראה של שורת "Punto de Vista — en español" בעברית. */}
      <p class="lang-invite">
        <a href="/" lang="he" dir="rtl">נקודת מבט — בעברית</a>
      </p>
    </section>

    <section class="dual-section">
      <!-- דלת הרגעים -->
      {
        featuredMoment && (
          <div class="door door-moments" style="grid-area: moments">
            <div class="door-header">
              <h2>
                <span id="moment-dot" class="door-dot" style={`background:${featuredMoment.accent}`} />
                Un momento de Punto de Vista
              </h2>
              <p class="door-subheader">Decenas de momentos, según lo que estás pasando ahora.</p>
            </div>

            <a href="/es/momentos/" class="moment-arch-link" aria-label="Todos los momentos">
              <span class="moment-arch">
                <Image src={momentGate} alt="" widths={[240, 480]} sizes="220px" />
              </span>
            </a>

            <div class="door-content">
              <article class="moment-sample">
                <h3 class="moment-title">
                  <a id="moment-title-link" href={featuredMoment.url}>
                    {featuredMoment.format.title}
                  </a>
                </h3>
                <div id="moment-body-mount">
                  <MomentBody format={featuredMoment.format} collapsed moreLabel="Seguir leyendo" />
                </div>
              </article>

              <div
                id="moment-share"
                class="moment-share"
                data-url={featuredMoment.href}
                data-image={featuredMoment.ogImage}
              >
                <a
                  class="share-pill whatsapp"
                  href={`https://wa.me/?text=${encodeURIComponent(featuredMoment.href)}`}
                  rel="noopener"
                  target="_blank"
                  data-ph="share_whatsapp"
                >
                  Compartir por WhatsApp
                </a>
                <button type="button" class="share-pill copy" data-ph="share_copy">
                  Copiar enlace
                </button>
              </div>

              <div class="moment-footer">
                <a href="/es/momentos/" class="door-cta" data-ph="find_moment">
                  Encuentra tu momento
                </a>
                <p class="door-cta-sub">Más momentos, según lo que estás pasando</p>
              </div>
            </div>

            {momentPool.map((m) => (
              <template
                data-moment-option
                data-url={m.url}
                data-title={m.format.title}
                data-accent={m.accent}
                data-href={m.href}
                data-image={m.ogImage}
              >
                <MomentBody format={m.format} collapsed moreLabel="Seguir leyendo" />
              </template>
            ))}
          </div>
        )
      }

      {
        latestMabat && (
          <section class="mabat-teaser" style="grid-area: mabat">
            <span class="teaser-rail" aria-hidden="true" />
            <div class="teaser-body">
              <p class="teaser-kicker">
                {MABAT_ES.name} · {MABAT_ES.parashaPrefix} {latestMabat.piece.data.parasha}
              </p>
              <a class="teaser-title" href={`/es/shabat/${latestMabat.piece.id}/`}>
                {latestMabat.piece.data.title}
              </a>
              <MabatBody blocks={latestMabat.blocks} stanzaLimit={2} />
              <a class="teaser-more" href={`/es/shabat/${latestMabat.piece.id}/`}>
                Seguir leyendo
              </a>
            </div>
          </section>
        )
      }

      <!-- דלת הסיפורים: שלושת עולמות התוכן -->
      {
        worlds.length > 0 && (
          <div class="door-stories" style="grid-area: stories">
            <div class="stories-header">
              <h2>Historias</h2>
              <p>Tres mundos. Elige por dónde empezar.</p>
            </div>

            <div class="stories-grid">
              {worlds.map(({ slug, meta, metaEs, story, emoji, image }) => (
                <div class="world-card" style={`--accent: ${meta.accent}`}>
                  <a href={`/es/secciones/${slug}/`} class="world-arch-link" aria-label={metaEs.linkText}>
                    <span class="world-arch">
                      {image ? (
                        <Image
                          src={image.image}
                          alt=""
                          widths={[200, 400]}
                          sizes="84px"
                          style={`object-position: ${image.position}`}
                        />
                      ) : (
                        <span class="world-arch-fallback" aria-hidden="true">
                          {emoji}
                        </span>
                      )}
                    </span>
                  </a>
                  <div class="world-text">
                    <h3 class="world-name">{metaEs.label}</h3>
                    <p class="story-example">
                      Por ejemplo: <a href={`/es/historias/${story.id}/`}>{story.data.title}</a>
                    </p>
                    <a href={`/es/secciones/${slug}/`} class="story-link">
                      {metaEs.linkText} →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </section>

    <JoinGroup lang="es" />
  </main>
</Base>

<script is:inline>
  const momentOptions = document.querySelectorAll('template[data-moment-option]');
  if (momentOptions.length > 1) {
    const choice = momentOptions[Math.floor(Math.random() * momentOptions.length)];
    const mount = document.getElementById('moment-body-mount');
    const titleLink = document.getElementById('moment-title-link');
    const dot = document.getElementById('moment-dot');
    const share = document.getElementById('moment-share');
    if (mount) mount.replaceChildren(choice.content.cloneNode(true));
    if (titleLink) {
      titleLink.href = choice.dataset.url;
      titleLink.textContent = choice.dataset.title;
    }
    if (dot) dot.style.background = choice.dataset.accent;
    if (share) {
      share.dataset.url = choice.dataset.href;
      share.dataset.image = choice.dataset.image;
      const wa = share.querySelector('.whatsapp');
      if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(choice.dataset.href)}`;
    }
  }

  // שיתוף — אותה שיטה כמו בדף הבית העברי: תמונה ממותגת קודם דרך
  // Web Share API, קישור נקי כנפילת חזרה. הכתובות נקראות מ-dataset
  // בזמן הלחיצה, כי הרגע מוגרל ומוחלף בצד הלקוח.
  const shareEl = document.getElementById('moment-share');
  if (shareEl) {
    const copyBtn = shareEl.querySelector('.copy');
    copyBtn?.addEventListener('click', async () => {
      const url = shareEl.dataset.url;
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.textContent = 'Enlace copiado ✓';
        setTimeout(() => (copyBtn.textContent = 'Copiar enlace'), 2500);
      } catch {
        prompt('Copia el enlace:', url);
      }
    });

    const waLink = shareEl.querySelector('.whatsapp');
    waLink?.addEventListener('click', async (event) => {
      const imageUrl = shareEl.dataset.image;
      if (!navigator.share || !imageUrl) return;
      event.preventDefault();
      try {
        const response = await fetch(imageUrl);
        const blob = await response.blob();
        const file = new File([blob], 'moment.png', { type: blob.type || 'image/png' });
        if (navigator.canShare?.({ files: [file] })) {
          await navigator.share({ files: [file] });
          return;
        }
      } catch (err) {
        if (err instanceof Error && err.name === 'AbortError') return;
      }
      window.open(waLink.href, '_blank', 'noopener');
    });
  }
</script>

<style>
  /* אזור הפתיחה — אותם ערכים כמו בדף הבית העברי */
  .hero {
    text-align: center;
    padding-top: 0.5rem;
    margin-bottom: 2.25rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 8vw, 2.15rem);
    line-height: 1.3;
    margin-bottom: 0.6rem;
    text-wrap: balance;
    color: var(--teal-deep);
  }

  .triad {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--teal-deep);
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .promise {
    color: var(--secondary);
    max-width: 26rem;
    margin-inline: auto;
    line-height: 1.75;
  }

  .lang-invite {
    margin-top: 0.85rem;
    font-size: 0.9rem;
  }

  .lang-invite a {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .lang-invite a:hover {
    color: var(--teal);
    border-color: var(--teal);
  }

  /* ============ שתי הדלתות — אותם ערכים כמו בדף הבית העברי ============ */
  .dual-section {
    --bleed: min(62rem, 100vw - 3rem);
    width: var(--bleed);
    margin-inline: calc((100% - var(--bleed)) / 2);
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'moments' 'mabat' 'stories';
    gap: 1.75rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 800px) {
    .dual-section {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'moments stories' 'mabat mabat';
      gap: 2rem;
    }
  }

  .door-moments {
    background: var(--paper);
    border: 2px solid var(--brick);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }

  .door-header {
    padding: 1.3rem 1.2rem 0;
    text-align: center;
  }

  .door-header h2 {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    /* מעט קטן מהעברית: "Un momento de Punto de Vista" ארוך מ"רגע של נקודת
       מבט", וכך הכותרת נשארת שורה אחת גם ב-390px. */
    font-size: 1.2rem;
    margin: 0 0 0.4rem;
    font-weight: 700;
    color: var(--ink);
  }

  .door-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .door-subheader {
    font-size: 0.85rem;
    color: var(--secondary);
    margin: 0 0 1.1rem;
  }

  .moment-arch-link {
    display: block;
    width: fit-content;
    margin: 0 auto 1.1rem;
  }

  .moment-arch {
    position: relative;
    display: block;
    width: 190px;
    height: 160px;
    border-radius: 140px 140px 10px 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 10px 26px rgba(46, 42, 36, 0.14);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .moment-arch::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(201, 162, 77, 0.55);
    border-radius: 132px 132px 6px 6px;
    pointer-events: none;
  }

  .moment-arch :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .moment-arch-link:hover .moment-arch,
  .moment-arch-link:focus-visible .moment-arch {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(46, 42, 36, 0.2);
  }

  .moment-arch-link:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 6px;
    border-radius: 10px;
  }

  .door-content {
    --moment-size: 1rem;
    padding: 0 1.2rem 1.3rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .moment-sample {
    margin-bottom: 1rem;
  }

  .moment-title {
    text-align: center;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--blue);
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }

  .moment-title a {
    color: inherit;
    text-decoration: none;
  }

  .moment-share {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.2rem;
  }

  .share-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.4rem 1.1rem;
    border-radius: 2rem;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--teal);
    background: transparent;
    color: var(--teal);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .share-pill.whatsapp {
    background: var(--teal);
    color: #fff;
  }

  .share-pill.whatsapp:hover {
    background: var(--teal-deep);
  }

  .share-pill.copy:hover {
    background: var(--surface);
  }

  .moment-footer {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .door-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0.7rem;
    background: var(--brick);
    color: #fff;
    border-radius: calc(var(--radius) / 1.5);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .door-cta:hover {
    opacity: 0.9;
  }

  .door-cta-sub {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* דלת הסיפורים */
  .door-stories {
    display: flex;
    flex-direction: column;
  }

  .stories-header {
    text-align: center;
    margin-bottom: 1.2rem;
  }

  .stories-header h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.3rem;
  }

  .stories-header p {
    font-size: 0.85rem;
    color: var(--secondary);
    margin: 0;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  .world-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
    box-shadow: var(--shadow);
  }

  .world-arch-link {
    flex-shrink: 0;
    display: block;
    line-height: 0;
  }

  .world-arch {
    position: relative;
    display: block;
    width: 84px;
    height: 84px;
    border-radius: 60px 60px 8px 8px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: transform 0.2s ease;
  }

  .world-arch::after {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid rgba(201, 162, 77, 0.55);
    border-radius: 54px 54px 4px 4px;
    pointer-events: none;
  }

  .world-arch :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .world-arch-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    background: var(--surface);
  }

  .world-arch-link:hover .world-arch,
  .world-arch-link:focus-visible .world-arch {
    transform: translateY(-2px);
  }

  .world-arch-link:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .world-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .world-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0;
  }

  .story-example {
    font-size: 0.9rem;
    color: var(--ink);
    margin: 0;
  }

  .story-example a {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .story-example a:hover {
    text-decoration: underline;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .story-link:hover {
    text-decoration: underline;
  }

  /* ============ טעימת "מבט לשבת" ============ */
  .mabat-teaser {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.3rem 1.4rem;
  }

  .teaser-rail {
    width: 3px;
    align-self: stretch;
    min-height: 3.5rem;
    background: var(--blue);
    border-radius: 2px;
    flex: 0 0 auto;
  }

  .teaser-body {
    flex: 1;
    text-align: center;
  }

  .teaser-kicker {
    color: var(--blue);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }

  .teaser-title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
    margin-bottom: 1.1rem;
    text-wrap: balance;
  }

  .teaser-title:hover {
    color: var(--blue);
  }

  .teaser-more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .teaser-more:hover {
    text-decoration: underline;
  }
</style>
