---
// דף זמני להשוואת פונטים (שלב 3) — לא מקושר מהאתר ולא נסרק ע"י מנועי חיפוש.
// יימחק לאחר ההחלטה הסופית על פונט הטקסט השוטף.
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { TOPICS } from '../data/topics';
import { formatDate } from '../utils/format-date';

const story = await getEntry('stories', 'ha-meil-ba-aron');
if (!story) throw new Error('סיפור הדוגמה להשוואת פונטים לא נמצא');
const { Content } = await render(story);
const { title, topic, cover, coverAlt, date } = story.data;
---

<Base
  title="השוואת פונטים · נקודת מבט"
  description="דף פנימי להשוואת פונטים"
  noindex={true}
>
  <main>
    <section class="picker">
      <p class="picker-title">בחר פונט לטקסט השוטף וקרא את הסיפור למטה:</p>
      <div class="picker-buttons" role="group" aria-label="בחירת פונט">
        <button id="btn-assistant" class="active" type="button">Assistant</button>
        <button id="btn-heebo" type="button">Heebo</button>
      </div>
      <p class="picker-note">הכותרות בשני המקרים: Frank Ruhl Libre. ההחלטה משפיעה רק על טקסט הקריאה והממשק.</p>
    </section>

    <article>
      <header class="story-header">
        <a class="topic-tag" href={`/topics/${topic}/`}>{TOPICS[topic]}</a>
        <h1>{title}</h1>
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      </header>
      <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 42rem) 100vw, 42rem" class="cover" />
      <div class="story-body">
        <Content />
      </div>
    </article>
  </main>
</Base>

<script>
  const assistantBtn = document.getElementById('btn-assistant')!;
  const heeboBtn = document.getElementById('btn-heebo')!;

  function setFont(heebo: boolean) {
    document.body.classList.toggle('font-heebo', heebo);
    assistantBtn.classList.toggle('active', !heebo);
    heeboBtn.classList.toggle('active', heebo);
  }

  assistantBtn.addEventListener('click', () => setFont(false));
  heeboBtn.addEventListener('click', () => setFont(true));
</script>

<style>
  .picker {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .picker-title {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .picker-buttons {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
  }

  .picker-buttons button {
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.4rem 1.4rem;
    border-radius: 2rem;
    border: 1px solid var(--teal);
    background: transparent;
    color: var(--teal);
    cursor: pointer;
  }

  .picker-buttons button.active {
    background: var(--teal);
    color: #fff;
  }

  .picker-note {
    font-size: 0.85rem;
    color: var(--muted);
    margin-top: 0.75rem;
  }

  .story-header {
    text-align: center;
    padding: 0.5rem 0 1.5rem;
  }

  .story-header h1 {
    font-size: clamp(1.8rem, 6.5vw, 2.5rem);
    line-height: 1.3;
    margin: 0.85rem 0 0.5rem;
  }

  .story-header time {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cover {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 2.25rem;
  }

  .story-body {
    font-size: 1.2rem;
    line-height: 2.05;
  }

  .story-body :global(p + p) {
    margin-top: 1.35rem;
  }
</style>
