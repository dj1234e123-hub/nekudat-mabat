---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { SECTIONS_META, SECTION_SLUGS, type SectionSlug } from '../../data/sections';
import { SECTION_GATE_IMAGES } from '../../data/section-gate-images';
import { newestFirst } from '../../lib/sort';
import { isPublished } from '../../lib/published';

export function getStaticPaths() {
  return SECTION_SLUGS.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionSlug;
const { label, line } = SECTIONS_META[section];
// אותה תמונת שער שמופיעה בדלת של דף הבית — הקורא שנכנס דרכה מגיע לאותו מראה.
const gateImage = SECTION_GATE_IMAGES[section] ?? null;

const stories = (
  await getCollection('stories', (s) => s.data.section === section && isPublished(s))
).sort(newestFirst);

// עמוד העולם התאום בספרדית — קיים רק כשיש בעולם סיפורים מתורגמים.
const storiesEs = await getCollection('storiesEs', isPublished);
const hasEsTwin = storiesEs.some((s) => s.data.section === section);
const altLangHref = hasEsTwin ? `/es/secciones/${section}/` : '/es/historias/';
---

<Base
  title={`${label} · נקודת מבט`}
  description={line}
  altLangHref={altLangHref}
  altLangTwin={hasEsTwin}
>
  <main>
    {
      gateImage && (
        <Image
          src={gateImage.image}
          alt=""
          widths={[480, 960, 1344]}
          sizes="(max-width: 42rem) 100vw, 42rem"
          class="section-gate"
          style={`object-position: ${gateImage.position}`}
          loading="eager"
        />
      )
    }
    <h1 class="page-title">{label}</h1>
    <p class="section-line">{line}</p>
    {
      stories.length > 0 ? (
        <ul class="story-list">
          {stories.map((story) => (
            <StoryCard story={story} />
          ))}
        </ul>
      ) : (
        <p class="empty">עוד אין כאן סיפורים — הם בדרך.</p>
      )
    }
    <p class="back"><a href="/stories/">לכל הסיפורים</a></p>
  </main>
</Base>

<style>
  /* תמונת השער של העולם — אותו צילום ואותו חיתוך כמו בדלת של דף הבית */
  .section-gate {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  .section-line {
    text-align: center;
    color: var(--secondary);
    margin: 0 auto 2rem;
    max-width: 26rem;
    line-height: 1.7;
  }

  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 1.75rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2.75rem;
  }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 2rem 0;
  }

  .back {
    text-align: center;
    margin-top: 2.5rem;
  }

  .back a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
