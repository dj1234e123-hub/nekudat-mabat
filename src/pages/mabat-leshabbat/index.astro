---
// עמוד הכניסה ל"מבט לשבת" — ארכיון הגיליונות, מהחדש לישן.
// עם גיליון אחד זה עדיין רשימה קצרה; המבנה מוכן לצמוח בלי שינוי.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { newestFirst } from '../../lib/sort';
import { parseBody, plainText } from '../../lib/mabat-format';
import { isPublished } from '../../lib/published';

const pieces = (await getCollection('mabatLeshabbat', isPublished)).sort(newestFirst);

const cards = pieces.map((piece) => {
  const blocks = parseBody(piece.body ?? '');
  const flat = plainText(blocks).replace(/\s+/g, ' ').trim();
  return {
    piece,
    excerpt: flat.length > 140 ? `${flat.slice(0, 137)}…` : flat,
  };
});
---

<Base
  title="מבט לשבת · נקודת מבט"
  description="טור שבועי: סיפור אמיתי, חיבור לפרשת השבוע, ומבט על מה שקורה בתוכנו."
  altLangHref="/es/shabat/"
>
  <main>
    <h1 class="page-title">מבט לשבת</h1>
    <p class="intro">סיפור אמיתי בכל שבוע, וחיבור לפרשת השבת — לא רק מה היא אומרת, אלא מה היא פותחת.</p>

    <ul class="issues">
      {
        cards.map(({ piece, excerpt }) => (
          <li class="issue">
            <a class="issue-link" href={`/mabat-leshabbat/${piece.id}/`}>
              <p class="issue-kicker">פרשת {piece.data.parasha} · {piece.data.hebrewDate}</p>
              <h2>{piece.data.title}</h2>
              <p class="issue-excerpt">{excerpt}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.5rem;
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    max-width: 30rem;
    margin: 0 auto 2.2rem;
    line-height: 1.75;
  }

  .issues {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .issue {
    border-inline-start: 3px solid var(--blue);
    border-radius: 4px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .issue-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.1rem 1.3rem;
  }

  .issue-kicker {
    color: var(--muted);
    font-size: 0.82rem;
    margin: 0 0 0.4rem;
  }

  .issue h2 {
    font-size: 1.25rem;
    line-height: 1.4;
    margin: 0 0 0.5rem;
    transition: color 0.15s ease;
  }

  .issue-link:hover h2 {
    color: var(--blue);
  }

  .issue-excerpt {
    color: var(--secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }
</style>
