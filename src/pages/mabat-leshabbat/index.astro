---
// שער "מבט לשבת" (שלב 4.99) – ראו CornerGate.astro.
import '../../styles/corner.css';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CornerGate from '../../components/CornerGate.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import havdala from '../../assets/besht/havdala.png';
import { newestFirst } from '../../lib/sort';
import { parseBody, plainText, kicker } from '../../lib/mabat-format';
import { isPublished } from '../../lib/published';
import { readingLabel } from '../../lib/reading-time';
import { monthLabel } from '../../lib/corner';
import { CORNER_COVERS } from '../../data/corner-covers';

const pieces = (await getCollection('mabatLeshabbat', isPublished)).sort(newestFirst);
const [latest, ...rest] = pieces;
const latestText = (() => {
  if (latest.data.description) return latest.data.description;
  const flat = plainText(parseBody(latest.body ?? '')).replace(/\s+/g, ' ').trim();
  return flat.length > 180 ? `${flat.slice(0, 177)}…` : flat;
})();
const cover = CORNER_COVERS.mabat;
---

<Base
  title="מבט לשבת · נקודת מבט"
  description="טור שבועי: סיפור אמיתי, פרשת השבוע, ושאלה אחת לשבת."
  altLangHref="/es/shabat/"
>
  <main>
    <CornerGate
      kind="mabat"
      name="מבט לשבת"
      rhythm={`כל יום שישי בבוקר · ${pieces.length} גיליונות`}
      promise="סיפור אמיתי, פרשת השבוע, ושאלה אחת לשבת."
      cover={cover && { src: cover.src, alt: cover.alt }}
      featured={{
        href: `/mabat-leshabbat/${latest.id}/`,
        kicker: `הגיליון של השבוע · ${kicker(latest.data.parasha)}`,
        title: latest.data.title,
        text: latestText,
        meta: readingLabel({ body: latest.body, data: {} }),
        cta: 'לקרוא ←',
      }}
      items={rest.map((p) => ({
        href: `/mabat-leshabbat/${p.id}/`,
        small: `${kicker(p.data.parasha)} · ${p.data.hebrewDate}`,
        title: p.data.title,
        group: monthLabel(p.data.hebrewDate, 'he'),
      }))}
      bridge={{ href: '/besht/', small: 'ובמוצאי שבת', title: 'מעשה שהיה: סיפור של הבעל שם טוב', image: havdala }}
    />
    <JoinGroup />
  </main>
</Base>
