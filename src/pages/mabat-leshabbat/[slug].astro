---
// עמוד גיליון "מבט לשבת" – תבנית הפינה השבועית (שלב 4.99, כיוון "ספר"):
// תווית, כותרת, שורת הקדמה ושורת כותב; גוף באותיות ספר עם המשפט החזק בתוכו;
// השאלה לשבת; חתימת שבת; כרטיס כותב; "לשלוח הלאה" עם תמונת הציטוט; והמשך
// אחד מאותה שבת. כל ההחלטות משותפות ל"מעשה שהיה" ולספרדית (src/styles/corner.css).
import '../../styles/corner.css';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import MabatBody from '../../components/MabatBody.astro';
import CornerHead from '../../components/CornerHead.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import QuoteShare from '../../components/QuoteShare.astro';
import CornerNext from '../../components/CornerNext.astro';
import havdala from '../../assets/besht/havdala.png';
import { parseBody, plainText, kicker } from '../../lib/mabat-format';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/structured-data';
import { isPublished } from '../../lib/published';
import { newestFirst } from '../../lib/sort';
import { readingLabel } from '../../lib/reading-time';
import { storyAfter, isThisWeek } from '../../lib/corner';
import JoinGroup from '../../components/JoinGroup.astro';
import JoinPopup from '../../components/JoinPopup.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('mabatLeshabbat', isPublished);
  return pieces.map((piece) => ({ params: { slug: piece.id }, props: { piece } }));
}

const { piece } = Astro.props;
const { title, parasha, hebrewDate, date, signoff, quoteImage, quoteImageAlt, description } = piece.data;
const blocks = parseBody(piece.body ?? '');

const flat = plainText(blocks).replace(/\s+/g, ' ').trim();
const derived = flat.length > 200 ? `${flat.slice(0, 197)}…` : flat;
const summary = description ?? derived;

const pageUrl = new URL(`/mabat-leshabbat/${piece.id}/`, Astro.site).href;

let ogImage: string | undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;
if (quoteImage) {
  const og = await getImage({ src: quoteImage, width: 1080, format: 'png' });
  ogImage = new URL(og.src, Astro.site).href;
  ogImageWidth = og.attributes.width;
  ogImageHeight = og.attributes.height;
}

const mabatEs = await getCollection('mabatEs', isPublished);
const hasEsTwin = mabatEs.some((p) => p.id === piece.id);
const altLangHref = hasEsTwin ? `/es/shabat/${piece.id}/` : '/es/shabat/';

// ההמשך. הסיפור של מוצאי אותה שבת; אם עוד לא עלה (ביום שישי הוא עוד לא קיים) –
// הסיפור האחרון בפינה, בתווית כנה. הבנייה של מוצאי שבת מעדכנת את הזוג לבד.
const issues = (await getCollection('mabatLeshabbat', isPublished)).sort(newestFirst);
const stories = (await getCollection('besht', isPublished)).sort(newestFirst);
const paired = storyAfter(piece, stories);
const story = paired ?? stories[0];
const idx = issues.findIndex((p) => p.id === piece.id);
const prev = issues[idx + 1];
const sameParasha = issues.filter((p) => p.id !== piece.id && p.data.parasha === parasha);

const rows = [
  ...sameParasha.map((p) => ({ href: `/mabat-leshabbat/${p.id}/`, small: `עוד על ${kicker(parasha)} · ${p.data.hebrewDate}`, title: p.data.title })),
  ...(prev ? [{ href: `/mabat-leshabbat/${prev.id}/`, small: `הגיליון הקודם · ${kicker(prev.data.parasha)}`, title: prev.data.title }] : []),
  { href: '/mabat-leshabbat/', small: 'כל הגיליונות', title: `${issues.length} גיליונות של מבט לשבת` },
];
---

<Base
  title={`${title} · מבט לשבת`}
  description={summary}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  compact={true}
  altLangHref={altLangHref}
  altLangTwin={hasEsTwin}
  jsonLd={[
    articleJsonLd(Astro.site!, { url: pageUrl, headline: title, description: summary, datePublished: date, image: ogImage }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'נקודת מבט', path: '/' },
      { name: 'מבט לשבת', path: '/mabat-leshabbat/' },
      { name: title },
    ]),
  ]}
>
  <main>
    <article class="corner is-mabat">
      <CornerHead
        corner="מבט לשבת"
        cornerHref="/mabat-leshabbat/"
        label={`${kicker(parasha)} · ${hebrewDate}`}
        now={isThisWeek(piece, issues) ? 'הגיליון של השבוע' : undefined}
        title={title}
        deck={description}
        meta={readingLabel({ body: piece.body, data: {} })}
      />

      <MabatBody blocks={blocks} pullQuote={quoteImageAlt} closingLabel="השאלה לשבת" />

      <div class="ca-signoff">
        <p set:html={signoff.trim().replace(/\n/g, '<br />')} />
      </div>

      <AuthorCard />
    </article>

    <QuoteShare image={quoteImage} imageAlt={quoteImageAlt} imageUrl={ogImage} title={`${title} · מבט לשבת`} url={pageUrl} />

    {
      story && (
        <CornerNext
          heading="השבת ממשיכה"
          pair={{
            href: `/besht/${story.id}/`,
            kicker: paired ? 'במוצאי השבת · מעשה שהיה' : 'מעשה שהיה · הסיפור האחרון',
            title: story.data.title,
            text: story.data.excerpt,
            cta: paired ? 'לסיפור של מוצאי שבת ←' : 'לסיפור ←',
            image: havdala,
            color: 'var(--gold-deep)',
          }}
          rows={rows}
        />
      )
    }

    <JoinGroup />
    <JoinPopup />
  </main>
</Base>
