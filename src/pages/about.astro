---
// עמוד מי אני – גרסה נקייה (שלב 4.105, אושר 2026-11-02).
// מחליף את המכתב האישי של שלב 4.22. עיקרון: תמונה אמיתית אחת, שם ושורת זהות,
// ובלוקים קצרים לפי נוסחת חמש השורות (למי, מה משתנה, למה אני, הכשרה, צעד אחד).
// בלי דף מכתב, חותם, כתב יד או חשיפה הדרגתית. התמונה הנוכחית תוחלף בצילום חדש.
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JoinGroup from '../components/JoinGroup.astro';
import { SITE } from '../data/site';
import portrait from '../assets/efraim-portrait.jpg';
import { profileJsonLd } from '../lib/structured-data';
import { isPublished } from '../lib/published';

// תמונת השיתוף של העמוד הזה היא הפנים ולא הלוגו.
const portraitOg = await getImage({ src: portrait, width: 765, format: 'jpeg' });
const ogImage = new URL(portraitOg.src, Astro.site).href;

const stories = await getCollection('stories', isPublished);
const storyUrls = stories.map((s) => `/stories/${s.id}/`);

const DESCRIPTION =
  'אפרים עטייה: מלווה בחורים וכותב סיפורים. מי אני, איך אני עובד, ואיך אפשר לכתוב לי.';
---

<Base
  title="מי אני – אפרים עטייה · נקודת מבט"
  description={DESCRIPTION}
  ogImage={ogImage}
  ogImageWidth={portraitOg.attributes.width}
  ogImageHeight={portraitOg.attributes.height}
  jsonLd={profileJsonLd(Astro.site!, DESCRIPTION, ogImage)}
  altLangHref="/es/sobre-mi/"
>
  <main>
    <article class="about">
      <h1 class="visually-hidden">מי אני</h1>

      <Image
        class="portrait"
        src={portrait}
        alt="אפרים עטייה בחליפה כהה וכיפה, מחייך"
        widths={[360, 540, 720]}
        sizes="(min-width: 40rem) 30rem, 90vw"
        loading="eager"
      />

      <p class="name">{SITE.ownerName}</p>
      <p class="role">מלווה בחורים. כותב סיפורים.</p>

      <p class="lead">
        אני מלווה בחורים שמרגישים תקועים, מבולבלים, או שהדרך שלהם התרחקה ממה שחשבו שיהיו.
      </p>

      <section class="block">
        <h2>מה קורה בשיחות</h2>
        <p>
          מבינים מה באמת עובר עליך ומה תוקע אותך, ומוצאים צעד קטן אחד קדימה. אני לא מחליט בשבילך
          מה נכון.
        </p>
      </section>

      <section class="block">
        <h2>למה אני</h2>
        <p>
          עברתי בעצמי תקופות קשות. היו זמנים שהרגשתי תקוע, ולא היה לי עם מי לדבר על זה. לכן אני
          יודע להקשיב בלי לשפוט.
        </p>
      </section>

      <section class="block">
        <h2>ומה זה האתר הזה</h2>
        <p>סיפורים ורגעים קצרים שאני כותב בעצמי, בשביל מי שצריך לעצור. אפשר פשוט לקרוא.</p>
      </section>

      <section class="block">
        <h2>הכשרה</h2>
        <p>NLP ברמת Master, עזרה ראשונה נפשית וקורס 12 צעדים.</p>
      </section>

      <a class="cta" href={SITE.whatsappDirectUrl} rel="noopener" target="_blank" data-ph="personal_talk"
        >לכתוב לאפרים</a
      >
      <p class="note">אפילו משפט אחד. אני עונה בעצמי.</p>
      <p class="sign">מאמין בך,</p>

      {
        storyUrls.length > 0 && (
          <button id="start-story" class="start-story" type="button" data-ph="random_story">
            לא בטוח? תתחיל מסיפור
          </button>
        )
      }

      <p class="limits">
        זה ליווי אישי ולא טיפול. כשיש צורך בגורם מקצועי, אגיד לך ואכוון אותך.
      </p>
    </article>

    <JoinGroup />

    <script is:inline define:vars={{ storyUrls }}>
      var btn = document.getElementById('start-story');
      if (btn) {
        btn.addEventListener('click', function () {
          var read = [];
          try {
            read = JSON.parse(localStorage.getItem('nm_read') || '[]');
          } catch (e) {}
          var unread = storyUrls.filter(function (u) {
            return read.indexOf(u.split('/')[2]) === -1;
          });
          var pool = unread.length > 0 ? unread : storyUrls;
          location.href = pool[Math.floor(Math.random() * pool.length)];
        });
      }
    </script>
  </main>
</Base>

<style>
  .about {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.4rem 2.2rem;
    margin-top: 0.5rem;
    max-width: 34rem;
    margin-inline: auto;
  }

  .portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 1.4rem;
  }
  /* מחשב: הדיוקן לא תופס מסך שלם (ב-4:5 הוא 620px גובה); הפנים נשארות בחתך */
  @media (min-width: 52rem) {
    .portrait {
      aspect-ratio: 4 / 3;
      object-position: 50% 0%;
    }
  }

  .name {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1.15;
    font-weight: 500;
    color: var(--ink);
  }

  .role {
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .lead {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink);
    margin-top: 1.5rem;
    text-wrap: balance;
  }

  .block {
    margin-top: 1.4rem;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .block h2 {
    font-family: var(--font-body);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--gold-deep);
    margin-bottom: 0.15rem;
  }

  .about .cta {
    display: block;
    text-align: center;
    margin-top: 1.6rem;
  }

  .note {
    color: var(--secondary);
    font-size: 0.92rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .sign {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-align: center;
    margin-top: 1.1rem;
  }

  .start-story {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin: 0.9rem auto 0;
    padding: 0 0.5rem;
    background: none;
    border: 0;
    font: inherit;
    color: var(--teal);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .limits {
    margin-top: 1.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
