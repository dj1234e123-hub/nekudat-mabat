---
import Base from '../layouts/Base.astro';
---

<Base title="הדף לא נמצא · נקודת מבט" description="הדף שחיפשתם לא נמצא" noindex={true}>
  <main class="notfound">
    <h1>הדף הזה לא נמצא</h1>
    <p>אבל אולי דווקא עכשיו זה רגע טוב לעצור לסיפור.</p>
    <a class="back-btn" href="/">לכל הסיפורים</a>
  </main>
</Base>

<style>
  .notfound {
    text-align: center;
    padding-top: 2.5rem;
  }

  .notfound h1 {
    font-size: 1.9rem;
    margin-bottom: 0.75rem;
  }

  .notfound p {
    color: var(--secondary);
    margin-bottom: 1.75rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: var(--teal);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 0.55rem 1.6rem;
    border-radius: 2rem;
  }

  .back-btn:hover {
    background: var(--teal-deep);
  }
</style>
