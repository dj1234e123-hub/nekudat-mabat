---
// דף הבית — הכניסה לאתר, לא רשימת הסיפורים.
// שני עולמות התוכן המרכזיים מוצגים כשתי דלתות בקנה מידה שווה:
// רגע של נקודת מבט (עם רגע אמיתי בשלמותו) מול שלושת עולמות הסיפורים.
// עיקרון מנחה: הדף מציג רק תוכן שקיים בפועל.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JoinGroup from '../components/JoinGroup.astro';
import { websiteJsonLd } from '../lib/structured-data';
import MomentBody from '../components/MomentBody.astro';
import { parseMoment } from '../lib/moment-format';
import { SECTIONS_META, SECTION_SLUGS, type SectionSlug } from '../data/sections';
import momentGate from '../assets/gates/moments.png';
import { SECTION_GATE_IMAGES } from '../data/section-gate-images';

// דף הבית נותן טעם ומוביל הלאה; הארכיון עצמו חי ב-/stories/.
const allStories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// שלושה סיפורים נבחרים, אחד מכל עולם — הרושם הראשון הוא החלטה, לא תוצאה
// של סדר פרסום. השדה featured קובע גם חברות וגם מיקום; בלי סימון — נפילה
// לאחור לחדש ביותר בכל עולם, כדי שהדלת לעולם לא תתרוקן.
const picked = allStories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const featuredStories = picked.length >= 3 ? picked.slice(0, 3) : allStories.slice(0, 3);

// דלת הסיפורים: כרטיס לכל עולם תוכן שיש בו סיפורים, עם סיפור-דוגמה אמיתי —
// הנבחר של אותו עולם, או החדש ביותר בו.
const GATE_EMOJI: Record<SectionSlug, string> = {
  meshalim: '📖',
  tzadikim: '✨',
  yoman: '📔',
};
const WORLD_LINK_TEXT: Record<SectionSlug, string> = {
  meshalim: 'כל המשלים',
  tzadikim: 'כל סיפורי הצדיקים',
  yoman: 'הכל מהיומן',
};
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const story =
    featuredStories.find((s) => s.data.section === slug) ??
    allStories.find((s) => s.data.section === slug);
  if (!story) return null;
  return {
    slug,
    meta,
    story,
    emoji: GATE_EMOJI[slug],
    image: SECTION_GATE_IMAGES[slug] ?? null,
    linkText: WORLD_LINK_TEXT[slug],
  };
}).filter((w) => w !== null);

// הרגע שמוצג בדלת הרגעים: מוגרל מחדש בכל טעינה, בצד הקורא — כדי שמי שחוזר
// לאתר לא יראה שוב ושוב את אותו רגע קבוע. כל הרגעים נבנים לתבניות מוסתרות
// (<template>), והסקריפט בתחתית הקובץ בוחר אחת מהן באקראי ומשתיל אותה במקום.
//
// בלי JavaScript — ולקוראי מסך/מנועי חיפוש שלא מריצים סקריפט — נשאר הרגע
// החדש ביותר: שובר השוויון על פני תאריך זהה הוא שם הקובץ.
const moments = (await getCollection('moments')).sort((a, b) => {
  const byDate = b.data.date.getTime() - a.data.date.getTime();
  return byDate !== 0 ? byDate : b.id.localeCompare(a.id);
});
const momentPool = moments.map((m) => ({
  url: `/moments/${m.data.feeling}/${m.id}/`,
  format: parseMoment(m.body ?? '', m.data.title),
}));
const featuredMoment = momentPool[0] ?? null;

const DESCRIPTION =
  'מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך. סיפורים ורגעים קצרים של נקודת מבט.';
---

<Base
  title="נקודת מבט — מקום לעצור, ולראות אחרת"
  description={DESCRIPTION}
  homeHeader={true}
  jsonLd={websiteJsonLd(Astro.site!, DESCRIPTION)}
>
  <main>
    <section class="hero">
      <h1>לראות אחרת. לחיות אחרת.</h1>
      <p class="triad">סיפורים. רגעים. תובנות.</p>
      <p class="promise">
        מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך.
      </p>
    </section>

    <!-- שתי דלתות בקנה מידה שווה: רגעים מול סיפורים -->
    <section class="dual-section">
      <!-- דלת הרגעים -->
      {
        featuredMoment && (
          <div class="door door-moments">
            <div class="door-header">
              <h2>רגע של נקודת מבט</h2>
              <p class="door-subheader">רגע קצר שמדבר ישירות אליך</p>
            </div>

            <a href="/moments/" class="gate-link" aria-label="לכל הרגעים">
              <img src={momentGate.src} alt="" class="door-gate" decoding="async" />
            </a>

            <div class="door-content">
              <article class="moment-sample">
                <h3 class="moment-title">
                  <a id="moment-title-link" href={featuredMoment.url}>
                    {featuredMoment.format.title}
                  </a>
                </h3>
                <div id="moment-body-mount">
                  <MomentBody format={featuredMoment.format} />
                </div>
              </article>

              <div class="moment-footer">
                <a href="/moments/" class="door-cta">מצא רגע שלך</a>
              </div>
            </div>

            {
              /* המאגר שממנו מוגרל הרגע (ראו הסקריפט בתחתית הקובץ). <template>
                 אינו מוצג ואינו נכלל בפריסה. */
              momentPool.map((m) => (
                <template data-moment-option data-url={m.url} data-title={m.format.title}>
                  <MomentBody format={m.format} />
                </template>
              ))
            }
          </div>
        )
      }

      <!-- דלת הסיפורים: שלושת עולמות התוכן -->
      <div class="door-stories">
        <div class="stories-header">
          <h2>סיפורים</h2>
          <p>שלושה עולמות. בחר מאיפה להתחיל.</p>
        </div>

        <div class="stories-grid">
          {
            worlds.map(({ slug, meta, story, emoji, image, linkText }) => (
              <div class="story-card" data-section={slug}>
                {image ? (
                  <a href={`/sections/${slug}/`} class="gate-link" aria-label={linkText}>
                    <img
                      src={image.image.src}
                      alt=""
                      class="story-gate"
                      style={`object-position: ${image.position}`}
                      decoding="async"
                    />
                  </a>
                ) : (
                  <div class="story-gate" aria-hidden="true">{emoji}</div>
                )}
                <div class="story-header">
                  <h3>{meta.label}</h3>
                  <p class="story-line">{meta.line}</p>
                </div>
                <div class="story-body">
                  <a class="story-example" href={`/stories/${story.id}/`}>
                    {story.data.title}
                  </a>
                  <a href={`/sections/${slug}/`} class="story-link">
                    {linkText}
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <JoinGroup />
  </main>
</Base>

<script is:inline>
  const momentOptions = document.querySelectorAll('template[data-moment-option]');
  if (momentOptions.length > 1) {
    const choice = momentOptions[Math.floor(Math.random() * momentOptions.length)];
    const mount = document.getElementById('moment-body-mount');
    const titleLink = document.getElementById('moment-title-link');
    if (mount) mount.replaceChildren(choice.content.cloneNode(true));
    if (titleLink) {
      titleLink.href = choice.dataset.url;
      titleLink.textContent = choice.dataset.title;
    }
  }
</script>

<style>
  /* אזור הפתיחה */
  .hero {
    text-align: center;
    padding-top: 0.5rem;
    margin-bottom: 2.25rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 8vw, 2.15rem);
    line-height: 1.3;
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }

  /* משפט אופי, לא שורת ניווט — "תובנות" עדיין אין לה אזור, ולכן היא לא קישור. */
  .triad {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--teal-deep);
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .promise {
    color: var(--secondary);
    max-width: 26rem;
    margin-inline: auto;
    line-height: 1.75;
  }

  /* ============ שתי הדלתות ============ */
  /* הדלתות פורצות את עמודת התוכן הרגילה (42rem) כדי לשבת זו לצד זו במסך רחב.
     שני השוליים שליליים באותה מידה, ולכן המרכוז נשמר גם ב-RTL. */
  .dual-section {
    --bleed: min(62rem, 100vw - 3rem);
    width: var(--bleed);
    margin-inline: calc((100% - var(--bleed)) / 2);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 800px) {
    .dual-section {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  /* דלת הרגעים */
  .door-moments {
    background: var(--paper);
    border: 2px solid var(--brick);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }

  .door-header {
    background: var(--brick);
    color: #fff;
    padding: 1.1rem 1rem;
    text-align: center;
  }

  .door-header h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0;
    font-weight: 700;
    color: #fff;
  }

  .door-subheader {
    font-size: 0.85rem;
    opacity: 0.92;
    margin: 0.3rem 0 0;
  }

  /* תמונת השער של דלת הרגעים */
  .door-gate {
    width: 100%;
    height: 230px;
    background: linear-gradient(135deg, rgba(176, 70, 59, 0.12) 0%, rgba(176, 70, 59, 0.04) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
  }

  /* התמונה עצמה היא דלת — לחיצה עליה נכנסת פנימה */
  .gate-link {
    display: block;
    line-height: 0;
  }

  /* כשהשער הוא צילום ולא ממלא-מקום — למלא את כל השטח.
     גובה יחסי לרוחב (ולא קבוע) — כך החיתוך לא בולע את נושא הצילום. */
  img.door-gate,
  img.story-gate {
    display: block;
    object-fit: cover;
    height: auto;
  }

  img.door-gate {
    aspect-ratio: 5 / 3;
  }

  img.story-gate {
    aspect-ratio: 2 / 1;
  }

  .door-content {
    /* הרגע בדלת קטן מזה שבעמוד שלו — כאן הוא אורח */
    --moment-size: 1rem;
    padding: 1.4rem 1.2rem 1.2rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .moment-sample {
    margin-bottom: 1.2rem;
  }

  .moment-title {
    text-align: center;
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--blue);
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }

  .moment-title a {
    color: inherit;
    text-decoration: none;
  }

  .moment-footer {
    margin-top: auto;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .door-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0.7rem;
    background: var(--brick);
    color: #fff;
    border-radius: calc(var(--radius) / 1.5);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .door-cta:hover {
    opacity: 0.9;
  }

  /* דלת הסיפורים */
  .door-stories {
    display: flex;
    flex-direction: column;
  }

  .stories-header {
    text-align: center;
    margin-bottom: 1.2rem;
  }

  .stories-header h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.3rem;
  }

  .stories-header p {
    font-size: 0.85rem;
    color: var(--secondary);
    margin: 0;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  .story-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
  }

  /* תמונת שער לעולם */
  .story-gate {
    width: 100%;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  .story-card[data-section='meshalim'] .story-gate {
    background: linear-gradient(135deg, rgba(176, 70, 59, 0.12) 0%, rgba(176, 70, 59, 0.04) 100%);
  }

  .story-card[data-section='tzadikim'] .story-gate {
    background: linear-gradient(135deg, rgba(31, 92, 87, 0.12) 0%, rgba(31, 92, 87, 0.04) 100%);
  }

  .story-card[data-section='yoman'] .story-gate {
    background: linear-gradient(135deg, rgba(0, 59, 92, 0.12) 0%, rgba(0, 59, 92, 0.04) 100%);
  }

  .story-header {
    padding: 0.85rem 1rem 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .story-header h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0;
    font-weight: 700;
  }

  .story-card[data-section='meshalim'] .story-header h3 {
    color: var(--brick);
  }

  .story-card[data-section='tzadikim'] .story-header h3 {
    color: var(--teal);
  }

  .story-card[data-section='yoman'] .story-header h3 {
    color: var(--blue);
  }

  .story-line {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }

  .story-body {
    padding: 0.75rem 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* סיפור-דוגמה אמיתי מהעולם — טעימה, לא רשימה */
  .story-example {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }

  .story-example:hover {
    text-decoration: underline;
  }

  .story-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .story-link:hover {
    text-decoration: underline;
  }
</style>
