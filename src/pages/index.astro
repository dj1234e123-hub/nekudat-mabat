---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import JoinGroup from '../components/JoinGroup.astro';
import { SECTIONS, SECTION_SLUGS } from '../data/sections';

const stories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const storyUrls = stories.map((s) => `/stories/${s.id}/`);
---

<Base
  title="נקודת מבט — ספרייה חיה של סיפורים"
  description="נקודת מבט — ספרייה חיה של סיפורים. כל סיפור מוביל למסע שקט אל נקודת מבט חדשה."
>
  <main>
    <p class="intro">ספרייה חיה של סיפורים. כל סיפור — מסע שקט אל נקודת מבט חדשה.</p>
    <nav class="topics" aria-label="עולמות התוכן">
      {SECTION_SLUGS.map((slug) => <a class="choice" href={`/sections/${slug}/`}>{SECTIONS[slug]}</a>)}
      <button id="random-story" class="action" type="button">✦ סיפור אקראי</button>
    </nav>
    <ul class="story-list">
      {stories.map((story) => <StoryCard story={story} />)}
    </ul>
    <p class="closing-line">כל סיפור מתחיל בנקודת מבט אחת.</p>
    <JoinGroup />
  </main>
</Base>

<script is:inline define:vars={{ storyUrls }}>
  document.getElementById('random-story').addEventListener('click', () => {
    location.href = storyUrls[Math.floor(Math.random() * storyUrls.length)];
  });
</script>

<style>
  .intro {
    text-align: center;
    color: var(--secondary);
    max-width: 30rem;
    margin: 0 auto 1.5rem;
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding-bottom: 2.25rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2.75rem;
  }

  /* שורת סיום שקטה מתחת לסיפורים — בגופן ובצבעים הקיימים */
  .closing-line {
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--muted);
    margin-top: 2.75rem;
  }
</style>
