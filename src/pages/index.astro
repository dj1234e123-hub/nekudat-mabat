---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import { TOPICS, TOPIC_SLUGS } from '../data/topics';

const stories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base
  title="נקודת מבט — ספרייה חיה של סיפורים"
  description="נקודת מבט — ספרייה חיה של סיפורים. כל סיפור מוביל למסע שקט אל נקודת מבט חדשה."
>
  <main>
    <nav class="topics" aria-label="נושאים">
      {TOPIC_SLUGS.map((slug) => <a class="topic-tag" href={`/topics/${slug}/`}>{TOPICS[slug]}</a>)}
    </nav>
    <ul class="story-list">
      {stories.map((story) => <StoryCard story={story} />)}
    </ul>
  </main>
</Base>

<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding-bottom: 2rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }
</style>
