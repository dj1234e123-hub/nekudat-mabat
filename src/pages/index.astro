---
// דף הבית — הכניסה לאתר, לא רשימת הסיפורים.
// שני עולמות התוכן המרכזיים מוצגים כשתי דלתות בקנה מידה שווה: רגע של נקודת
// מבט (קשת + רגע מקופל) מול ארבעת עולמות הסיפורים (קשתות קטנות). שתי
// הדלתות חולקות עכשיו שפה חזותית אחת — הקשת — שכבר קיימת בשערי /moments/.
// עיקרון מנחה: הדף מציג רק תוכן שקיים בפועל.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import JoinGroup from '../components/JoinGroup.astro';
import { websiteJsonLd } from '../lib/structured-data';
import MomentBody from '../components/MomentBody.astro';
import { parseMoment } from '../lib/moment-format';
import { groupOf, type FeelingSlug } from '../data/feelings';
import { SECTIONS_META, SECTION_SLUGS, type SectionSlug } from '../data/sections';
import momentGate from '../assets/gates/moments.png';
import { SECTION_GATE_IMAGES } from '../data/section-gate-images';
import { newestFirst } from '../lib/sort';
import { parseBody, plainText, kicker } from '../lib/mabat-format';
import { isPublished } from '../lib/published';
import JoinPopup from '../components/JoinPopup.astro';

// דף הבית נותן טעם ומוביל הלאה; הארכיון עצמו חי ב-/stories/.
const allStories = (await getCollection('stories', isPublished)).sort(newestFirst);

// שלושה סיפורים נבחרים, אחד מכל עולם — הרושם הראשון הוא החלטה, לא תוצאה
// של סדר פרסום. השדה featured קובע גם חברות וגם מיקום; בלי סימון — נפילה
// לאחור לחדש ביותר בכל עולם, כדי שהדלת לעולם לא תתרוקן.
const picked = allStories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const featuredStories = picked.length >= 3 ? picked.slice(0, 3) : allStories.slice(0, 3);

// דלת הסיפורים: כרטיס לכל עולם תוכן שיש בו סיפורים, עם סיפור-דוגמה אמיתי —
// הנבחר של אותו עולם, או החדש ביותר בו.
const GATE_EMOJI: Record<SectionSlug, string> = {
  meshalim: '📖',
  tzadikim: '✨',
  yoman: '📔',
  chaim: '🌍',
};
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const story =
    featuredStories.find((s) => s.data.section === slug) ??
    allStories.find((s) => s.data.section === slug);
  if (!story) return null;
  return {
    slug,
    meta,
    story,
    emoji: GATE_EMOJI[slug],
    image: SECTION_GATE_IMAGES[slug] ?? null,
    linkText: meta.linkText,
  };
}).filter((w) => w !== null);

// הרגע שמוצג בדלת הרגעים: מוגרל מחדש בכל טעינה, בצד הקורא (הסקריפט בתחתית
// הקובץ) — כדי שמי שחוזר לאתר לא יראה שוב ושוב את אותו רגע קבוע. כל רגע
// בבריכה נושא גם accent (צבע הזהות של קבוצת הרגש שלו, לנקודה שליד הכותרת)
// וגם href/ogImage מלאים — כדי ששיתוף מדף הבית יעבוד בדיוק כמו בעמוד הרגע
// עצמו: תמונה ממותגת קודם (Web Share API), קישור נקי כנפילת חזרה.
//
// בלי JavaScript — ולקוראי מסך/מנועי חיפוש שלא מריצים סקריפט — נשאר הרגע
// החדש ביותר: שובר השוויון על פני תאריך זהה הוא שם הקובץ (src/lib/sort.ts).
const moments = (await getCollection('moments', isPublished)).sort(newestFirst);
const momentPool = moments.map((m) => {
  const feeling = m.data.feeling as FeelingSlug;
  const path = `/moments/${feeling}/${m.id}/`;
  return {
    url: path,
    href: new URL(path, Astro.site).href,
    format: parseMoment(m.body ?? '', m.data.title),
    accent: groupOf(feeling)?.accent ?? 'var(--gold)',
    // כרטיס השיתוף הגבוה — אותו קובץ שכפתור הוואטסאפ בעמוד הרגע שולח.
    ogImage: new URL(`${path}card.png`, Astro.site).href,
  };
});
const featuredMoment = momentPool[0] ?? null;

// טעימה מ"מבט לשבת" — הגיליון האחרון בלבד.
// מוצג התקציר של הגיליון ולא הפתיחה שלו: שורות הפתיחה הן הטור עצמו, והקורא
// שפגש אותן בדף הבית מתחיל אותו מחדש בעמוד הגיליון. התקציר נשען על הסיפור
// כולו בלי לחשוף את הסוף — בדיוק התפקיד של הטעימה. אותו שדה description
// שכבר מזין את התצוגה המקדימה בוואטסאפ ובגוגל (שלב 4.59), ואותה נפילה
// לאחור בדיוק כמו בעמוד הגיליון: גיליון בלי תקציר נגזר מ-200 תווי הפתיחה.
// הדף מציג רק תוכן שקיים בפועל: בלי גיליון, האזור כולו לא מוצג.
const mabatPieces = (await getCollection('mabatLeshabbat', isPublished)).sort(newestFirst);
const latestMabat = mabatPieces[0]
  ? (() => {
      const piece = mabatPieces[0];
      const flat = plainText(parseBody(piece.body ?? '')).replace(/\s+/g, ' ').trim();
      const derived = flat.length > 200 ? `${flat.slice(0, 197)}…` : flat;
      return { piece, summary: piece.data.description ?? derived };
    })()
  : null;

// טעימה מ"מעשה שהיה" — סיפור הבעל שם טוב האחרון של מוצאי שבת.
// כמו כל אזור בדף הבית: בלי סיפור, האזור כולו לא מוצג.
const beshtStories = (await getCollection('besht', isPublished)).sort(newestFirst);
const latestBesht = beshtStories[0] ?? null;

const DESCRIPTION =
  'מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך. סיפורים ורגעים קצרים של נקודת מבט.';
---

<Base
  title="נקודת מבט — מקום לעצור, ולראות אחרת"
  description={DESCRIPTION}
  homeHeader={true}
  jsonLd={await websiteJsonLd(Astro.site!, DESCRIPTION)}
  altLangHref="/es/"
  altLangInline={true}
>
  <main>
    <section class="hero">
      <h1>לראות אחרת. לחיות אחרת.</h1>
      <p class="triad">סיפורים. רגעים. תובנות.</p>
      <p class="promise">
        מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך.
      </p>
      {/* המבנה שאושר על סקיצה (2026-08-26): שורת הזמנה לאזור הספרדי מתחת
          למשפט ההבטחה. בעמודים הפנימיים — גלולת פינה (Base.astro). */}
      <p class="lang-invite">
        <a href="/es/" lang="es" dir="ltr">Punto de Vista — en español</a>
      </p>
    </section>

    {/* מפריד אזורים — נקודת זהב. הדפוס כבר קיים בתחתית כל עמוד באתר, והוא
        מה שמחליף את המסגרות שירדו: אוויר וסימן אחד, במקום קיר. */}
    <span class="sep" aria-hidden="true"></span>

    <!-- שתי דלתות בקנה מידה שווה: רגעים מול סיפורים, ובין לבין — טעימה
         מ"מבط لشبت" (לא דלת שלישית באותו משקל). במסך צר שלושתם מתקפלים
         לעמודה אחת בסדר הזה בדיוק; במסך רחב, ששתי הדלתות יושבות זו לצד זו
         בשורה אחת, הטעימה יורדת לרצועה מלאה מתחתיהן — "בין" לא קיים
         גיאומטרית כששני האיברים כבר צמודים אופקית. -->
    <section class="dual-section">
      <!-- דלת הרגעים -->
      {
        featuredMoment && (
          <div class="door door-moments" style="grid-area: moments">

            <div class="door-header">
              <h2>
                <span id="moment-dot" class="door-dot" style={`background:${featuredMoment.accent}`} />
                רגע של נקודת מבט
              </h2>
              <p class="door-subheader">עשרות רגעים, לפי מה שעובר עליך עכשיו.</p>
            </div>

            <a href="/moments/" class="moment-arch-link" aria-label="לכל הרגעים">
              <span class="moment-arch">
                <Image src={momentGate} alt="" widths={[240, 480]} sizes="220px" />
              </span>
            </a>

            <div class="door-content">
              <article class="moment-sample">
                <h3 class="moment-title">
                  <a id="moment-title-link" href={featuredMoment.url}>
                    {featuredMoment.format.title}
                  </a>
                </h3>
                {/* קו הזהב שמתחת לכותרת-הוו בעמוד הרגע (.hook-rule). מאז שהמסגרת
                    האדומה ירדה, הוא מה שמסמן "כאן מתחיל רגע" — ובאותה צורה בדיוק
                    שהקורא כבר פוגש בעמוד הרגע עצמו. */}
                <span class="hook-rule" aria-hidden="true" />
                <div id="moment-body-mount">
                  <MomentBody format={featuredMoment.format} collapsed />
                </div>
              </article>

              <div class="moment-footer">
                <a href="/moments/" class="door-cta" data-ph="find_moment">מצא רגע שלך</a>
                <p class="door-cta-sub">עוד רגעים, לפי מה שעובר עליך</p>
              </div>

              {/* השיתוף יורד מתחת לפעולה הראשית: קודם הוא ישב מעליה, וביקש
                  ממבקר ראשון לשתף רגע שהסיום שלו עדיין מקופל. */}
              <div
                id="moment-share"
                class="moment-share"
                data-url={featuredMoment.href}
                data-image={featuredMoment.ogImage}
              >
                <a
                  class="share-link whatsapp"
                  href={`https://wa.me/?text=${encodeURIComponent(featuredMoment.href)}`}
                  rel="noopener"
                  target="_blank"
                  data-ph="share_whatsapp"
                >
                  שיתוף בוואטסאפ
                </a>
                <button type="button" class="share-link copy" data-ph="share_copy">העתקת קישור</button>
              </div>
            </div>

            {
              /* המאגר שממנו מוגרל הרגע (ראו הסקריפט בתחתית הקובץ). <template>
                 אינו מוצג ואינו נכלל בפריסה. */
              momentPool.map((m) => (
                <template
                  data-moment-option
                  data-url={m.url}
                  data-title={m.format.title}
                  data-accent={m.accent}
                  data-href={m.href}
                  data-image={m.ogImage}
                >
                  <MomentBody format={m.format} collapsed />
                </template>
              ))
            }
          </div>
        )
      }

      {
        latestBesht && (
          <section class="besht-teaser" style="grid-area: besht">
            <span class="teaser-rail besht-rail" aria-hidden="true" />
            <div class="teaser-body">
              <p class="teaser-kicker besht-kicker">מעשה שהיה · {latestBesht.data.occasion}</p>
              <a class="teaser-title" href={`/besht/${latestBesht.id}/`}>
                {latestBesht.data.title}
              </a>
              <p class="besht-excerpt">{latestBesht.data.excerpt}</p>
              <a class="teaser-more" href={`/besht/${latestBesht.id}/`}>
                לקרוא את הסיפור
              </a>
            </div>
          </section>
        )
      }

      {
        latestMabat && (
          <section class="mabat-teaser" style="grid-area: mabat">
            <span class="teaser-rail" aria-hidden="true" />
            <div class="teaser-body">
              <p class="teaser-kicker">מבט לשבת · {kicker(latestMabat.piece.data.parasha)}</p>
              <a class="teaser-title" href={`/mabat-leshabbat/${latestMabat.piece.id}/`}>
                {latestMabat.piece.data.title}
              </a>
              <p class="mabat-summary">{latestMabat.summary}</p>
              <a class="teaser-more" href={`/mabat-leshabbat/${latestMabat.piece.id}/`}>
                להמשיך לקרוא
              </a>
            </div>
          </section>
        )
      }

      <!-- דלת הסיפורים: ארבעת עולמות התוכן -->
      <div class="door-stories" style="grid-area: stories">
        <div class="stories-header">
          <h2>סיפורים</h2>
          <p>ארבעה עולמות. בחר מאיפה להתחיל.</p>
        </div>

        <div class="stories-grid">
          {
            worlds.map(({ slug, meta, story, emoji, image, linkText }) => (
              <div class="world-card" style={`--accent: ${meta.accent}`}>
                <a href={`/sections/${slug}/`} class="world-arch-link" aria-label={linkText}>
                  <span class="world-arch">
                    {image ? (
                      <Image
                        src={image.image}
                        alt=""
                        widths={[200, 400]}
                        sizes="84px"
                        style={`object-position: ${image.position}`}
                      />
                    ) : (
                      <span class="world-arch-fallback" aria-hidden="true">
                        {emoji}
                      </span>
                    )}
                  </span>
                </a>
                <div class="world-text">
                  <h3 class="world-name">{meta.label}</h3>
                  <p class="story-example">
                    למשל: <a href={`/stories/${story.id}/`}>{story.data.title}</a>
                  </p>
                  <a href={`/sections/${slug}/`} class="story-link">
                    {linkText} ←
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <JoinGroup />
    <JoinPopup />
  </main>
</Base>

<script is:inline>
  const momentOptions = document.querySelectorAll('template[data-moment-option]');
  if (momentOptions.length > 1) {
    const choice = momentOptions[Math.floor(Math.random() * momentOptions.length)];
    const mount = document.getElementById('moment-body-mount');
    const titleLink = document.getElementById('moment-title-link');
    const dot = document.getElementById('moment-dot');
    const share = document.getElementById('moment-share');
    if (mount) mount.replaceChildren(choice.content.cloneNode(true));
    if (titleLink) {
      titleLink.href = choice.dataset.url;
      titleLink.textContent = choice.dataset.title;
    }
    if (dot) dot.style.background = choice.dataset.accent;
    if (share) {
      share.dataset.url = choice.dataset.href;
      share.dataset.image = choice.dataset.image;
      const wa = share.querySelector('.whatsapp');
      if (wa) wa.href = `https://wa.me/?text=${encodeURIComponent(choice.dataset.href)}`;
    }
  }

  // שיתוף מדף הבית — אותה שיטה בדיוק כמו בעמוד הרגע (ShareRow.astro): תמונה
  // ממותגת קודם דרך Web Share API, קישור נקי כנפילת חזרה. הרגע כאן מוגרל
  // ומוחלף בצד הלקוח, ולכן הכתובות נקראות תמיד מ-dataset בזמן הלחיצה,
  // ולא נקבעות פעם אחת מראש.
  const shareEl = document.getElementById('moment-share');
  if (shareEl) {
    const copyBtn = shareEl.querySelector('.copy');
    copyBtn?.addEventListener('click', async () => {
      const url = shareEl.dataset.url;
      try {
        await navigator.clipboard.writeText(url);
        copyBtn.textContent = 'הקישור הועתק ✓';
        setTimeout(() => (copyBtn.textContent = 'העתקת קישור'), 2500);
      } catch {
        prompt('העתיקו את הקישור:', url);
      }
    });

    const waLink = shareEl.querySelector('.whatsapp');
    waLink?.addEventListener('click', async (event) => {
      const imageUrl = shareEl.dataset.image;
      if (!navigator.share || !imageUrl) return;
      event.preventDefault();
      try {
        const response = await fetch(imageUrl);
        const blob = await response.blob();
        const file = new File([blob], 'moment.png', { type: blob.type || 'image/png' });
        if (navigator.canShare?.({ files: [file] })) {
          await navigator.share({ files: [file] });
          return;
        }
      } catch (err) {
        if (err instanceof Error && err.name === 'AbortError') return;
      }
      window.open(waLink.href, '_blank', 'noopener');
    });
  }
</script>

<style>
  /* אזור הפתיחה */
  .hero {
    text-align: center;
    padding-top: 0.5rem;
    margin-bottom: 2.25rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 8vw, 2.15rem);
    line-height: 1.3;
    margin-bottom: 0.6rem;
    text-wrap: balance;
    color: var(--teal-deep);
  }

  /* משפט אופי, לא שורת ניווט — "תובנות" עדיין אין לה אזור, ולכן היא לא קישור. */
  .triad {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--teal-deep);
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .promise {
    color: var(--secondary);
    max-width: 26rem;
    margin-inline: auto;
    line-height: 1.75;
  }

  /* שורת ההזמנה לאזור הספרדי — קישור שקט, לא כפתור: דלת למי שמחפש אותה,
     בלי להתחרות בפעולה הראשית. */
  .lang-invite {
    margin-top: 0.85rem;
    font-size: 0.9rem;
  }

  .lang-invite a {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .lang-invite a:hover {
    color: var(--teal);
    border-color: var(--teal);
  }

  /* ============ שתי הדלתות ============ */
  /* הדלתות פורצות את עמודת התוכן הרגילה (42rem) כדי לשבת זו לצד זו במסך רחב.
     שני השוליים שליליים באותה מידה, ולכן המרכוז נשמר גם ב-RTL. */
  .dual-section {
    --bleed: min(62rem, 100vw - 3rem);
    width: var(--bleed);
    margin-inline: calc((100% - var(--bleed)) / 2);
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'moments' 'besht' 'mabat' 'stories';
    /* הרווח גדל (1.75 ← 3.25rem): מה שהפריד בין האזורים היה מסגרת, ומאז
       שהיא ירדה האוויר הוא שעושה את העבודה — והוא גם מה שמחזיק את נקודת
       הזהב שיושבת בתוכו. */
    gap: 3.25rem;
    align-items: start;
    margin-bottom: 2.5rem;
  }

  /* נקודת הזהב המפרידה. מיקום מוחלט ולא זרימה, כי שתי הטעימות הן שורות
     flex ו-.door-stories עמודת flex — פסאודו-אלמנט בזרימה היה נעשה פריט
     בפריסה שלהן. במסך רחב שתי הדלתות כבר יושבות זו לצד זו, ואז אין "בין". */
  .sep {
    display: block;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--gold);
    opacity: 0.85;
    /* .hero כבר תורם 2.25rem מלמעלה */
    margin: 0.75rem auto 2.75rem;
  }

  @media (max-width: 49.99rem) {
    .besht-teaser,
    .mabat-teaser,
    .door-stories {
      position: relative;
    }

    .besht-teaser::before,
    .mabat-teaser::before,
    .door-stories::before {
      content: '';
      position: absolute;
      top: -1.85rem;
      inset-inline-start: 50%;
      transform: translateX(50%);
      width: 0.4rem;
