---
// דף הבית — הכניסה לאתר, לא רשימת הסיפורים.
// הסדר: מי אנחנו → הפעולה הראשית → רגע אמיתי → הסיפורים → הקבוצה.
// עיקרון מנחה: הדף מציג רק תוכן שקיים בפועל. אין שורת קטגוריות ואין אזור
// שמוביל לעולם ריק — עולם תוכן יקבל מקום בניווט כשיהיה בו תוכן לעמוד עליו.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import JoinGroup from '../components/JoinGroup.astro';
import { websiteJsonLd } from '../lib/structured-data';
import MomentBody from '../components/MomentBody.astro';
import { parseMoment } from '../lib/moment-format';

// דף הבית נותן טעם ומוביל הלאה; הארכיון עצמו חי ב-/stories/.
const allStories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// שלושה סיפורים נבחרים, אחד מכל עולם — כך דף הבית מלמד את המפה בלי להסביר
// אותה. הבחירה ידנית ולא לפי תאריך: הרושם הראשון הוא החלטה, לא תוצאה של סדר
// פרסום. השדה featured קובע גם חברות וגם מיקום, ושינוי הוא מספר אחד בקובץ.
// אם לא סומן מספיק — נפילה לאחור לשלושה האחרונים, כדי שהדף לעולם לא יתרוקן.
const picked = allStories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const stories = picked.length >= 3 ? picked.slice(0, 3) : allStories.slice(0, 3);
const storyUrls = allStories.map((s) => `/stories/${s.id}/`);

// הרגע שמוצג בדף הבית: מוגרל מחדש בכל טעינה, בצד הקורא — כדי שמי שחוזר לאתר
// לא יראה שוב ושוב את אותו רגע קבוע. כל 66 הרגעים נבנים כאן לתבניות מוסתרות
// (<template>), והסקריפט בתחתית הקובץ בוחר אחת מהן באקראי ומשתיל אותה במקום.
// זה עובד בלי הפרש גובה בין רגע לרגע: הפורמט קבע שכל שלושת המהלכים תמיד
// באותו גובה בדיוק (docs/MOMENT-FORMAT.md), ולכן אין קפיצת פריסה בהחלפה.
//
// בלי JavaScript — ולקוראי מסך/מנועי חיפוש שלא מריצים סקריפט — נשאר הרגע
// החדש ביותר, בדיוק כמו שהיה כאן קודם: שובר השוויון על פני תאריך זהה הוא
// שם הקובץ.
const moments = (await getCollection('moments')).sort((a, b) => {
  const byDate = b.data.date.getTime() - a.data.date.getTime();
  return byDate !== 0 ? byDate : b.id.localeCompare(a.id);
});
const momentPool = moments.map((m) => ({
  url: `/moments/${m.data.feeling}/${m.id}/`,
  format: parseMoment(m.body ?? '', m.data.title),
}));
const featuredMoment = momentPool[0] ?? null;

const DESCRIPTION =
  'מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך. סיפורים ורגעים קצרים של נקודת מבט.';
---

<Base
  title="נקודת מבט — מקום לעצור, ולראות אחרת"
  description={DESCRIPTION}
  homeHeader={true}
  jsonLd={websiteJsonLd(Astro.site!, DESCRIPTION)}
>
  <main>
    <section class="hero">
      <h1>לראות אחרת. לחיות אחרת.</h1>
      <p class="triad">סיפורים. רגעים. תובנות.</p>
      <p class="promise">
        מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך.
      </p>
    </section>

    <!-- =========== שתי דלתות צד אל צד ============ -->
    <section class="dual-section">
      <!-- דלת שמאל: רגעים -->
      {
        featuredMoment && (
          <div class="door door-moments">
            <div class="door-header">
              <h2>רגע של נקודת מבט</h2>
              <p class="door-subheader">רגע קצר שמדבר ישירות אליך</p>
            </div>

            <div class="door-gate">💭</div>

            <div class="door-content">
              <article class="moment-sample">
                <h3 class="moment-title">
                  <a id="moment-title-link" href={featuredMoment.url}>
                    {featuredMoment.format.title}
                  </a>
                </h3>
                <div id="moment-body-mount" class="moment-body-preview">
                  <MomentBody format={featuredMoment.format} />
                </div>
              </article>

              <div class="moment-footer">
                <a href="/moments/" class="door-cta">מצא רגע שלך</a>
              </div>
            </div>

            {
              /* המאגר שממנו מוגרל הרגע */
              momentPool.map((m) => (
                <template data-moment-option data-url={m.url} data-title={m.format.title}>
                  <MomentBody format={m.format} />
                </template>
              ))
            }
          </div>
        )
      }

      <!-- דלת ימין: סיפורים -->
      <div class="door door-stories">
        <div class="stories-header">
          <h2>סיפורים</h2>
          <p>בחר את עולמך וקרא עמוק</p>
        </div>

        <div class="stories-grid">
          {stories.map((story) => (
            <div class="story-card" data-section={story.data.section}>
              <div class="story-gate">
                {story.data.section === 'mishals' && '📖'}
                {story.data.section === 'sages' && '✨'}
                {story.data.section === 'journal' && '📔'}
              </div>
              <div class="story-header">
                <h3>
                  {story.data.section === 'mishals' && 'משלים'}
                  {story.data.section === 'sages' && 'סיפורי צדיקים'}
                  {story.data.section === 'journal' && 'מהיומן שלי'}
                </h3>
              </div>
              <div class="story-body">
                <p class="story-examples">{story.data.title}</p>
                <a href={`/stories/${story.id}/`} class="story-link">
                  {story.data.section === 'mishals' && 'כל המשלים →'}
                  {story.data.section === 'sages' && 'כל הצדיקים →'}
                  {story.data.section === 'journal' && 'הכל מהיומן →'}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <JoinGroup />
  </main>
</Base>

<script is:inline define:vars={{ storyUrls }}>
  const randomStory = document.getElementById('random-story');
  if (randomStory) {
    randomStory.addEventListener('click', () => {
      location.href = storyUrls[Math.floor(Math.random() * storyUrls.length)];
    });
  }
</script>

<script is:inline>
  const momentOptions = document.querySelectorAll('template[data-moment-option]');
  if (momentOptions.length > 1) {
    const choice = momentOptions[Math.floor(Math.random() * momentOptions.length)];
    const mount = document.getElementById('moment-body-mount');
    const titleLink = document.getElementById('moment-title-link');
    if (mount) mount.replaceChildren(choice.content.cloneNode(true));
    if (titleLink) {
      titleLink.href = choice.dataset.url;
      titleLink.textContent = choice.dataset.title;
    }
  }
</script>

<style>
  /* אזור הפתיחה */
  .hero {
    text-align: center;
    padding-top: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 8vw, 2.15rem);
    line-height: 1.3;
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }

  .triad {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--teal-deep);
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .promise {
    color: var(--secondary);
    max-width: 26rem;
    margin-inline: auto;
    line-height: 1.75;
  }

  /* =========== דלתות צד אל צד ============ */
  .dual-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .door {
    background: white;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* דלת שמאל: רגעים */
  .door-moments {
    border: 2px solid var(--red-deep);
  }

  .door-header {
    background: var(--red-deep);
    color: white;
    padding: 1.2rem;
    text-align: center;
  }

  .door-header h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0;
    font-weight: 700;
  }

  .door-subheader {
    font-size: 0.85rem;
    opacity: 0.9;
    margin-top: 0.3rem;
  }

  .door-gate {
    width: 100%;
    height: 200px;
    background: linear-gradient(135deg, rgba(176, 70, 59, 0.1) 0%, rgba(176, 70, 59, 0.05) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
  }

  .door-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .moment-sample {
    margin-bottom: 1.2rem;
  }

  .moment-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--red-deep);
    line-height: 1.2;
    margin: 0 0 0.7rem;
    text-align: center;
  }

  .moment-title a {
    color: inherit;
    text-decoration: none;
  }

  .moment-title a:hover {
    text-decoration: underline;
  }

  .moment-body-preview {
    font-size: 0.9rem;
    line-height: 1.7;
    text-align: center;
    color: var(--ink);
  }

  .moment-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .door-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem;
    background: var(--red-deep);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .door-cta:hover {
    opacity: 0.9;
  }

  /* דלת ימין: סיפורים */
  .door-stories {
    display: flex;
    flex-direction: column;
  }

  .stories-header {
    text-align: center;
    margin-bottom: 1.3rem;
  }

  .stories-header h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0 0 0.3rem;
    color: var(--ink);
  }

  .stories-header p {
    font-size: 0.85rem;
    color: var(--secondary);
    margin: 0;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  .story-card {
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .story-gate {
    width: 100%;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .story-card[data-section="mishals"] .story-gate {
    background: linear-gradient(135deg, rgba(176, 70, 59, 0.1) 0%, rgba(176, 70, 59, 0.05) 100%);
  }

  .story-card[data-section="sages"] .story-gate {
    background: linear-gradient(135deg, rgba(31, 92, 87, 0.1) 0%, rgba(31, 92, 87, 0.05) 100%);
  }

  .story-card[data-section="journal"] .story-gate {
    background: linear-gradient(135deg, rgba(0, 59, 92, 0.1) 0%, rgba(0, 59, 92, 0.05) 100%);
  }

  .story-header {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .story-header h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    margin: 0;
    font-weight: 700;
  }

  .story-card[data-section="mishals"] .story-header h3 {
    color: var(--red-deep);
  }

  .story-card[data-section="sages"] .story-header h3 {
    color: var(--teal-deep);
  }

  .story-card[data-section="journal"] .story-header h3 {
    color: var(--blue-deep);
  }

  .story-body {
    padding: 0.8rem 1rem;
  }

  .story-examples {
    display: block;
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 0.6rem;
    line-height: 1.4;
  }

  .story-link {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--teal-deep);
    text-decoration: none;
  }

  .story-link:hover {
    text-decoration: underline;
  }

  /* בטלפון */
  @media (max-width: 800px) {
    .dual-section {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .door-gate {
      height: 150px;
      font-size: 3rem;
    }
  }
</style>
