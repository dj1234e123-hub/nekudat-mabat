---
// דף הבית (עיצוב חדש, 2026-11-03). פתיחה שמובילה לסיפורים – לא ארכיון ולא אוסף של דלתות.
// הגוף משותף לעברית ולספרדית (src/components/HomeBody.astro). מה שירד: הרגע המלא, הגרלתו ושיתופו
// (הרגעים חיים ב-/moments/ ובשורה אחת בדף), ושתי הדלתות הגדולות. מה שנשמר: הנתונים המובנים לגוגל,
// hreflang, חלון ההצטרפות, והדלת העונתית (כשיש חג).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JoinGroup from '../components/JoinGroup.astro';
import JoinPopup from '../components/JoinPopup.astro';
import HomeBody from '../components/HomeBody.astro';
import { websiteJsonLd } from '../lib/structured-data';
import { newestFirst } from '../lib/sort';
import { parseBody, plainText, kicker } from '../lib/mabat-format';
import { isPublished } from '../lib/published';
import { SUKKOT, holidayOnHome } from '../data/holidays';
import { CORNER_COVERS } from '../data/corner-covers';
import { daysSince } from '../lib/story-meta';

const stories = (await getCollection('stories', isPublished)).sort(newestFirst);

// "מבט לשבת" – הגיליון האחרון; מוצג התקציר (description) ולא הפתיחה, ובלי תקציר – 200 תווי פתיחה.
// "מעשה שהיה" – הסיפור האחרון. בלי גיליון או בלי סיפור, הכרטיס אינו מוצג (הדף מציג רק מה שקיים).
const mabat = (await getCollection('mabatLeshabbat', isPublished)).sort(newestFirst)[0];
const besht = (await getCollection('besht', isPublished)).sort(newestFirst)[0];
const flat = mabat ? plainText(parseBody(mabat.body ?? '')).replace(/\s+/g, ' ').trim() : '';
const week = [
  mabat && {
    kind: 'mabat',
    href: `/mabat-leshabbat/${mabat.id}/`,
    image: CORNER_COVERS.mabat!.src,
    imageAlt: CORNER_COVERS.mabat!.alt,
    kicker: 'מבט לשבת',
    when: kicker(mabat.data.parasha),
    title: mabat.data.title,
    text: mabat.data.description ?? (flat.length > 200 ? `${flat.slice(0, 197)}…` : flat),
    cta: 'לקרוא את הטור',
    isNew: daysSince(mabat.data.date) <= 7,
    newLabel: 'חדש',
    ph: 'home_week_mabat',
  },
  besht && {
    kind: 'besht',
    href: `/besht/${besht.id}/`,
    image: CORNER_COVERS.besht!.src,
    imageAlt: CORNER_COVERS.besht!.alt,
    kicker: 'מעשה שהיה',
    when: besht.data.occasion,
    title: besht.data.title,
    text: besht.data.excerpt,
    cta: 'לקרוא את הסיפור',
    isNew: daysSince(besht.data.date) <= 7,
    newLabel: 'חדש',
    ph: 'home_week_besht',
  },
].filter(Boolean) as Record<string, unknown>[];

// דלת עונתית: בימי החג בלבד, כשורה דקה מעל הכול. נעלמת מעצמה אחרי החלון (src/data/holidays.ts),
// בבנייה וגם בצד הקורא.
const showSukkot = holidayOnHome(SUKKOT);

const DESCRIPTION =
  'מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך. סיפורים ורגעים קצרים של נקודת מבט.';
---

<Base
  title="נקודת מבט – מקום לעצור, ולראות אחרת"
  description={DESCRIPTION}
  homeHeader={true}
  jsonLd={await websiteJsonLd(Astro.site!, DESCRIPTION)}
  altLangHref="/es/"
  altLangInline={true}
>
  <main>
    {
      showSukkot && (
        <p class="season" data-until={SUKKOT.homeUntil}>
          <span>{SUKKOT.kicker}</span>
          <a href={SUKKOT.path} data-ph="season_sukkot">
            סיפור לכל ערב של חול המועד ←
          </a>
        </p>
      )
    }
    <HomeBody {stories} week={week} />
    <JoinGroup />
    <JoinPopup />
  </main>
</Base>

<script is:inline>
  // הדלת העונתית יורדת מעצמה כשהחלון נגמר, גם בלי בנייה חדשה.
  document.querySelectorAll('[data-until]').forEach((el) => {
    if (Date.now() >= Date.parse(el.dataset.until)) el.remove();
  });
</script>

<style>
  main {
    max-width: 68rem;
  }
  .season {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3rem 0.9rem;
    margin: 0 0 0.6rem;
    padding: 0.55rem 1rem;
    background: var(--surface);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--secondary);
  }
  .season a {
    color: var(--teal);
    font-weight: 600;
    text-decoration: none;
  }
</style>
