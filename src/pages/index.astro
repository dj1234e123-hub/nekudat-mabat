---
// דף הבית — הכניסה לאתר, לא רשימת הסיפורים.
// הסדר: מי אנחנו → הפעולה הראשית → רגע אמיתי → הסיפורים → הקבוצה.
// עיקרון מנחה: הדף מציג רק תוכן שקיים בפועל. אין שורת קטגוריות ואין אזור
// שמוביל לעולם ריק — עולם תוכן יקבל מקום בניווט כשיהיה בו תוכן לעמוד עליו.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import JoinGroup from '../components/JoinGroup.astro';
import { websiteJsonLd } from '../lib/structured-data';
import MomentBody from '../components/MomentBody.astro';
import { parseMoment } from '../lib/moment-format';

// דף הבית נותן טעם ומוביל הלאה; הארכיון עצמו חי ב-/stories/.
const allStories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// שלושה סיפורים נבחרים, אחד מכל עולם — כך דף הבית מלמד את המפה בלי להסביר
// אותה. הבחירה ידנית ולא לפי תאריך: הרושם הראשון הוא החלטה, לא תוצאה של סדר
// פרסום. השדה featured קובע גם חברות וגם מיקום, ושינוי הוא מספר אחד בקובץ.
// אם לא סומן מספיק — נפילה לאחור לשלושה האחרונים, כדי שהדף לעולם לא יתרוקן.
const picked = allStories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);
const stories = picked.length >= 3 ? picked.slice(0, 3) : allStories.slice(0, 3);
const storyUrls = allStories.map((s) => `/stories/${s.id}/`);

// הרגע שמוצג בדף הבית: מוגרל מחדש בכל טעינה, בצד הקורא — כדי שמי שחוזר לאתר
// לא יראה שוב ושוב את אותו רגע קבוע. כל 66 הרגעים נבנים כאן לתבניות מוסתרות
// (<template>), והסקריפט בתחתית הקובץ בוחר אחת מהן באקראי ומשתיל אותה במקום.
// זה עובד בלי הפרש גובה בין רגע לרגע: הפורמט קבע שכל שלושת המהלכים תמיד
// באותו גובה בדיוק (docs/MOMENT-FORMAT.md), ולכן אין קפיצת פריסה בהחלפה.
//
// בלי JavaScript — ולקוראי מסך/מנועי חיפוש שלא מריצים סקריפט — נשאר הרגע
// החדש ביותר, בדיוק כמו שהיה כאן קודם: שובר השוויון על פני תאריך זהה הוא
// שם הקובץ.
const moments = (await getCollection('moments')).sort((a, b) => {
  const byDate = b.data.date.getTime() - a.data.date.getTime();
  return byDate !== 0 ? byDate : b.id.localeCompare(a.id);
});
const momentPool = moments.map((m) => ({
  url: `/moments/${m.data.feeling}/${m.id}/`,
  format: parseMoment(m.body ?? '', m.data.title),
}));
const featuredMoment = momentPool[0] ?? null;

const DESCRIPTION =
  'מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך. סיפורים ורגעים קצרים של נקודת מבט.';
---

<Base
  title="נקודת מבט — מקום לעצור, ולראות אחרת"
  description={DESCRIPTION}
  homeHeader={true}
  jsonLd={websiteJsonLd(Astro.site!, DESCRIPTION)}
>
  <main>
    <section class="hero">
      <h1>לראות אחרת. לחיות אחרת.</h1>
      <p class="triad">סיפורים. רגעים. תובנות.</p>
      <p class="promise">
        מקום לעצור, לקבל נקודת מבט חדשה, ולקחת משהו איתך להמשך הדרך.
      </p>
    </section>

    <section class="lead-action">
      <p class="question">מה עובר עליך עכשיו?</p>
      <a class="cta" href="/moments/">מצא רגע של נקודת מבט</a>
    </section>

    {
      featuredMoment && (
        <section class="feature" aria-labelledby="moment-label">
          <h2 class="section-label" id="moment-label">
            רגע של נקודת מבט
          </h2>
          <article class="moment-card">
            <h3 class="moment-hook">
              <a id="moment-title-link" href={featuredMoment.url}>
                {featuredMoment.format.title}
              </a>
            </h3>
            <div id="moment-body-mount">
              <MomentBody format={featuredMoment.format} />
            </div>
          </article>
          <p class="more">
            <a href="/moments/">עוד רגעים</a>
          </p>

          {
            /* המאגר שממנו מוגרל הרגע (ראו הסקריפט בתחתית הקובץ). <template>
               אינו מוצג ואינו נכלל בפריסה — קורא מסך ומנוע חיפוש שאינם
               מריצים סקריפט פשוט לא רואים אותו, והרגע החדש ביותר שלמעלה
               נשאר מה שהם מקבלים. */
            momentPool.map((m) => (
              <template data-moment-option data-url={m.url} data-title={m.format.title}>
                <MomentBody format={m.format} />
              </template>
            ))
          }
        </section>
      )
    }

    <section class="feature" aria-labelledby="stories-label">
      <h2 class="section-label" id="stories-label">הסיפורים</h2>
      <ul class="story-list">
        {stories.map((story) => <StoryCard story={story} />)}
      </ul>
      <p class="more">
        <a href="/stories/">כל הסיפורים</a>
        {
          storyUrls.length > 1 && (
            <button id="random-story" class="action" type="button">
              ✦ סיפור אקראי
            </button>
          )
        }
      </p>
      <p class="closing-line">כל סיפור מתחיל בנקודת מבט אחת.</p>
    </section>

    <JoinGroup />
  </main>
</Base>

<script is:inline define:vars={{ storyUrls }}>
  const randomStory = document.getElementById('random-story');
  if (randomStory) {
    randomStory.addEventListener('click', () => {
      location.href = storyUrls[Math.floor(Math.random() * storyUrls.length)];
    });
  }
</script>

<script is:inline>
  const momentOptions = document.querySelectorAll('template[data-moment-option]');
  if (momentOptions.length > 1) {
    const choice = momentOptions[Math.floor(Math.random() * momentOptions.length)];
    const mount = document.getElementById('moment-body-mount');
    const titleLink = document.getElementById('moment-title-link');
    if (mount) mount.replaceChildren(choice.content.cloneNode(true));
    if (titleLink) {
      titleLink.href = choice.dataset.url;
      titleLink.textContent = choice.dataset.title;
    }
  }
</script>

<style>
  /* אזור הפתיחה */
  .hero {
    text-align: center;
    padding-top: 0.5rem;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 8vw, 2.15rem);
    line-height: 1.3;
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }

  /* משפט אופי, לא שורת ניווט — "תובנות" עדיין אין לה אזור, ולכן היא לא קישור. */
  .triad {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--teal-deep);
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }

  .promise {
    color: var(--secondary);
    max-width: 26rem;
    margin-inline: auto;
    line-height: 1.75;
  }

  /* הפעולה הראשית */
  .lead-action {
    text-align: center;
    margin-top: 1.9rem;
  }

  .question {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin-bottom: 0.85rem;
  }

  /* תווית אזור — שקטה בכוונה: היא מסמנת גבול, לא מתחרה על תשומת הלב */
  .section-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-align: center;
    margin-bottom: 0.85rem;
  }

  .feature {
    margin-top: 2.5rem;
  }

  /* רגע אחד, בשלמותו. טקסט הוא תוכן — האזור הזה לא יכול להיראות ריק. */
  /* גודל הבסיס של הרגע בדף הבית קטן מזה שבעמוד שלו — כאן הוא אורח בעמוד,
     ושם הוא העמוד. שאר הטיפוגרפיה מגיעה מהרכיב, כדי שהקצב יהיה זהה בשניהם. */
  .moment-card {
    --moment-size: 1.1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.3rem;
  }

  .moment-hook {
    text-align: center;
    font-size: 1.4rem;
    line-height: 1.3;
    color: var(--blue);
    margin: 0 0 1.4rem;
    text-wrap: balance;
  }

  .moment-hook a {
    color: inherit;
    text-decoration: none;
  }

  .more {
    text-align: center;
    margin-top: 1.1rem;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    text-decoration: none;
    font-weight: 600;
  }

  .story-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2.75rem;
  }

  /* שורת סיום שקטה מתחת לסיפורים */
  .closing-line {
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--muted);
    margin-top: 2.25rem;
  }
</style>
