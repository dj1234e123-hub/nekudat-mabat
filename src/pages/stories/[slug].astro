---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ShareRow from '../../components/ShareRow.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import WriteToMe from '../../components/WriteToMe.astro';
import StoryEnd from '../../components/StoryEnd.astro';
import StoryHeader from '../../components/StoryHeader.astro';
import '../../styles/story.css';
import { viewsOf } from '../../lib/story-meta';
import { SECTIONS } from '../../data/sections';
import { DEFAULT_COVERS, DEFAULT_COVER_ALT } from '../../data/default-covers';
import { articleJsonLd, breadcrumbJsonLd } from '../../lib/structured-data';
import { isPublished } from '../../lib/published';
import { newestFirst } from '../../lib/sort';
import { nextStories, momentForStory } from '../../lib/related';
import { readingLabel as readingLabelFor } from '../../lib/reading-time';
import JoinPopup from '../../components/JoinPopup.astro';
import { esStoryPath } from '../../data/es-slugs';

export async function getStaticPaths() {
  const stories = await getCollection('stories', isPublished);
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const { title, section, topic, date, excerpt } = story.data;

const readingLabel = readingLabelFor(story);
const cover = story.data.cover ?? DEFAULT_COVERS[section];
const coverAlt = story.data.coverAlt ?? DEFAULT_COVER_ALT;

const pageUrl = new URL(`/stories/${story.id}/`, Astro.site).href;

// תמונת תצוגה מקדימה לשיתוף: תמונת השער. וואטסאפ לא מציג SVG,
// לכן לשערים הזמניים (SVG) ניפול ללוגו (ברירת המחדל של Base).
let ogImage: string | undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;
if (cover.format !== 'svg') {
  const og = await getImage({ src: cover, width: 1200, format: 'jpeg' });
  ogImage = new URL(og.src, Astro.site).href;
  ogImageWidth = og.attributes.width;
  ogImageHeight = og.attributes.height;
}

const allStories = (await getCollection('stories', isPublished)).sort(newestFirst);
// רשימת כתובות ל"סיפור אקראי" – בלי הסיפור הנוכחי.
const otherStoryUrls = allStories.filter((s) => s.id !== story.id).map((s) => `/stories/${s.id}/`);
// "ההמשך" (NextUp): הסיפור הבא לפי קרבה תוכנית – שלושת המועמדים הקרובים
// ביותר, מוגרלים בכל טעינה מבין אלה שטרם נקראו – ורגע של נקודת מבט שמתאים
// לסיפור. נבחרים בזמן הבנייה מהתוכן עצמו (src/lib/related.ts).
const nextCandidates = nextStories(story, allStories, SECTIONS);
// עוד מאותו עולם: הנקראים ביותר, בלי הסיפור עצמו (עד שלושה, הסקריפט בוחר את הראשון שטרם נקרא)
const worldCandidates = allStories
  .filter((s) => s.id !== story.id && s.data.section === section)
  .sort((a, b) => viewsOf(b.id) - viewsOf(a.id) || newestFirst(a, b))
  .slice(0, 3);
const relatedMoment = momentForStory(story, await getCollection('moments', isPublished));

// הסיפור התאום בספרדית – אותו שם קובץ באוסף storiesEs. סיפור שטרם תורגם:
// הגלולה מובילה לשער הסיפורים הספרדי, בלי hreflang (זה לא אותו עמוד).
const storiesEs = await getCollection('storiesEs', isPublished);
const hasEsTwin = storiesEs.some((s) => s.id === story.id);
const altLangHref = hasEsTwin ? esStoryPath(story.id) : '/es/historias/';
---

<Base
  title={`${title} · נקודת מבט`}
  description={excerpt}
  ogType="article"
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  compact={true}
  altLangHref={altLangHref}
  altLangTwin={hasEsTwin}
  jsonLd={[
    articleJsonLd(Astro.site!, {
      url: pageUrl,
      headline: title,
      description: excerpt,
      datePublished: date,
      image: ogImage,
    }),
    breadcrumbJsonLd(Astro.site!, [
      { name: 'נקודת מבט', path: '/' },
      { name: 'סיפורים', path: '/stories/' },
      { name: SECTIONS[section], path: `/sections/${section}/` },
      { name: title },
    ]),
  ]}
>
  <main>
    <article>
      <StoryHeader story={story} />
      <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 42rem) 100vw, 42rem" class="cover" />
      <div class="story-body">
        <Content />
      </div>
      <span class="end-dot" aria-hidden="true"></span>
    </article>

    <ShareRow title={title} url={pageUrl} />
    <StoryEnd current={story.id} world={worldCandidates} related={nextCandidates} moment={relatedMoment} worldLabel={SECTIONS[section]} />
    <WriteToMe title={title} />
    <JoinGroup />

    <nav class="story-footer">
      <a href="/stories/">לכל {allStories.length} הסיפורים</a>
      {otherStoryUrls.length > 0 && <button id="random-story" type="button" data-ph="random_story">לסיפור אקראי</button>}
    </nav>
    <JoinPopup />
  </main>
</Base>

{
  otherStoryUrls.length > 0 && (
    <script is:inline define:vars={{ otherStoryUrls }}>
      document.getElementById('random-story').addEventListener('click', () => {
        // אקראי מתוך מה שטרם נקרא (זיכרון הקריאה של NextUp); כשהכול נקרא – מכולם.
        let read = [];
        try {
          read = JSON.parse(localStorage.getItem('nm_read') ?? '[]');
        } catch {}
        const unread = otherStoryUrls.filter((url) => !read.includes(url.split('/')[2]));
        const pool = unread.length > 0 ? unread : otherStoryUrls;
        location.href = pool[Math.floor(Math.random() * pool.length)];
      });
    </script>
  )
}

<style is:global>
  /* פונט החתימה – כתב יד עברי, אותיות בלבד (6KB). אותו קובץ של המכתב
     בעמוד מי אני; כאן הוא חותם את השם הפרטי בסוף כל סיפור. */
  @font-face {
    font-family: 'Playpen Sans Hebrew';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/playpen-hebrew.woff2') format('woff2');
    unicode-range: U+05D0-05EA;
  }
</style>
