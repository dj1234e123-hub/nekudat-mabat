---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { TOPICS } from '../../data/topics';
import { formatDate } from '../../utils/format-date';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const { title, topic, cover, coverAlt, date, excerpt } = story.data;
---

<Base title={`${title} · נקודת מבט`} description={excerpt}>
  <main>
    <article>
      <header class="story-header">
        <a class="topic-tag" href={`/topics/${topic}/`}>{TOPICS[topic]}</a>
        <h1>{title}</h1>
        <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      </header>
      <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 42rem) 100vw, 42rem" class="cover" />
      <div class="story-body">
        <Content />
      </div>
      <span class="end-dot" aria-hidden="true"></span>
    </article>
    <nav class="story-footer">
      <a href="/">→ לכל הסיפורים</a>
    </nav>
  </main>
</Base>

<style>
  .story-header {
    text-align: center;
    padding: 0.5rem 0 1.5rem;
  }

  .story-header h1 {
    font-size: clamp(1.8rem, 6.5vw, 2.5rem);
    line-height: 1.3;
    margin: 0.85rem 0 0.5rem;
  }

  .story-header time {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cover {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 2.25rem;
  }

  .story-body {
    font-size: 1.2rem;
    line-height: 2.05;
  }

  .story-body :global(p + p) {
    margin-top: 1.35rem;
  }

  .story-body :global(blockquote) {
    font-family: var(--font-display);
    color: var(--teal-deep);
    border-inline-start: 3px solid var(--gold);
    padding-inline-start: 1.1rem;
    margin: 1.75rem 0;
    font-size: 1.25rem;
  }

  .end-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 2.75rem auto 0;
  }

  .story-footer {
    margin-top: 2.5rem;
    text-align: center;
  }

  .story-footer a {
    text-decoration: none;
    font-weight: 600;
  }
</style>
