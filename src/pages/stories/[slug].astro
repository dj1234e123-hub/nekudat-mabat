---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ShareRow from '../../components/ShareRow.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import WriteToMe from '../../components/WriteToMe.astro';
import { TOPICS } from '../../data/topics';
import { SECTIONS } from '../../data/sections';
import { DEFAULT_COVERS, DEFAULT_COVER_ALT } from '../../data/default-covers';
import { formatDate } from '../../utils/format-date';
import { articleJsonLd } from '../../lib/structured-data';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);
const { title, section, topic, date, excerpt } = story.data;

// זמן קריאה: מכרטיס הסיפור אם צוין, אחרת לפי ספירת מילים (~180 מילים לדקה).
const wordCount = (story.body ?? '').trim().split(/\s+/).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 180));
const readingLabel = story.data.readingTime
  ? `${story.data.readingTime} קריאה`
  : `כ־${readingMinutes} דקות קריאה`;
const cover = story.data.cover ?? DEFAULT_COVERS[section];
const coverAlt = story.data.coverAlt ?? DEFAULT_COVER_ALT;

const pageUrl = new URL(`/stories/${story.id}/`, Astro.site).href;

// תמונת תצוגה מקדימה לשיתוף: תמונת השער. וואטסאפ לא מציג SVG,
// לכן לשערים הזמניים (SVG) ניפול ללוגו (ברירת המחדל של Base).
let ogImage: string | undefined;
if (cover.format !== 'svg') {
  const og = await getImage({ src: cover, width: 1200, format: 'jpeg' });
  ogImage = new URL(og.src, Astro.site).href;
}

// רשימת כתובות ל"סיפור אקראי" — בלי הסיפור הנוכחי.
const otherStoryUrls = (await getCollection('stories'))
  .filter((s) => s.id !== story.id)
  .map((s) => `/stories/${s.id}/`);
---

<Base
  title={`${title} · נקודת מבט`}
  description={excerpt}
  ogType="article"
  ogImage={ogImage}
  compact={true}
  jsonLd={articleJsonLd(Astro.site!, {
    url: pageUrl,
    headline: title,
    description: excerpt,
    datePublished: date,
    image: ogImage,
  })}
>
  <main>
    <article>
      <header class="story-header">
        <a class="label" href={`/sections/${section}/`}>{SECTIONS[section]}</a>
        {topic && <a class="label" href={`/topics/${topic}/`}>{TOPICS[topic]}</a>}
        <h1>{title}</h1>
        <p class="story-meta">
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
          <span aria-hidden="true"> · </span>
          <span>{readingLabel}</span>
        </p>
      </header>
      <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 42rem) 100vw, 42rem" class="cover" />
      <div class="story-body">
        <Content />
      </div>
      <span class="end-dot" aria-hidden="true"></span>
    </article>

    <ShareRow title={title} url={pageUrl} />
    <WriteToMe title={title} />
    <JoinGroup />

    <nav class="story-footer">
      <a href="/">לכל הסיפורים</a>
      {otherStoryUrls.length > 0 && <button id="random-story" type="button">לסיפור אקראי</button>}
    </nav>
  </main>
</Base>

{
  otherStoryUrls.length > 0 && (
    <script is:inline define:vars={{ otherStoryUrls }}>
      document.getElementById('random-story').addEventListener('click', () => {
        location.href = otherStoryUrls[Math.floor(Math.random() * otherStoryUrls.length)];
      });
    </script>
  )
}

<style>
  .story-header {
    text-align: center;
    padding: 0.5rem 0 1.5rem;
  }

  .story-header h1 {
    font-size: clamp(1.8rem, 6.5vw, 2.5rem);
    line-height: 1.3;
    margin: 0.85rem 0 0.5rem;
  }

  .story-meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .cover {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    margin-bottom: 2.25rem;
  }

  .story-body {
    font-size: 1.2rem;
    line-height: 2.05;
  }

  .story-body :global(p + p) {
    margin-top: 1.35rem;
  }

  .story-body :global(blockquote) {
    font-family: var(--font-display);
    color: var(--teal-deep);
    border-inline-start: 3px solid var(--gold);
    padding-inline-start: 1.1rem;
    margin: 1.75rem 0;
    font-size: 1.25rem;
  }

  /* הדגשות (*כך*) — משקל במקום נטייה, שנראית רע בעברית */
  .story-body :global(em) {
    font-style: normal;
    font-weight: 600;
    color: var(--teal-deep);
  }

  /* החתימה האישית בסוף כל סיפור */
  .story-body :global(.signature) {
    font-family: var(--font-display);
    color: var(--teal-deep);
    margin-top: 2.5rem;
  }

  .end-dot {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--gold);
    margin: 2.75rem auto 0;
  }

  .story-footer {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .story-footer a,
  .story-footer button {
    font-family: inherit;
    font-size: 1rem;
    color: var(--teal);
    background: none;
    border: none;
    padding: 0;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
  }

  .story-footer a:hover,
  .story-footer button:hover {
    color: var(--teal-deep);
  }
</style>
