---
// עמוד הסיפורים – הכניסה לארכיון (עיצוב חדש, 2026-11-02): חיפוש, סיפור מרכזי, הכי נקראים, חדש,
// ארבעה עולמות, נושאים וארכיון עם סינון. הקורא הרגיל לא מגיע לכאן – הוא נוחת על סיפור מקישור –
// ולכן מה שחשוב הוא שמי שכן מגיע ימצא את מה שהוא מחפש גם בעוד שנה, עם 300 סיפורים.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import StoriesIndexBody from '../../components/StoriesIndexBody.astro';
import { newestFirst } from '../../lib/sort';
import { isPublished } from '../../lib/published';

const stories = (await getCollection('stories', isPublished)).sort(newestFirst);
const tagsById = Object.fromEntries(stories.map((s) => [s.id, s.data.tags ?? []]));
---

<Base
  title="סיפורים · נקודת מבט"
  description="משלים, סיפורי צדיקים, מהיומן שלי ומהחיים. כל סיפור נגמר במקום אחר ממה שהתחיל."
  altLangHref="/es/historias/"
>
  <main>
    <StoriesIndexBody stories={stories} {tagsById} />
    <JoinGroup />
  </main>
</Base>

<style>
  /* העמוד רחב יותר מעמודות הקריאה של שאר האתר: ארבע קוביות ושתי עמודות ארכיון צריכות מקום */
  main {
    max-width: 68rem;
  }
</style>
