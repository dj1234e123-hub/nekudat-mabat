---
// עמוד הסיפורים — הכניסה לארכיון.
// עד היום "סיפורים" בתפריט הוביל לדף הבית, והארכיון היה רשימה שטוחה בתחתיתו.
// זה עבד עם שני סיפורים; עם תשעה־עשר הקורא כבר לא רואה מה יש כאן.
//
// הניווט כאן הוא לפי *מה הסיפור הוא* ולא לפי מה שהקורא מרגיש — הציר הרגשי
// כבר חי בפינת הרגעים, ושתי דלתות לאותו חדר מחלישות זו את זו.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import { SECTIONS_META, SECTION_SLUGS } from '../../data/sections';
import { newestFirst } from '../../lib/sort';
import { isPublished } from '../../lib/published';

const stories = (await getCollection('stories', isPublished)).sort(
  newestFirst
);

const counts = new Map<string, number>();
for (const story of stories) {
  counts.set(story.data.section, (counts.get(story.data.section) ?? 0) + 1);
}

// עולם ריק אינו מוצג כדלת: דלת שמובילה למדף ריק נראית כתקלה ולא כהבטחה.
// הכלל רץ מעצמו — ברגע שיתווסף סיפור ראשון לעולם שמור, הדלת נפתחת.
const doors = SECTION_SLUGS.filter((slug) => (counts.get(slug) ?? 0) > 0);

const label = (n: number) => (n === 1 ? 'סיפור אחד' : `${n} סיפורים`);

// סיפור הפתיחה נבחר ידנית ולא באקראי: הרושם הראשון הוא החלטה, לא הגרלה.
const OPENER = '001-kvar-hechlateti-mi-hem';
const opener = stories.find((story) => story.id === OPENER);
---

<Base
  title="סיפורים · נקודת מבט"
  description="סיפורים מהחיים, משלים וסיפורי צדיקים. כל אחד נגמר במקום אחר ממה שהתחיל."
>
  <main>
    <h1 class="page-title">סיפורים</h1>
    <p class="intro">
      {stories.length} סיפורים. כל אחד נגמר במקום אחר ממה שהתחיל.
    </p>

    <ul class="doors">
      {
        doors.map((slug) => (
          <li class="door" style={`--accent: ${SECTIONS_META[slug].accent}`}>
            <a href={`/sections/${slug}/`}>
              <span class="door-name">{SECTIONS_META[slug].label}</span>
              <span class="door-line">{SECTIONS_META[slug].line}</span>
              <span class="door-count">{label(counts.get(slug)!)}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      opener && (
        <section class="opener" aria-labelledby="opener-label">
          <h2 class="section-label" id="opener-label">אם אתה לא יודע מאיפה להתחיל</h2>
          <ul class="story-list is-single">
            <StoryCard story={opener} />
          </ul>
        </section>
      )
    }

    <section class="all" aria-labelledby="all-label">
      <h2 class="section-label" id="all-label">הכול, מהחדש לישן</h2>
      <ul class="story-list">
        {stories.map((story) => <StoryCard story={story} />)}
      </ul>
    </section>

    <JoinGroup />
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.4rem;
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    margin: 0 auto 2.2rem;
    max-width: 26rem;
    line-height: 1.7;
  }

  .doors {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 48rem) {
    .doors {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .door a {
    display: block;
    height: 100%;
    padding: 1.15rem 1.1rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .door a:hover,
  .door a:focus-visible {
    box-shadow: 0 2px 10px rgba(46, 42, 36, 0.1);
    transform: translateY(-1px);
  }

  .door-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
  }

  .door-line {
    display: block;
    margin-top: 0.35rem;
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .door-count {
    display: block;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 1.2rem;
  }

  .opener {
    margin-bottom: 3rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2.6rem;
  }

  .story-list.is-single {
    gap: 0;
  }
</style>
