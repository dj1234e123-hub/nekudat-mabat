---
// עמוד הסיפורים — הכניסה לארכיון.
// עד היום "סיפורים" בתפריט הוביל לדף הבית, והארכיון היה רשימה שטוחה בתחתיתו.
// זה עבד עם שני סיפורים; עם תשעה־עשר הקורא כבר לא רואה מה יש כאן.
//
// הניווט כאן הוא לפי *מה הסיפור הוא* ולא לפי מה שהקורא מרגיש — הציר הרגשי
// כבר חי בפינת הרגעים, ושתי דלתות לאותו חדר מחלישות זו את זו.
//
// **רצועה לכל עולם, ובתוכה סיפור אמיתי.** הדלתות הקודמות הסבירו איך התוכן
// מחולק, ואף אחת מהן לא נתנה סיבה להיכנס. שם של סיפור עושה את זה בשורה אחת.
// זו גם הסיבה שאין כאן עוד "סיפור פתיחה" נפרד: הוא היה #001, והוא ממילא
// הסיפור הנבחר של "מהיומן שלי" — כלומר הוא כבר מוצג, בתוך הרצועה שלו.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import { SECTIONS_META, SECTION_SLUGS } from '../../data/sections';
import { SECTION_GATE_IMAGES } from '../../data/section-gate-images';
import { newestFirst } from '../../lib/sort';

const stories = (await getCollection('stories')).sort(newestFirst);

// הסיפור שמייצג כל עולם: הנבחר שלו, ואם אין — החדש ביותר בו. אותה בחירה
// בדיוק כמו בדף הבית, כדי שהקורא שעבר בין השניים יפגוש את אותו סיפור.
const featured = stories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);

// עולם ריק אינו מוצג כדלת: דלת שמובילה למדף ריק נראית כתקלה ולא כהבטחה.
// הכלל רץ מעצמו — ברגע שיתווסף סיפור ראשון לעולם שמור, הדלת נפתחת.
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const inWorld = stories.filter((s) => s.data.section === slug);
  if (inWorld.length === 0) return null;
  const sample = featured.find((s) => s.data.section === slug) ?? inWorld[0];
  return { slug, meta, sample, count: inWorld.length, gate: SECTION_GATE_IMAGES[slug] ?? null };
}).filter((w) => w !== null);

const countLabel = (n: number) => (n === 1 ? 'סיפור אחד' : `${n} סיפורים`);
---

<Base
  title="סיפורים · נקודת מבט"
  description="סיפורים מהחיים, משלים וסיפורי צדיקים. כל אחד נגמר במקום אחר ממה שהתחיל."
>
  <main>
    <h1 class="page-title">סיפורים</h1>
    <p class="intro">
      שלושה עולמות. {stories.length} סיפורים. כל אחד נגמר במקום אחר ממה שהתחיל.
    </p>

    <ul class="bands">
      {
        worlds.map(({ slug, meta, sample, count, gate }) => (
          <li class="band" style={`--accent: ${meta.accent}`}>
            {gate && (
              <a href={`/sections/${slug}/`} class="band-gate" aria-label={meta.linkText}>
                <Image
                  src={gate.image}
                  alt=""
                  widths={[480, 960]}
                  sizes="(max-width: 48rem) 100vw, 380px"
                  style={`object-position: ${gate.position}`}
                />
              </a>
            )}
            <div class="band-body">
              <h2 class="band-name">
                <a href={`/sections/${slug}/`}>{meta.label}</a>
              </h2>
              <p class="band-line">{meta.line}</p>
              <p class="band-sample">
                למשל: <a href={`/stories/${sample.id}/`}>{sample.data.title}</a>
              </p>
              <p class="band-more">
                <span>{countLabel(count)}</span>
                <a href={`/sections/${slug}/`}>{meta.linkText} ←</a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="all" aria-labelledby="all-label">
      <h2 class="section-label" id="all-label">הכול, מהחדש לישן</h2>
      <ul class="story-list">
        {stories.map((story) => <StoryCard story={story} />)}
      </ul>
    </section>

    <JoinGroup />
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.4rem;
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    margin: 0 auto 2.2rem;
    max-width: 26rem;
    line-height: 1.7;
  }

  /* ── רצועת עולם ── */
  .bands {
    list-style: none;
    padding: 0;
    margin: 0 0 3.25rem;
    display: grid;
    gap: 1.4rem;
  }

  .band {
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  /* התמונה היא הדלת — לחיצה עליה נכנסת לעולם */
  .band-gate {
    display: block;
    line-height: 0;
  }

  .band-gate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }

  .band-body {
    padding: 1rem 1.1rem 1.1rem;
  }

  .band-name {
    font-size: 1.35rem;
    margin: 0;
    line-height: 1.3;
  }

  .band-name a {
    color: var(--accent);
    text-decoration: none;
  }

  .band-name a:hover,
  .band-name a:focus-visible {
    text-decoration: underline;
  }

  .band-line {
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0.35rem 0 0;
  }

  /* הסיבה להיכנס: שם של סיפור אמיתי, לא עוד תיאור */
  .band-sample {
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .band-sample a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    text-decoration: none;
  }

  .band-sample a:hover,
  .band-sample a:focus-visible {
    text-decoration: underline;
  }

  .band-more {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .band-more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .band-more a:hover,
  .band-more a:focus-visible {
    text-decoration: underline;
  }

  /* במסך רחב הרצועה נעשית רצועה באמת: תמונה בצד, טקסט לצידה. */
  @media (min-width: 48rem) {
    .band {
      display: grid;
      grid-template-columns: 22rem 1fr;
      align-items: stretch;
    }

    .band-gate {
      height: 100%;
    }

    .band-gate :global(img) {
      height: 100%;
      aspect-ratio: auto;
    }

    .band-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 1.5rem 1.6rem;
    }
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 1.2rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2.6rem;
  }
</style>
