---
// עמוד הסיפורים — הכניסה לארכיון.
// עד היום "סיפורים" בתפריט הוביל לדף הבית, והארכיון היה רשימה שטוחה בתחתיתו.
// זה עבד עם שני סיפורים; עם תשעה־עשר הקורא כבר לא רואה מה יש כאן.
//
// הניווט כאן הוא לפי *מה הסיפור הוא* ולא לפי מה שהקורא מרגיש — הציר הרגשי
// כבר חי בפינת הרגעים, ושתי דלתות לאותו חדר מחלישות זו את זו.
//
// **רצועה לכל עולם, ובתוכה סיפור אמיתי.** הדלתות הקודמות הסבירו איך התוכן
// מחולק, ואף אחת מהן לא נתנה סיבה להיכנס. שם של סיפור עושה את זה בשורה אחת.
// זו גם הסיבה שאין כאן עוד "סיפור פתיחה" נפרד: הוא היה #001, והוא ממילא
// הסיפור הנבחר של "מהיומן שלי" — כלומר הוא כבר מוצג, בתוך הרצועה שלו.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import JoinGroup from '../../components/JoinGroup.astro';
import { SECTIONS_META, SECTION_SLUGS } from '../../data/sections';
import { SECTION_GATE_IMAGES } from '../../data/section-gate-images';
import { newestFirst } from '../../lib/sort';
import { isPublished } from '../../lib/published';

const stories = (await getCollection('stories', isPublished)).sort(newestFirst);

// הסיפור שמייצג כל עולם: הנבחר שלו, ואם אין — החדש ביותר בו. אותה בחירה
// בדיוק כמו בדף הבית, כדי שהקורא שעבר בין השניים יפגוש את אותו סיפור.
const featured = stories
  .filter((s) => s.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!);

// עולם ריק אינו מוצג כדלת: דלת שמובילה למדף ריק נראית כתקלה ולא כהבטחה.
// הכלל רץ מעצמו — ברגע שיתווסף סיפור ראשון לעולם שמור, הדלת נפתחת.
const worlds = SECTION_SLUGS.map((slug) => {
  const meta = SECTIONS_META[slug];
  if ('hidden' in meta && meta.hidden) return null;
  const inWorld = stories.filter((s) => s.data.section === slug);
  if (inWorld.length === 0) return null;
  const sample = featured.find((s) => s.data.section === slug) ?? inWorld[0];
  return { slug, meta, sample, count: inWorld.length, gate: SECTION_GATE_IMAGES[slug] ?? null };
}).filter((w) => w !== null);

const countLabel = (n: number) => (n === 1 ? 'סיפור אחד' : `${n} סיפורים`);
---

<Base
  title="סיפורים · נקודת מבט"
  description="משלים, סיפורי צדיקים, מהיומן שלי ומהחיים. כל סיפור נגמר במקום אחר ממה שהתחיל."
  altLangHref="/es/historias/"
>
  <main>
    <h1 class="page-title">סיפורים</h1>
    <p class="intro">
      ארבעה עולמות. {stories.length} סיפורים. כל אחד נגמר במקום אחר ממה שהתחיל.
    </p>

    <ul class="bands">
      {
        worlds.map(({ slug, meta, sample, count, gate }) => (
          <li class="band" style={`--accent: ${meta.accent}`}>
            {gate && (
              <a href={`/sections/${slug}/`} class="band-gate" aria-label={meta.linkText}>
                <Image
                  src={gate.image}
                  alt=""
                  widths={[360, 720]}
                  sizes="(max-width: 48rem) 50vw, 330px"
                  style={`object-position: ${gate.position}`}
                />
              </a>
            )}
            <div class="band-body">
              <h2 class="band-name">
                <a href={`/sections/${slug}/`}>{meta.label}</a>
              </h2>
              <p class="band-line">{meta.line}</p>
              <p class="band-sample">
                למשל: <a href={`/stories/${sample.id}/`}>{sample.data.title}</a>
              </p>
              <p class="band-more">
                <span>{countLabel(count)}</span>
                <a href={`/sections/${slug}/`}>{meta.linkText} ←</a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <section class="all" aria-labelledby="all-label">
      <h2 class="section-label" id="all-label">הכול, מהחדש לישן</h2>
      <ul class="story-list">
        {stories.map((story) => <StoryCard story={story} />)}
      </ul>
    </section>

    <JoinGroup />
  </main>
</Base>

<style>
  .page-title {
    text-align: center;
    font-size: 1.8rem;
    padding: 0.5rem 0 0.4rem;
  }

  .intro {
    text-align: center;
    color: var(--secondary);
    margin: 0 auto 1.5rem;
    max-width: 26rem;
    line-height: 1.7;
  }

  /* ── כרטיסי העולמות — רשת 2×2 (2026-09-16) ──
     קודם ארבע רצועות ברוחב מלא, ~370px כל אחת בטלפון: הקורא ראה רצועה
     וחצי בכל פעם, והעולם הרביעי חיכה 1,500px למטה. "ארבעה עולמות. בחר
     מאיפה להתחיל" מחייב לראות את הארבעה יחד — עכשיו כולם במסך הראשון.
     מלבנים ולא קשתות, בכוונה (החלטת 4.27): הקשת שייכת לרגעים. שני עמודי
     הכניסה חולקים את העיקרון (כל הדלתות במסך אחד), לא את הצורה.
     כל מה שהיה ברצועה נשאר בכרטיס: צילום, קו הצבע, שם, שורת ההסבר,
     "למשל: סיפור אמיתי" ומספר הסיפורים. */
  .bands {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .band {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  /* התמונה היא הדלת — לחיצה עליה נכנסת לעולם */
  .band-gate {
    display: block;
    line-height: 0;
  }

  .band-gate :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* 16:9 בטלפון — כדי ששתי השורות ייכנסו למסך הראשון; 3:2 במסך רחב */
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .band-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.65rem 0.8rem 0.6rem;
  }

  .band-name {
    font-size: 1.15rem;
    margin: 0;
    line-height: 1.25;
  }

  .band-name a {
    color: var(--accent);
    text-decoration: none;
  }

  .band-name a:hover,
  .band-name a:focus-visible {
    text-decoration: underline;
  }

  .band-line {
    color: var(--secondary);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0.3rem 0 0;
  }

  /* הסיבה להיכנס: שם של סיפור אמיתי, לא עוד תיאור. נדחף לתחתית הכרטיס
     כדי ששני הכרטיסים שבשורה יישרו קו גם כששורת ההסבר שונה באורכה. */
  .band-sample {
    margin: auto 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .band-sample a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--ink);
    text-decoration: none;
  }

  .band-sample a:hover,
  .band-sample a:focus-visible {
    text-decoration: underline;
  }

  .band-more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 0.6rem;
    margin: 0.15rem 0 0;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .band-more a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-weight: 600;
    color: var(--teal);
    text-decoration: none;
  }

  .band-more a:hover,
  .band-more a:focus-visible {
    text-decoration: underline;
  }

  /* במסך רחב הכרטיסים רחבים כפליים — הטקסט חוזר לגודלו הרגיל */
  @media (min-width: 34rem) {
    .bands {
      gap: 1.25rem;
    }

    .band-gate :global(img) {
      aspect-ratio: 3 / 2;
    }

    .band-body {
      padding: 0.9rem 1.1rem 0.8rem;
    }

    .band-name {
      font-size: 1.3rem;
    }

    .band-line {
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .band-sample,
    .band-more {
      font-size: 0.85rem;
    }

    .band-sample a {
      font-size: 1.05rem;
    }
  }

  .section-label {
    font-family: var(--font-body);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: center;
    margin: 0 0 1.2rem;
  }

  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.35rem;
  }
</style>
